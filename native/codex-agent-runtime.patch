+
+// Readable gateway task messages use the same native handler and agent tree.
+pub(super) fn gateway_agent_alias(handler: Arc<dyn CoreToolRuntime>) -> Arc<dyn CoreToolRuntime> {
+    Arc::new(GatewayAgentAlias { handler })
+}
+struct GatewayAgentAlias { handler: Arc<dyn CoreToolRuntime> }
+impl ToolExecutor<ToolInvocation> for GatewayAgentAlias {
+    fn tool_name(&self) -> ToolName { ToolName::namespaced("tokenflow_agents", self.handler.tool_name().name) }
+    fn spec(&self) -> ToolSpec {
+        let mut spec = self.handler.spec();
+        if let ToolSpec::Namespace(namespace) = &mut spec {
+            namespace.name = "tokenflow_agents".to_string();
+            namespace.description = "Use these native tools when delegating to a configured gateway model or sending a task to a gateway child. Official models keep collaboration tools. Use fork_turns=none across providers. Both namespaces share the native agent tree; collaboration list_agents, wait_agent and interrupt_agent manage all children.".to_string();
+            for tool in &mut namespace.tools {
+                if let ResponsesApiNamespaceTool::Function(tool) = tool {
+                    if let Some(message) = tool.parameters.properties.as_mut().and_then(|p| p.get_mut("message")) {
+                        message.encrypted = None;
+                    }
+                }
+            }
+        }
+        spec
+    }
+    fn exposure(&self) -> ToolExposure { self.handler.exposure() }
+    fn supports_parallel_tool_calls(&self) -> bool { self.handler.supports_parallel_tool_calls() }
+    fn search_info(&self) -> Option<ToolSearchInfo> { self.handler.search_info() }
+    fn handle<'a>(&'a self, invocation: ToolInvocation) -> codex_tools::ToolExecutorFuture<'a>
+    where ToolInvocation: 'a { self.handler.handle(invocation) }
+}
+impl CoreToolRuntime for GatewayAgentAlias {
+    fn wait_until_ready<'a>(&'a self, session: &'a Arc<Session>) -> Option<BoxFuture<'a, ()>> { self.handler.wait_until_ready(session) }
+    fn matches_kind(&self, payload: &crate::tools::context::ToolPayload) -> bool { self.handler.matches_kind(payload) }
+    fn create_diff_consumer(&self) -> Option<Box<dyn crate::tools::registry::ToolArgumentDiffConsumer>> { self.handler.create_diff_consumer() }
+}
