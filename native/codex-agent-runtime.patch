+// Read on every spawn so model-menu updates do not require another engine restart.
+fn apply_gateway_model_provider_route(config: &mut Config, full_history_fork: bool) -> Result<(), String> {
+    let Some(path) = std::env::var_os("TOKENFLOW_CODEX_AGENT_ROUTES_FILE") else { return Ok(()); };
+    let bytes = std::fs::read(path).map_err(|_| "TokenFlow agent routes are unavailable; restore or reapply the connection".to_string())?;
+    if bytes.len() > 1024 * 1024 { return Err("TokenFlow agent routes are too large".to_string()); }
+    #[derive(serde::Deserialize)]
+    #[serde(rename_all = "camelCase")]
+    struct Routes { official_models: Vec<String>, gateway_models: Vec<String> }
+    let routes: Routes = serde_json::from_slice(&bytes).map_err(|_| "Invalid TokenFlow agent routes".to_string())?;
+    let Some(model) = config.model.as_ref() else { return Ok(()); };
+    let official = routes.official_models.contains(model);
+    let gateway = routes.gateway_models.contains(model);
+    if official && gateway { return Err("Ambiguous TokenFlow model provider".to_string()); }
+    let provider_id = if gateway { "token_flow" } else if official { "openai" } else { return Err("Child model is not in the configured model selection".to_string()); };
+    if config.model_provider_id == provider_id { return Ok(()); }
+    if full_history_fork { return Err("Cross-provider full-history forks require portable context; use fork_turns=none with an explicit task".to_string()); }
+    let provider = config.model_providers.get(provider_id).cloned().ok_or_else(|| "Configured child provider is missing".to_string())?;
+    config.model_provider_id = provider_id.to_string();
+    config.model_provider = provider;
+    Ok(())
+}
