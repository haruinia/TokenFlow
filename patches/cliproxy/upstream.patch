@@ -0,0 +1,112 @@
+package zcode
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net"
+	"net/http"
+	"strings"
+	"time"
+)
+
+// LocalCallbackResult contains authorization response parameters.
+type LocalCallbackResult struct {
+	Code  string
+	State string
+	Error string
+}
+
+// LocalCallbackServer is a loopback HTTP server to receive OAuth redirects.
+type LocalCallbackServer struct {
+	server     *http.Server
+	port       int
+	resultChan chan *LocalCallbackResult
+	errorChan  chan error
+}
+
+// StartLocalCallbackServer starts listening on preferPort, or falls back to an ephemeral port if occupied.
+func StartLocalCallbackServer(preferPort int) (*LocalCallbackServer, int, error) {
+	if preferPort <= 0 {
+		preferPort = DefaultCallbackPort
+	}
+
+	ln, err := net.Listen("tcp", fmt.Sprintf("127.0.0.1:%d", preferPort))
+	if err != nil {
+		// Fallback to random free port
+		var errEphemeral error
+		ln, errEphemeral = net.Listen("tcp", "127.0.0.1:0")
+		if errEphemeral != nil {
+			return nil, 0, fmt.Errorf("failed to listen on port %d or fallback port: %w", preferPort, errEphemeral)
+		}
+	}
+
+	actualPort := ln.Addr().(*net.TCPAddr).Port
+
+	s := &LocalCallbackServer{
+		port:       actualPort,
+		resultChan: make(chan *LocalCallbackResult, 1),
+		errorChan:  make(chan error, 1),
+	}
+
+	mux := http.NewServeMux()
+	handler := func(w http.ResponseWriter, r *http.Request) {
+		q := r.URL.Query()
+		errStr := strings.TrimSpace(q.Get("error"))
+		if errStr == "" {
+			errStr = strings.TrimSpace(q.Get("error_description"))
+		}
+		res := &LocalCallbackResult{
+			Code:  strings.TrimSpace(q.Get("code")),
+			State: strings.TrimSpace(q.Get("state")),
+			Error: errStr,
+		}
+		select {
+		case s.resultChan <- res:
+		default:
+		}
+		w.Header().Set("Content-Type", "text/html; charset=utf-8")
+		_, _ = w.Write([]byte(`<!DOCTYPE html><html><head><meta charset="utf-8"><title>Authentication Successful</title><style>body{font-family:-apple-system,BlinkMacSystemFont,sans-serif;display:flex;align-items:center;justify-content:center;height:100vh;margin:0;background:#0d1117;color:#c9d1d9}.card{background:#161b22;padding:32px 48px;border-radius:12px;border:1px solid #30363d;text-align:center}h1{color:#3fb950;margin-top:0}p{color:#8b949e}</style></head><body><div class="card"><h1>Authentication Successful</h1><p>You can close this tab and return to the application.</p></div></body></html>`))
+	}
+
+	mux.HandleFunc("/callback", handler)
+	mux.HandleFunc("/zcode/callback", handler)
+	mux.HandleFunc("/", handler)
+
+	s.server = &http.Server{
+		Handler:      mux,
+		ReadTimeout:  10 * time.Second,
+		WriteTimeout: 10 * time.Second,
+	}
+
+	go func() {
+		if errServe := s.server.Serve(ln); errServe != nil && !errors.Is(errServe, http.ErrServerClosed) {
+			select {
+			case s.errorChan <- errServe:
+			default:
+			}
+		}
+	}()
+
+	return s, actualPort, nil
+}
+
+// WaitForCallback blocks until the callback is received, an error occurs, or timeout triggers.
+func (s *LocalCallbackServer) WaitForCallback(timeout time.Duration) (*LocalCallbackResult, error) {
+	select {
+	case res := <-s.resultChan:
+		return res, nil
+	case err := <-s.errorChan:
+		return nil, err
+	case <-time.After(timeout):
+		return nil, errors.New("timeout waiting for authorization callback")
+	}
+}
+
+// Stop shuts down the loopback callback server.
+func (s *LocalCallbackServer) Stop(ctx context.Context) error {
+	if s == nil || s.server == nil {
+		return nil
+	}
+	return s.server.Shutdown(ctx)
+}
diff --git a/internal/auth/zcode/token.go b/internal/auth/zcode/token.go
new file mode 100644
index 00000000..e21b8b40
--- /dev/null
+++ b/internal/auth/zcode/token.go
@@ -0,0 +1,126 @@
+// Package zcode provides authentication and token management functionality
+// for ZCode (Z.AI / 智谱 BigModel) services. It handles OAuth2 CLI device flow,
+// local configuration discovery, storage, serialization, and retrieval.
+package zcode
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/misc"
+	log "github.com/sirupsen/logrus"
+)
+
+const (
+	// refreshThresholdSeconds is when to refresh token before expiry (5 minutes).
+	refreshThresholdSeconds = 300
+)
+
+// ZCodeTokenStorage stores token information for ZCode API authentication.
+type ZCodeTokenStorage struct {
+	// AccessToken is the OAuth2 access token or Bearer API key.
+	AccessToken string `json:"access_token"`
+	// RefreshToken is the OAuth2 refresh token if provided.
+	RefreshToken string `json:"refresh_token,omitempty"`
+	// TokenType is typically "Bearer".
+	TokenType string `json:"token_type"`
+	// Expired is the RFC3339 timestamp when the access token expires.
+	Expired string `json:"expired,omitempty"`
+	// UID is the user identifier returned by Z.AI / BigModel.
+	UID string `json:"uid,omitempty"`
+	// Email is the account email or handle.
+	Email string `json:"email,omitempty"`
+	// JWT is the plan JWT used for start-plan routing if applicable.
+	JWT string `json:"jwt,omitempty"`
+	// Provider specifies "zai" or "bigmodel".
+	Provider string `json:"provider,omitempty"`
+	// Type indicates the authentication provider type, always "zcode".
+	Type string `json:"type"`
+
+	// Metadata holds arbitrary key-value pairs injected via hooks.
+	Metadata map[string]any `json:"-"`
+}
+
+// SetMetadata allows external callers to inject metadata into the storage before saving.
+func (ts *ZCodeTokenStorage) SetMetadata(meta map[string]any) {
+	ts.Metadata = meta
+}
+
+// ZCodeTokenData holds raw token information from ZCode auth flow.
+type ZCodeTokenData struct {
+	AccessToken  string `json:"access_token"`
+	RefreshToken string `json:"refresh_token,omitempty"`
+	TokenType    string `json:"token_type"`
+	ExpiresAt    int64  `json:"expires_at,omitempty"`
+	UID          string `json:"uid,omitempty"`
+	Email        string `json:"email,omitempty"`
+	JWT          string `json:"jwt,omitempty"`
+	Provider     string `json:"provider,omitempty"`
+}
+
+// DeviceFlowSession holds the state for an active ZCode CLI authorization flow.
+type DeviceFlowSession struct {
+	// VerificationURI is the browser URL for authorizing.
+	VerificationURI string `json:"verification_uri"`
+	// FlowID is the server flow ID used for polling.
+	FlowID string `json:"flow_id"`
+	// ExpiresIn is the duration in seconds until flow expiry.
+	ExpiresIn int `json:"expires_in"`
+	// Interval is the polling interval in seconds.
+	Interval int `json:"interval"`
+}
+
+// SaveTokenToFile serializes the ZCode token storage to a JSON file.
+func (ts *ZCodeTokenStorage) SaveTokenToFile(authFilePath string) error {
+	misc.LogSavingCredentials(authFilePath)
+	ts.Type = "zcode"
+
+	if err := os.MkdirAll(filepath.Dir(authFilePath), 0700); err != nil {
+		return fmt.Errorf("failed to create directory: %w", err)
+	}
+
+	data, errMerge := misc.MergeMetadata(ts, ts.Metadata)
+	if errMerge != nil {
+		return fmt.Errorf("failed to merge metadata: %w", errMerge)
+	}
+
+	f, err := os.Create(authFilePath)
+	if err != nil {
+		return fmt.Errorf("failed to create token file: %w", err)
+	}
+	defer func() {
+		if errClose := f.Close(); errClose != nil {
+			log.Errorf("zcode token storage: close token file error: %v", errClose)
+		}
+	}()
+
+	encoder := json.NewEncoder(f)
+	encoder.SetIndent("", "  ")
+	if err = encoder.Encode(data); err != nil {
+		return fmt.Errorf("failed to write token to file: %w", err)
+	}
+	return nil
+}
+
+// IsExpired checks if the token has expired.
+func (ts *ZCodeTokenStorage) IsExpired() bool {
+	if ts.Expired == "" {
+		return false
+	}
+	t, err := time.Parse(time.RFC3339, ts.Expired)
+	if err != nil {
+		return true
+	}
+	return time.Now().Add(time.Duration(refreshThresholdSeconds) * time.Second).After(t)
+}
+
+// NeedsRefresh checks if the token should be refreshed.
+func (ts *ZCodeTokenStorage) NeedsRefresh() bool {
+	if ts.RefreshToken == "" {
+		return false
+	}
+	return ts.IsExpired()
+}
diff --git a/internal/auth/zcode/zcode.go b/internal/auth/zcode/zcode.go
new file mode 100644
index 00000000..d17d3b45
--- /dev/null
+++ b/internal/auth/zcode/zcode.go
@@ -0,0 +1,598 @@
+package zcode
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/browser"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/misc"
+	log "github.com/sirupsen/logrus"
+	"github.com/tidwall/gjson"
+)
+
+const (
+	// ZCodeAPIBase is the base URL for ZCode CLI authentication.
+	ZCodeAPIBase = "https://zcode.z.ai/api/v1"
+	// ZCodeInitURL initializes a CLI OAuth session (legacy device flow).
+	ZCodeInitURL = ZCodeAPIBase + "/oauth/cli/init"
+	// ZCodePollURL polls for CLI OAuth session status (legacy device flow).
+	ZCodePollURL = ZCodeAPIBase + "/oauth/cli/poll"
+
+	// ZCodeClientID is the standard public native OAuth client ID for Z.AI / ZCode.
+	ZCodeClientID = "client_P8X5CMWmlaRO9gyO-KSqtg"
+	// ZCodeAuthorizeURL is the browser authorization endpoint for Z.AI.
+	ZCodeAuthorizeURL = "https://chat.z.ai/api/oauth/authorize"
+	// ZCodeTokenURL exchanges authorization code for Z.AI tokens.
+	ZCodeTokenURL = "https://zcode.z.ai/api/v1/oauth/token"
+	// ZCodeBusinessLoginURL exchanges Z.AI access token for ZCode Business JWT.
+	ZCodeBusinessLoginURL = "https://api.z.ai/api/auth/z/login"
+	// ZCodeUserInfoURL retrieves user profile details.
+	ZCodeUserInfoURL = "https://chat.z.ai/api/oauth/userinfo"
+	// DefaultCallbackPort is the default port for local CLI callback listener.
+	DefaultCallbackPort = 9999
+)
+
+// ErrDeviceFlowPending is returned when the user has not yet completed authorization.
+var ErrDeviceFlowPending = errors.New("authorization pending")
+
+// ZCodeAuth handles authentication flows for ZCode (Z.AI / BigModel).
+type ZCodeAuth struct {
+	cfg        *config.Config
+	httpClient *http.Client
+}
+
+// NewZCodeAuth constructs a new ZCode authentication client.
+func NewZCodeAuth(cfg *config.Config) *ZCodeAuth {
+	return &ZCodeAuth{
+		cfg: cfg,
+		httpClient: &http.Client{
+			Timeout: 30 * time.Second,
+		},
+	}
+}
+
+// GenerateAuthURL builds the standard OAuth authorization URL and generates state if needed.
+func GenerateAuthURL(redirectURI, state string) (string, error) {
+	state = strings.TrimSpace(state)
+	if state == "" {
+		b := make([]byte, 16)
+		if _, err := rand.Read(b); err != nil {
+			return "", fmt.Errorf("failed to generate random state: %w", err)
+		}
+		state = hex.EncodeToString(b)
+	}
+
+	u, err := url.Parse(ZCodeAuthorizeURL)
+	if err != nil {
+		return "", fmt.Errorf("failed to parse authorize url: %w", err)
+	}
+
+	q := u.Query()
+	q.Set("response_type", "code")
+	q.Set("client_id", ZCodeClientID)
+	q.Set("redirect_uri", redirectURI)
+	q.Set("state", state)
+	u.RawQuery = q.Encode()
+
+	return u.String(), nil
+}
+
+// GenerateAuthURL builds the standard OAuth authorization URL for ZCode.
+func (a *ZCodeAuth) GenerateAuthURL(redirectURI, state string) (string, error) {
+	return GenerateAuthURL(redirectURI, state)
+}
+
+// ExchangeCodeForTokens exchanges an authorization code for ZCode tokens and business JWT.
+func (a *ZCodeAuth) ExchangeCodeForTokens(ctx context.Context, code, state, redirectURI string) (*ZCodeTokenStorage, error) {
+	code = strings.TrimSpace(code)
+	if code == "" {
+		return nil, errors.New("empty authorization code")
+	}
+
+	// 1. Exchange code for Z.AI access token
+	reqBody := map[string]string{
+		"provider":     "zai",
+		"code":         code,
+		"redirect_uri": redirectURI,
+		"state":        state,
+	}
+	bodyBytes, errMarshal := json.Marshal(reqBody)
+	if errMarshal != nil {
+		return nil, fmt.Errorf("failed to marshal token exchange request: %w", errMarshal)
+	}
+
+	req, errReq := http.NewRequestWithContext(ctx, http.MethodPost, ZCodeTokenURL, bytes.NewReader(bodyBytes))
+	if errReq != nil {
+		return nil, errReq
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Accept", "application/json")
+
+	resp, errDo := a.httpClient.Do(req)
+	if errDo != nil {
+		return nil, fmt.Errorf("failed to call zcode token exchange: %w", errDo)
+	}
+	defer func() {
+		if errClose := resp.Body.Close(); errClose != nil {
+			log.Errorf("zcode token exchange: close body error: %v", errClose)
+		}
+	}()
+
+	respBytes, errRead := io.ReadAll(resp.Body)
+	if errRead != nil {
+		return nil, fmt.Errorf("failed to read token exchange response: %w", errRead)
+	}
+
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return nil, fmt.Errorf("zcode token exchange failed (HTTP %d): %s", resp.StatusCode, string(respBytes))
+	}
+
+	gj := gjson.ParseBytes(respBytes)
+	codeField := gj.Get("code").Int()
+	if codeField != 0 && gj.Get("data").Raw == "" {
+		msg := gj.Get("msg").String()
+		if msg == "" {
+			msg = gj.Get("message").String()
+		}
+		return nil, fmt.Errorf("zcode token exchange error (code %d): %s", codeField, msg)
+	}
+
+	accessToken := gj.Get("data.zai.access_token").String()
+	if accessToken == "" {
+		accessToken = gj.Get("data.access_token").String()
+	}
+	if accessToken == "" {
+		accessToken = gj.Get("data.token").String()
+	}
+	if accessToken == "" {
+		return nil, fmt.Errorf("zcode token exchange returned no access token: %s", string(respBytes))
+	}
+
+	refreshToken := gj.Get("data.zai.refresh_token").String()
+	if refreshToken == "" {
+		refreshToken = gj.Get("data.refresh_token").String()
+	}
+
+	expiresIn := gj.Get("data.zai.expires_in").Int()
+	if expiresIn <= 0 {
+		expiresIn = gj.Get("data.expires_in").Int()
+	}
+
+	uid := gj.Get("data.user.id").String()
+	if uid == "" {
+		uid = gj.Get("data.user_id").String()
+	}
+	if uid == "" {
+		uid = gj.Get("data.uid").String()
+	}
+
+	email := gj.Get("data.user.email").String()
+	if email == "" {
+		email = gj.Get("data.email").String()
+	}
+
+	// 2. Exchange Z.AI token for ZCode Business JWT
+	jwtToken := ""
+	loginBodyMap := map[string]string{
+		"token": accessToken,
+	}
+	if loginBytes, errLoginJSON := json.Marshal(loginBodyMap); errLoginJSON == nil {
+		loginReq, errLoginReq := http.NewRequestWithContext(ctx, http.MethodPost, ZCodeBusinessLoginURL, bytes.NewReader(loginBytes))
+		if errLoginReq == nil {
+			loginReq.Header.Set("Content-Type", "application/json")
+			loginReq.Header.Set("Accept", "application/json")
+			if loginResp, errLoginDo := a.httpClient.Do(loginReq); errLoginDo == nil {
+				loginRespBytes, _ := io.ReadAll(loginResp.Body)
+				_ = loginResp.Body.Close()
+				if loginResp.StatusCode >= 200 && loginResp.StatusCode < 300 {
+					loginGj := gjson.ParseBytes(loginRespBytes)
+					jwtToken = loginGj.Get("data.access_token").String()
+					if jwtToken == "" {
+						jwtToken = loginGj.Get("data.token").String()
+					}
+					if jwtToken == "" {
+						jwtToken = loginGj.Get("token").String()
+					}
+				} else {
+					log.Warnf("zcode business login returned HTTP %d: %s", loginResp.StatusCode, string(loginRespBytes))
+				}
+			}
+		}
+	}
+
+	// 3. Retrieve user profile if email or uid is still missing
+	if email == "" || uid == "" {
+		userReq, errUserReq := http.NewRequestWithContext(ctx, http.MethodGet, ZCodeUserInfoURL, nil)
+		if errUserReq == nil {
+			userReq.Header.Set("Authorization", "Bearer "+accessToken)
+			userReq.Header.Set("Accept", "application/json")
+			if userResp, errUserDo := a.httpClient.Do(userReq); errUserDo == nil {
+				userRespBytes, _ := io.ReadAll(userResp.Body)
+				_ = userResp.Body.Close()
+				if userResp.StatusCode >= 200 && userResp.StatusCode < 300 {
+					userGj := gjson.ParseBytes(userRespBytes)
+					if email == "" {
+						email = userGj.Get("email").String()
+						if email == "" {
+							email = userGj.Get("data.email").String()
+						}
+					}
+					if uid == "" {
+						uid = userGj.Get("id").String()
+						if uid == "" {
+							uid = userGj.Get("data.id").String()
+						}
+					}
+				}
+			}
+		}
+	}
+
+	storage := &ZCodeTokenStorage{
+		AccessToken:  accessToken,
+		RefreshToken: refreshToken,
+		TokenType:    "Bearer",
+		UID:          uid,
+		Email:        email,
+		JWT:          jwtToken,
+		Provider:     "zai",
+		Type:         "zcode",
+	}
+	if expiresIn > 0 {
+		storage.Expired = time.Now().Add(time.Duration(expiresIn) * time.Second).UTC().Format(time.RFC3339)
+	}
+
+	return storage, nil
+}
+
+// StartDeviceFlow initiates a ZCode CLI authorization flow.
+func (a *ZCodeAuth) StartDeviceFlow(ctx context.Context, provider string) (*DeviceFlowSession, error) {
+	if provider == "" {
+		provider = "zai"
+	}
+	reqBody := map[string]string{
+		"provider": provider,
+	}
+	bodyBytes, errMarshal := json.Marshal(reqBody)
+	if errMarshal != nil {
+		return nil, fmt.Errorf("failed to marshal request: %w", errMarshal)
+	}
+
+	req, errReq := http.NewRequestWithContext(ctx, http.MethodPost, ZCodeInitURL, bytes.NewReader(bodyBytes))
+	if errReq != nil {
+		return nil, errReq
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Accept", "application/json")
+
+	resp, errDo := a.httpClient.Do(req)
+	if errDo != nil {
+		return nil, fmt.Errorf("failed to call zcode init: %w", errDo)
+	}
+	defer func() {
+		if errClose := resp.Body.Close(); errClose != nil {
+			log.Errorf("zcode init: close response body error: %v", errClose)
+		}
+	}()
+
+	respBytes, errRead := io.ReadAll(resp.Body)
+	if errRead != nil {
+		return nil, fmt.Errorf("failed to read response body: %w", errRead)
+	}
+
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return nil, fmt.Errorf("zcode init error %d: %s", resp.StatusCode, string(respBytes))
+	}
+
+	gj := gjson.ParseBytes(respBytes)
+	authURL := gj.Get("data.url").String()
+	if authURL == "" {
+		authURL = gj.Get("data.authorize_url").String()
+	}
+	flowID := gj.Get("data.flow_id").String()
+	if flowID == "" {
+		flowID = gj.Get("data.flowId").String()
+	}
+	interval := int(gj.Get("data.poll_interval").Int())
+	if interval <= 0 {
+		interval = int(gj.Get("data.interval").Int())
+	}
+	if interval <= 0 {
+		interval = 2
+	}
+	expiresIn := int(gj.Get("data.expires_in").Int())
+	if expiresIn <= 0 {
+		expiresIn = 300
+	}
+
+	if authURL == "" || flowID == "" {
+		return nil, fmt.Errorf("zcode init returned unexpected shape: %s", string(respBytes))
+	}
+
+	return &DeviceFlowSession{
+		VerificationURI: authURL,
+		FlowID:          flowID,
+		Interval:        interval,
+		ExpiresIn:       expiresIn,
+	}, nil
+}
+
+// PollDeviceFlow polls for authorization completion.
+func (a *ZCodeAuth) PollDeviceFlow(ctx context.Context, flowID string) (*ZCodeTokenData, error) {
+	pollURL := fmt.Sprintf("%s/%s", ZCodePollURL, flowID)
+	req, errReq := http.NewRequestWithContext(ctx, http.MethodGet, pollURL, nil)
+	if errReq != nil {
+		return nil, errReq
+	}
+	req.Header.Set("Accept", "application/json")
+
+	resp, errDo := a.httpClient.Do(req)
+	if errDo != nil {
+		return nil, fmt.Errorf("failed to poll zcode status: %w", errDo)
+	}
+	defer func() {
+		if errClose := resp.Body.Close(); errClose != nil {
+			log.Errorf("zcode poll: close response body error: %v", errClose)
+		}
+	}()
+
+	respBytes, errRead := io.ReadAll(resp.Body)
+	if errRead != nil {
+		return nil, fmt.Errorf("failed to read response body: %w", errRead)
+	}
+
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return nil, fmt.Errorf("zcode poll error %d: %s", resp.StatusCode, string(respBytes))
+	}
+
+	gj := gjson.ParseBytes(respBytes)
+	status := strings.ToLower(gj.Get("data.status").String())
+	if status == "wait" || status == "pending" || status == "" {
+		return nil, ErrDeviceFlowPending
+	}
+	if status == "expired" || status == "timeout" {
+		return nil, fmt.Errorf("zcode authorization session expired")
+	}
+	if status != "ready" && status != "success" && status != "ok" {
+		msg := gj.Get("msg").String()
+		if msg == "" {
+			msg = status
+		}
+		return nil, fmt.Errorf("zcode authorization failed: %s", msg)
+	}
+
+	token := gj.Get("data.access_token").String()
+	if token == "" {
+		token = gj.Get("data.token").String()
+	}
+	if token == "" {
+		return nil, fmt.Errorf("zcode authorization returned ready but missing token: %s", string(respBytes))
+	}
+
+	jwt := gj.Get("data.jwt").String()
+	userID := gj.Get("data.user_id").String()
+	email := gj.Get("data.email").String()
+	refreshToken := gj.Get("data.refresh_token").String()
+	expiresIn := gj.Get("data.expires_in").Int()
+	var expiresAt int64
+	if expiresIn > 0 {
+		expiresAt = time.Now().Add(time.Duration(expiresIn) * time.Second).Unix()
+	}
+
+	return &ZCodeTokenData{
+		AccessToken:  token,
+		RefreshToken: refreshToken,
+		TokenType:    "Bearer",
+		ExpiresAt:    expiresAt,
+		UID:          userID,
+		Email:        email,
+		JWT:          jwt,
+		Provider:     "zai",
+	}, nil
+}
+
+// ImportLocalConfig attempts to read ZCode or ZCode-Proxy configuration from well-known paths.
+func (a *ZCodeAuth) ImportLocalConfig() (*ZCodeTokenStorage, error) {
+	home, errHome := os.UserHomeDir()
+	if errHome != nil {
+		return nil, fmt.Errorf("failed to get user home dir: %w", errHome)
+	}
+
+	storage, errShared := a.importSharedCLICredentials(filepath.Join(home, ".zcode", "v2", "credentials.json"))
+	if storage != nil || errShared != nil {
+		return storage, errShared
+	}
+
+	candidates := []string{
+		filepath.Join(home, ".zcode-proxy", "credentials.json"),
+		filepath.Join(home, ".zcode", "cli", "config.json"),
+		filepath.Join(home, ".zcode", "v2", "config.json"),
+	}
+
+	for _, path := range candidates {
+		data, errRead := os.ReadFile(path)
+		if errRead != nil {
+			continue
+		}
+		gj := gjson.ParseBytes(data)
+
+		// Check credentials.json format
+		apiKey := gj.Get("apiKey").String()
+		if apiKey == "" {
+			apiKey = gj.Get("token").String()
+		}
+		if apiKey == "" {
+			apiKey = gj.Get("access_token").String()
+		}
+		provider := gj.Get("provider").String()
+		if provider == "" {
+			provider = "zai"
+		}
+		userId := gj.Get("userId").String()
+		if userId == "" {
+			userId = gj.Get("uid").String()
+		}
+		jwt := gj.Get("jwt").String()
+
+		if apiKey != "" {
+			storage := &ZCodeTokenStorage{
+				AccessToken: apiKey,
+				TokenType:   "Bearer",
+				UID:         userId,
+				JWT:         jwt,
+				Provider:    provider,
+				Type:        "zcode",
+			}
+			return storage, nil
+		}
+	}
+
+	return nil, fmt.Errorf("no local ZCode configuration found in ~/.zcode/ or ~/.zcode-proxy/")
+}
+
+// importSharedCLICredentials reads the flat key/value store shared by the ZCode app and CLI.
+// It returns (nil, nil) when the file is absent so older config locations are still tried.
+func (a *ZCodeAuth) importSharedCLICredentials(path string) (*ZCodeTokenStorage, error) {
+	data, errRead := os.ReadFile(path)
+	if errRead != nil {
+		return nil, nil
+	}
+	gj := gjson.ParseBytes(data)
+	if !gj.IsObject() {
+		return nil, errors.New("ZCode shared credentials are not readable JSON")
+	}
+	value := func(key string) string { return strings.TrimSpace(gj.Get(gjson.Escape(key)).String()) }
+	provider := strings.ToLower(value("oauth:active_provider"))
+	if provider != "bigmodel" && provider != "zai" {
+		provider = "zai"
+		if value("oauth:zai:access_token") == "" && value("oauth:bigmodel:access_token") != "" {
+			provider = "bigmodel"
+		}
+	}
+	accessToken := value("oauth:" + provider + ":access_token")
+	if accessToken == "" {
+		return nil, nil
+	}
+	jwt := value("zcodejwttoken")
+	// The desktop app can wrap stored values with its own cipher; never send ciphertext upstream as a token.
+	if !plainCredential(accessToken) || (jwt != "" && strings.Count(jwt, ".") != 2) {
+		return nil, errors.New("ZCode local credentials are encrypted by the app; sign in from TokenFlow instead")
+	}
+	storage := &ZCodeTokenStorage{AccessToken: accessToken, RefreshToken: value("oauth:" + provider + ":refresh_token"), JWT: jwt, Provider: provider, Type: "zcode", TokenType: "Bearer"}
+	if user := gjson.Parse(value("oauth:" + provider + ":user_info")); user.IsObject() {
+		storage.UID = strings.TrimSpace(firstNonEmpty(user.Get("user_id").String(), user.Get("userId").String(), user.Get("id").String()))
+		storage.Email = strings.TrimSpace(user.Get("email").String())
+	}
+	if provider == "bigmodel" {
+		return storage, nil
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+	defer cancel()
+	token, expiresIn, errExchange := a.ExchangeBusinessToken(ctx, accessToken)
+	if errExchange != nil {
+		return nil, fmt.Errorf("ZCode local Z.ai sign-in has expired or was rejected: %w", errExchange)
+	}
+	storage.AccessToken = token
+	if expiresIn > 0 {
+		storage.Expired = time.Now().Add(time.Duration(expiresIn) * time.Second).UTC().Format(time.RFC3339)
+	}
+	return storage, nil
+}
+
+func plainCredential(token string) bool {
+	if len(token) < 16 || len(token) > 8192 {
+		return false
+	}
+	for _, r := range token {
+		if r <= ' ' || r > '~' || r == '"' {
+			return false
+		}
+	}
+	return true
+}
+
+// Login executes the interactive CLI login flow.
+func (a *ZCodeAuth) Login(ctx context.Context, provider string) (*ZCodeTokenStorage, error) {
+	cbServer, actualPort, errServer := StartLocalCallbackServer(DefaultCallbackPort)
+	if errServer != nil {
+		return nil, fmt.Errorf("failed to start ZCode callback server: %w", errServer)
+	}
+	defer func() {
+		stopCtx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+		defer cancel()
+		_ = cbServer.Stop(stopCtx)
+	}()
+
+	redirectURI := fmt.Sprintf("http://127.0.0.1:%d/zcode/callback", actualPort)
+	b := make([]byte, 16)
+	_, _ = rand.Read(b)
+	state := hex.EncodeToString(b)
+
+	authURL, errURL := a.GenerateAuthURL(redirectURI, state)
+	if errURL != nil {
+		return nil, fmt.Errorf("failed to generate ZCode authorization URL: %w", errURL)
+	}
+
+	fmt.Println()
+	fmt.Println("================================================================")
+	fmt.Println("  ZCode (智谱 / Z.AI) Authorization Required")
+	fmt.Println("================================================================")
+	fmt.Printf("Please open the following URL in your browser to authorize:\n\n  %s\n\n", authURL)
+	fmt.Println("Waiting for authorization callback...")
+	fmt.Println("================================================================")
+
+	// Attempt to open browser automatically
+	if browser.IsAvailable() {
+		_ = browser.OpenURL(authURL)
+	}
+
+	cbResult, errWait := cbServer.WaitForCallback(5 * time.Minute)
+	if errWait != nil {
+		return nil, errWait
+	}
+	if cbResult.Error != "" {
+		return nil, fmt.Errorf("zcode authorization failed: %s", cbResult.Error)
+	}
+	if cbResult.State != state {
+		return nil, errors.New("authorization state mismatch")
+	}
+
+	storage, errExchange := a.ExchangeCodeForTokens(ctx, cbResult.Code, state, redirectURI)
+	if errExchange != nil {
+		return nil, fmt.Errorf("failed to exchange authorization tokens: %w", errExchange)
+	}
+
+	// Generate storage file name
+	authDir := a.cfg.AuthDir
+	if authDir == "" {
+		authDir = "auths"
+	}
+	fileName := fmt.Sprintf("zcode-%d.json", time.Now().UnixMilli())
+	if storage.Email != "" {
+		fileName = fmt.Sprintf("zcode-%s.json", storage.Email)
+	} else if storage.UID != "" {
+		fileName = fmt.Sprintf("zcode-%s.json", storage.UID)
+	}
+	authPath := filepath.Join(authDir, fileName)
+
+	if errSave := storage.SaveTokenToFile(authPath); errSave != nil {
+		return nil, fmt.Errorf("failed to save credentials: %w", errSave)
+	}
+
+	misc.LogSavingCredentials(authPath)
+	fmt.Printf("\nSuccessfully logged in! Credentials saved to: %s\n", authPath)
+	return storage, nil
+}
