@@ -0,0 +1,161 @@
+package auth
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/auth/workbuddy"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/browser"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	log "github.com/sirupsen/logrus"
+)
+
+// workbuddyRefreshLead is the duration before token expiry when refresh should occur.
+var workbuddyRefreshLead = 5 * time.Minute
+
+// WorkBuddyAuthenticator implements OAuth device flow and local import for Tencent WorkBuddy.
+type WorkBuddyAuthenticator struct{}
+
+// NewWorkBuddyAuthenticator constructs a new WorkBuddy authenticator.
+func NewWorkBuddyAuthenticator() Authenticator {
+	return &WorkBuddyAuthenticator{}
+}
+
+// Provider returns the provider key for WorkBuddy.
+func (WorkBuddyAuthenticator) Provider() string {
+	return "workbuddy"
+}
+
+// RefreshLead returns the duration before token expiry when refresh should occur.
+func (WorkBuddyAuthenticator) RefreshLead() *time.Duration {
+	return &workbuddyRefreshLead
+}
+
+// Login initiates WorkBuddy authentication via local desktop import or OAuth device flow.
+func (a WorkBuddyAuthenticator) Login(ctx context.Context, cfg *config.Config, opts *LoginOptions) (*coreauth.Auth, error) {
+	if cfg == nil {
+		return nil, fmt.Errorf("cliproxy auth: configuration is required")
+	}
+	if opts == nil {
+		opts = &LoginOptions{}
+	}
+
+	authSvc := workbuddy.NewWorkBuddyAuth(cfg)
+
+	var tokenData *workbuddy.WorkBuddyTokenData
+	var err error
+
+	// 1. Check if token was provided in metadata or environment
+	token := ""
+	if opts.Metadata != nil {
+		if v, ok := opts.Metadata["access_token"]; ok && strings.TrimSpace(v) != "" {
+			token = strings.TrimSpace(v)
+		}
+	}
+	if token == "" {
+		token = strings.TrimSpace(os.Getenv("WORKBUDDY_ACCESS_TOKEN"))
+	}
+
+	if token != "" {
+		uid := ""
+		if opts.Metadata != nil {
+			uid = strings.TrimSpace(opts.Metadata["uid"])
+		}
+		tokenData = &workbuddy.WorkBuddyTokenData{
+			AccessToken: token,
+			UID:         uid,
+			ExpiresIn:   2592000,
+			ExpiresAt:   time.Now().Unix() + 2592000,
+		}
+	} else if opts.Metadata != nil && (opts.Metadata["local_import"] == "true" || opts.Metadata["import_local"] == "true") {
+		// Import from local WorkBuddy Desktop installation
+		tokenData, err = workbuddy.ImportLocalAuth()
+		if err != nil {
+			return nil, fmt.Errorf("workbuddy: local import failed: %w", err)
+		}
+	} else {
+		// Start OAuth device flow
+		fmt.Println("Starting WorkBuddy authentication...")
+		session, errStart := authSvc.RequestState(ctx)
+		if errStart != nil {
+			return nil, fmt.Errorf("workbuddy: failed to start auth flow: %w", errStart)
+		}
+
+		verificationURL := session.AuthURL
+		fmt.Printf("\nTo authenticate, please visit:\n%s\n\n", verificationURL)
+
+		if !opts.NoBrowser {
+			if browser.IsAvailable() {
+				if errOpen := browser.OpenURL(verificationURL); errOpen != nil {
+					log.Warnf("Failed to open browser automatically: %v", errOpen)
+				} else {
+					fmt.Println("Browser opened automatically.")
+				}
+			}
+		}
+
+		fmt.Println("Waiting for authorization...")
+		bundle, errWait := authSvc.WaitForAuthorization(ctx, session)
+		if errWait != nil {
+			return nil, fmt.Errorf("workbuddy: %w", errWait)
+		}
+		tokenData = bundle.TokenData
+	}
+
+	if tokenData == nil || tokenData.AccessToken == "" {
+		return nil, fmt.Errorf("workbuddy: authentication returned empty access token")
+	}
+
+	// Create token storage
+	tokenStorage := authSvc.CreateTokenStorage(&workbuddy.WorkBuddyAuthBundle{TokenData: tokenData})
+
+	// Build metadata
+	metadata := map[string]any{
+		"type":          "workbuddy",
+		"access_token":  tokenData.AccessToken,
+		"refresh_token": tokenData.RefreshToken,
+		"timestamp":     time.Now().UnixMilli(),
+	}
+	if tokenData.ExpiresAt > 0 {
+		metadata["expired"] = time.Unix(tokenData.ExpiresAt, 0).UTC().Format(time.RFC3339)
+	}
+	if tokenData.UID != "" {
+		metadata["uid"] = tokenData.UID
+	}
+	if tokenData.Nickname != "" {
+		metadata["nickname"] = tokenData.Nickname
+	}
+	if tokenData.EnterpriseID != "" {
+		metadata["enterprise_id"] = tokenData.EnterpriseID
+	}
+	if tokenData.Domain != "" {
+		metadata["domain"] = tokenData.Domain
+	}
+
+	fileName := fmt.Sprintf("workbuddy-%d.json", time.Now().UnixMilli())
+	if tokenData.UID != "" {
+		fileName = fmt.Sprintf("workbuddy-%s.json", tokenData.UID)
+	}
+
+	label := "WorkBuddy User"
+	if tokenData.Nickname != "" {
+		label = fmt.Sprintf("WorkBuddy (%s)", tokenData.Nickname)
+	} else if tokenData.UID != "" {
+		label = fmt.Sprintf("WorkBuddy (%s)", tokenData.UID)
+	}
+
+	fmt.Println("\nWorkBuddy authentication successful!")
+
+	return &coreauth.Auth{
+		ID:       fileName,
+		Provider: a.Provider(),
+		FileName: fileName,
+		Label:    label,
+		Storage:  tokenStorage,
+		Metadata: metadata,
+	}, nil
+}
