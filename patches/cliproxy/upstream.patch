+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+)
+
+func TestZCodeExecutor_Execute(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		auth := r.Header.Get("Authorization")
+		if auth != "Bearer test-zcode-key" {
+			w.WriteHeader(http.StatusUnauthorized)
+			_, _ = w.Write([]byte(`{"error":"unauthorized"}`))
+			return
+		}
+
+		w.Header().Set("Content-Type", "text/event-stream")
+		w.WriteHeader(http.StatusOK)
+		_, _ = w.Write([]byte("data: {\"choices\":[{\"delta\":{\"content\":\"Hello from ZCode!\",\"reasoning_content\":\"thinking...\"},\"index\":0}]}\n\n"))
+		_, _ = w.Write([]byte("data: [DONE]\n\n"))
+	}))
+	defer server.Close()
+
+	cfg := &config.Config{}
+	exec := NewZCodeExecutor(cfg)
+
+	auth := &cliproxyauth.Auth{
+		Metadata: map[string]any{
+			"access_token": "test-zcode-key",
+			"base_url":     server.URL,
+		},
+	}
+
+	req := cliproxyexecutor.Request{
+		Model:   "glm-5.3",
+		Payload: []byte(`{"messages":[{"role":"user","content":"hi"}]}`),
+	}
+	opts := cliproxyexecutor.Options{}
+
+	resp, errExec := exec.Execute(context.Background(), auth, req, opts)
+	if errExec != nil {
+		t.Fatalf("Execute error: %v", errExec)
+	}
+
+	payloadStr := string(resp.Payload)
+	if len(payloadStr) == 0 {
+		t.Fatal("Execute response payload is empty")
+	}
+	if !testing.Short() {
+		t.Logf("Response: %s", payloadStr)
+	}
+}
