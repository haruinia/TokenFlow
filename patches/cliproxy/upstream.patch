diff --git a/internal/runtime/executor/helps/doubao_helpers.go b/internal/runtime/executor/helps/doubao_helpers.go
new file mode 100644
index 00000000..f77aedbf
--- /dev/null
+++ b/internal/runtime/executor/helps/doubao_helpers.go
@@ -0,0 +1,49 @@
+package helps
+
+import (
+	"strings"
+
+	"github.com/tidwall/sjson"
+)
+
+const (
+	// DoubaoDefaultChatURL is the standard Volcano Engine Ark OpenAI chat completion endpoint.
+	DoubaoDefaultChatURL = "https://ark.cn-beijing.volces.com/api/v3/chat/completions"
+)
+
+// NormalizeDoubaoModel normalizes ByteDance Doubao / Ark model identifiers.
+func NormalizeDoubaoModel(model string) string {
+	m := strings.ToLower(strings.TrimSpace(model))
+	switch m {
+	case "doubao-seed-1.6", "doubao-seed", "seed-1.6":
+		return "doubao-seed-1.6"
+	case "doubao-seed-1.6-thinking", "seed-thinking":
+		return "doubao-seed-1.6-thinking"
+	case "doubao-1.5-pro", "doubao-1.5-pro-32k", "doubao-pro-32k":
+		return "doubao-1.5-pro-32k"
+	case "doubao-1.5-pro-256k", "doubao-pro-256k":
+		return "doubao-1.5-pro-256k"
+	case "doubao-1.5-thinking", "doubao-1.5-thinking-vision-preview", "doubao-thinking":
+		return "doubao-1.5-thinking-vision-preview"
+	case "doubao-1.5-lite", "doubao-1.5-lite-32k", "doubao-lite-32k":
+		return "doubao-1.5-lite-32k"
+	case "doubao-lite-4k":
+		return "doubao-lite-4k"
+	case "doubao-pro-4k":
+		return "doubao-pro-4k"
+	default:
+		if m != "" {
+			return m
+		}
+		return "doubao-1.5-pro-32k"
+	}
+}
+
+// BuildDoubaoRequestBody sets the normalized model and ensures compatibility.
+func BuildDoubaoRequestBody(raw []byte, model string) ([]byte, error) {
+	if len(raw) == 0 {
+		raw = []byte("{}")
+	}
+	modelKey := NormalizeDoubaoModel(model)
+	return sjson.SetBytes(raw, "model", modelKey)
+}
