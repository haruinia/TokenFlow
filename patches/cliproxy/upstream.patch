index 00000000..66f49307
--- /dev/null
+++ b/sdk/auth/doubao.go
@@ -0,0 +1,152 @@
+package auth
+
+import (
+	"bufio"
+	"context"
+	"fmt"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/auth/doubao"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+)
+
+// DoubaoAuthenticator implements authentication for ByteDance Doubao / MarsCode.
+type DoubaoAuthenticator struct{}
+
+// NewDoubaoAuthenticator constructs a new Doubao authenticator.
+func NewDoubaoAuthenticator() Authenticator {
+	return &DoubaoAuthenticator{}
+}
+
+// Provider returns the provider key for doubao.
+func (DoubaoAuthenticator) Provider() string {
+	return "doubao"
+}
+
+// RefreshLead returns the duration before token expiry when refresh should occur.
+func (DoubaoAuthenticator) RefreshLead() *time.Duration {
+	lead := 5 * time.Minute
+	return &lead
+}
+
+// Login initiates Doubao authentication via local configuration discovery, direct token, or interactive input.
+func (a DoubaoAuthenticator) Login(ctx context.Context, cfg *config.Config, opts *LoginOptions) (*coreauth.Auth, error) {
+	if cfg == nil {
+		return nil, fmt.Errorf("cliproxy auth: configuration is required")
+	}
+	if opts == nil {
+		opts = &LoginOptions{}
+	}
+
+	authDir := cfg.AuthDir
+	if authDir == "" {
+		authDir = "auths"
+	}
+
+	// 1. Check if token was provided in metadata or environment variable
+	token := ""
+	refreshToken := ""
+	host := doubao.DefaultDoubaoHost
+	if opts.Metadata != nil {
+		if v, ok := opts.Metadata["token"]; ok && strings.TrimSpace(v) != "" {
+			token = strings.TrimSpace(v)
+		} else if v, ok := opts.Metadata["access_token"]; ok && strings.TrimSpace(v) != "" {
+			token = strings.TrimSpace(v)
+		} else if v, ok := opts.Metadata["api_key"]; ok && strings.TrimSpace(v) != "" {
+			token = strings.TrimSpace(v)
+		}
+		if v, ok := opts.Metadata["refresh_token"]; ok && strings.TrimSpace(v) != "" {
+			refreshToken = strings.TrimSpace(v)
+		}
+		if v, ok := opts.Metadata["host"]; ok && strings.TrimSpace(v) != "" {
+			host = strings.TrimSpace(v)
+		}
+	}
+
+	if token == "" {
+		token = strings.TrimSpace(os.Getenv("DOUBAO_TOKEN"))
+		if token == "" {
+			token = strings.TrimSpace(os.Getenv("DOUBAO_API_KEY"))
+		}
+	}
+
+	if token != "" {
+		storage := &doubao.DoubaoTokenStorage{
+			AccessToken:  token,
+			RefreshToken: refreshToken,
+			TokenType:    "Bearer",
+			Host:         host,
+			Provider:     "doubao",
+			Type:         "doubao",
+		}
+		if errSave := storage.SaveToken(authDir); errSave != nil {
+			return nil, fmt.Errorf("doubao: failed to save token: %w", errSave)
+		}
+		return toCoreAuthDoubao(storage), nil
+	}
+
+	// 2. Try importing local credentials from MarsCode / Doubao desktop client
+	storage, errImport := doubao.ImportLocalDoubaoCredentials(authDir)
+	if errImport == nil && storage != nil && storage.AccessToken != "" {
+		fmt.Println("Successfully imported Doubao / MarsCode session from local desktop client!")
+		return toCoreAuthDoubao(storage), nil
+	}
+
+	// 3. Fallback to interactive prompt if in terminal
+	fmt.Println("\nCould not automatically locate local Doubao / MarsCode credentials.")
+	fmt.Print("Enter Doubao access token (JWT) or API Key, or press Enter to cancel: ")
+
+	scanner := bufio.NewScanner(os.Stdin)
+	if scanner.Scan() {
+		input := strings.TrimSpace(scanner.Text())
+		if input != "" {
+			storage := &doubao.DoubaoTokenStorage{
+				AccessToken: input,
+				TokenType:   "Bearer",
+				Host:        host,
+				Provider:    "doubao",
+				Type:        "doubao",
+			}
+			if errSave := storage.SaveToken(authDir); errSave != nil {
+				return nil, fmt.Errorf("doubao: failed to save token: %w", errSave)
+			}
+			return toCoreAuthDoubao(storage), nil
+		}
+	}
+
+	return nil, fmt.Errorf("doubao: authentication cancelled or no credentials provided")
+}
+
+func toCoreAuthDoubao(storage *doubao.DoubaoTokenStorage) *coreauth.Auth {
+	label := "Doubao"
+	if storage.Email != "" {
+		label += " (" + storage.Email + ")"
+	} else if storage.Username != "" {
+		label += " (" + storage.Username + ")"
+	} else if storage.UserID != "" {
+		label += " (" + storage.UserID + ")"
+	}
+
+	metadata := map[string]any{
+		"access_token": storage.AccessToken,
+		"host":         storage.Host,
+		"user_id":      storage.UserID,
+		"email":        storage.Email,
+		"username":     storage.Username,
+		"provider":     "doubao",
+		"type":         "doubao",
+	}
+
+	return &coreauth.Auth{
+		Storage:  storage,
+		Label:    label,
+		Metadata: metadata,
+		Attributes: map[string]string{
+			"provider": "doubao",
+			"api_key":  storage.AccessToken,
+		},
+	}
+}
diff --git a/sdk/auth/qoder.go b/sdk/auth/qoder.go
new file mode 100644
index 00000000..8ee3561e
--- /dev/null
+++ b/sdk/auth/qoder.go
@@ -0,0 +1,153 @@
+package auth
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/auth/qoder"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/browser"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	log "github.com/sirupsen/logrus"
+)
+
+// qoderRefreshLead is the duration before token expiry when refresh should occur.
+var qoderRefreshLead = 5 * time.Minute
+
+// QoderAuthenticator implements the OAuth device flow and PAT login for Alibaba Qoder.
+type QoderAuthenticator struct{}
+
+// NewQoderAuthenticator constructs a new Qoder authenticator.
+func NewQoderAuthenticator() Authenticator {
+	return &QoderAuthenticator{}
+}
+
+// Provider returns the provider key for qoder.
+func (QoderAuthenticator) Provider() string {
+	return "qoder"
+}
+
+// RefreshLead returns the duration before token expiry when refresh should occur.
+func (QoderAuthenticator) RefreshLead() *time.Duration {
+	return &qoderRefreshLead
+}
+
+// Login initiates Qoder authentication via PAT or OAuth PKCE device flow.
+func (a QoderAuthenticator) Login(ctx context.Context, cfg *config.Config, opts *LoginOptions) (*coreauth.Auth, error) {
+	if cfg == nil {
+		return nil, fmt.Errorf("cliproxy auth: configuration is required")
+	}
+	if opts == nil {
+		opts = &LoginOptions{}
+	}
+
+	authSvc := qoder.NewQoderAuth(cfg)
+
+	// Check if Personal Access Token (PAT) was provided in metadata or environment
+	pat := ""
+	if opts.Metadata != nil {
+		if v, ok := opts.Metadata["access_token"]; ok && strings.TrimSpace(v) != "" {
+			pat = strings.TrimSpace(v)
+		} else if v, ok := opts.Metadata["personal_access_token"]; ok && strings.TrimSpace(v) != "" {
+			pat = strings.TrimSpace(v)
+		} else if v, ok := opts.Metadata["pat"]; ok && strings.TrimSpace(v) != "" {
+			pat = strings.TrimSpace(v)
+		}
+	}
+	if pat == "" {
+		pat = strings.TrimSpace(os.Getenv("QODER_PERSONAL_ACCESS_TOKEN"))
+	}
+
+	var authBundle *qoder.QoderAuthBundle
+	var err error
+
+	if pat != "" {
+		fmt.Println("Validating Qoder Personal Access Token (PAT)...")
+		authBundle, err = authSvc.VerifyPAT(ctx, pat)
+		if err != nil {
+			return nil, fmt.Errorf("qoder: PAT validation failed: %w", err)
+		}
+		fmt.Println("Qoder Personal Access Token is valid.")
+	} else {
+		// Start OAuth PKCE device flow
+		fmt.Println("Starting Qoder authentication...")
+		session, errStart := authSvc.StartDeviceFlow(ctx)
+		if errStart != nil {
+			return nil, fmt.Errorf("qoder: failed to start device flow: %w", errStart)
+		}
+
+		verificationURL := session.VerificationURI
+		fmt.Printf("\nTo authenticate, please visit:\n%s\n\n", verificationURL)
+
+		// Try to open the browser automatically
+		if !opts.NoBrowser {
+			if browser.IsAvailable() {
+				if errOpen := browser.OpenURL(verificationURL); errOpen != nil {
+					log.Warnf("Failed to open browser automatically: %v", errOpen)
+				} else {
+					fmt.Println("Browser opened automatically.")
+				}
+			}
+		}
+
+		fmt.Println("Waiting for authorization...")
+		if session.ExpiresIn > 0 {
+			fmt.Printf("(This will timeout in %d seconds if not authorized)\n", session.ExpiresIn)
+		}
+
+		authBundle, err = authSvc.WaitForAuthorization(ctx, session)
+		if err != nil {
+			return nil, fmt.Errorf("qoder: %w", err)
+		}
+	}
+
+	// Create token storage
+	tokenStorage := authSvc.CreateTokenStorage(authBundle)
+
+	// Build metadata with token information
+	metadata := map[string]any{
+		"type":         "qoder",
+		"access_token": authBundle.TokenData.AccessToken,
+		"token_type":   authBundle.TokenData.TokenType,
+		"timestamp":    time.Now().UnixMilli(),
+	}
+
+	if authBundle.TokenData.RefreshToken != "" {
+		metadata["refresh_token"] = authBundle.TokenData.RefreshToken
+	}
+	if authBundle.TokenData.ExpiresAt > 0 {
+		exp := time.Unix(authBundle.TokenData.ExpiresAt, 0).UTC().Format(time.RFC3339)
+		metadata["expired"] = exp
+	}
+	if strings.TrimSpace(authBundle.TokenData.UID) != "" {
+		metadata["uid"] = strings.TrimSpace(authBundle.TokenData.UID)
+	}
+	if strings.TrimSpace(authBundle.TokenData.Email) != "" {
+		metadata["email"] = strings.TrimSpace(authBundle.TokenData.Email)
+	}
+	if strings.TrimSpace(authBundle.MachineID) != "" {
+		metadata["machine_id"] = strings.TrimSpace(authBundle.MachineID)
+	}
+
+	fileName := fmt.Sprintf("qoder-%d.json", time.Now().UnixMilli())
+	label := "Qoder User"
+	if authBundle.TokenData.Email != "" {
+		label = fmt.Sprintf("Qoder (%s)", authBundle.TokenData.Email)
+	} else if authBundle.TokenData.UID != "" {
+		label = fmt.Sprintf("Qoder (%s)", authBundle.TokenData.UID)
+	}
+
+	fmt.Println("\nQoder authentication successful!")
+
+	return &coreauth.Auth{
+		ID:       fileName,
+		Provider: a.Provider(),
+		FileName: fileName,
