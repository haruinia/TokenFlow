@@ -0,0 +1,171 @@
+package trae
+
+import (
+	"context"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestTraeTokenStorage_Serialization(t *testing.T) {
+	tempDir, errTemp := os.MkdirTemp("", "TestTraeTokenStorage_*")
+	if errTemp != nil {
+		t.Fatalf("failed to create temp dir: %v", errTemp)
+	}
+	defer os.RemoveAll(tempDir)
+
+	storage := &TraeTokenStorage{
+		AccessToken:  "mock-trae-jwt-token",
+		RefreshToken: "mock-trae-refresh-token",
+		TokenType:    "Bearer",
+		Expired:      time.Now().Add(2 * time.Hour).Format(time.RFC3339),
+		Host:         DefaultTraeHost,
+		UserID:       "7570024536209867787",
+		Email:        "trae-user@example.com",
+		Username:     "Trae Developer",
+		Region:       "US",
+		Provider:     "trae",
+		Type:         "trae",
+	}
+
+	if errSave := storage.SaveToken(tempDir); errSave != nil {
+		t.Fatalf("SaveToken failed: %v", errSave)
+	}
+
+	expectedFile := filepath.Join(tempDir, "trae-trae-user_example.com.json")
+	data, errRead := os.ReadFile(expectedFile)
+	if errRead != nil {
+		t.Fatalf("failed to read saved token file: %v", errRead)
+	}
+
+	var loaded TraeTokenStorage
+	if errUnmarshal := json.Unmarshal(data, &loaded); errUnmarshal != nil {
+		t.Fatalf("failed to unmarshal saved token: %v", errUnmarshal)
+	}
+
+	if loaded.AccessToken != storage.AccessToken {
+		t.Errorf("expected access_token %q, got %q", storage.AccessToken, loaded.AccessToken)
+	}
+	if loaded.Email != storage.Email {
+		t.Errorf("expected email %q, got %q", storage.Email, loaded.Email)
+	}
+	if loaded.Type != "trae" {
+		t.Errorf("expected type 'trae', got %q", loaded.Type)
+	}
+}
+
+func TestTraeTokenStorage_NeedsRefresh(t *testing.T) {
+	// Not expired
+	storage := &TraeTokenStorage{
+		RefreshToken: "some-token",
+		Expired:      time.Now().Add(1 * time.Hour).Format(time.RFC3339),
+	}
+	if storage.NeedsRefresh() {
+		t.Errorf("expected NeedsRefresh to be false for future expiration")
+	}
+
+	// Near expiration (2 minutes left)
+	storageNear := &TraeTokenStorage{
+		RefreshToken: "some-token",
+		Expired:      time.Now().Add(2 * time.Minute).Format(time.RFC3339),
+	}
+	if !storageNear.NeedsRefresh() {
+		t.Errorf("expected NeedsRefresh to be true when expiring within 5 minutes")
+	}
+}
+
+func TestTraeGenerateAuthSession(t *testing.T) {
+	// Without callback URL
+	authURL, state, err := GenerateAuthSession()
+	if err != nil {
+		t.Fatalf("GenerateAuthSession failed: %v", err)
+	}
+	if authURL == "" || state == "" {
+		t.Errorf("expected non-empty url and state, got url=%q, state=%q", authURL, state)
+	}
+	if !strings.HasPrefix(authURL, "https://www.trae.ai/login?redirect_url=") {
+		t.Errorf("expected URL to start with login redirect wrapper, got %s", authURL)
+	}
+
+	// With callback URL
+	callback := "http://127.0.0.1:8318/trae/callback"
+	authURLWithCallback, state2, err2 := GenerateAuthSession(callback)
+	if err2 != nil {
+		t.Fatalf("GenerateAuthSession with callback failed: %v", err2)
+	}
+	if !strings.Contains(authURLWithCallback, "auth_callback_url") {
+		t.Errorf("expected URL to include auth_callback_url parameter, got %s", authURLWithCallback)
+	}
+	if state2 == "" {
+		t.Errorf("expected non-empty state")
+	}
+}
+
+func TestTraeParseCallbackData(t *testing.T) {
+	ctx := context.Background()
+
+	rawAuthCodeInfo := `{"Token":"test-access-token","RefreshToken":"test-refresh-token","TokenExpireAt":1790000000}`
+	rawUserInfo := `{"UserID":"7570024536209867787","Email":"test@example.com","Username":"TestUser"}`
+
+	storage, err := ParseCallbackData(ctx, rawAuthCodeInfo, rawUserInfo, "https://api-us-east.trae.ai", "")
+	if err != nil {
+		t.Fatalf("ParseCallbackData failed: %v", err)
+	}
+
+	if storage.AccessToken != "test-access-token" {
+		t.Errorf("expected access token 'test-access-token', got %q", storage.AccessToken)
+	}
+	if storage.RefreshToken != "test-refresh-token" {
+		t.Errorf("expected refresh token 'test-refresh-token', got %q", storage.RefreshToken)
+	}
+	if storage.UserID != "7570024536209867787" {
+		t.Errorf("expected user id '7570024536209867787', got %q", storage.UserID)
+	}
+	if storage.Email != "test@example.com" {
+		t.Errorf("expected email 'test@example.com', got %q", storage.Email)
+	}
+	if storage.Username != "TestUser" {
+		t.Errorf("expected username 'TestUser', got %q", storage.Username)
+	}
+}
+
+func TestTokenFlowTraeLocalSessionExpiry(t *testing.T) {
+	now := time.Date(2026, 10, 17, 0, 0, 0, 0, time.UTC)
+	past, future := now.Add(-time.Hour).Format(time.RFC3339), now.Add(time.Hour).Format(time.RFC3339)
+	cases := []struct {
+		name    string
+		data    TraeTokenData
+		expired bool
+	}{
+		{"refresh token expired", TraeTokenData{RefreshToken: "r", RefreshExpiredAt: past, ExpiredAt: future}, true},
+		{"refresh token expired in milliseconds", TraeTokenData{RefreshToken: "r", RefreshExpiredAt: strconv.FormatInt(now.Add(-time.Hour).UnixMilli(), 10)}, true},
+		{"access expired but refreshable", TraeTokenData{RefreshToken: "r", RefreshExpiredAt: future, ExpiredAt: past}, false},
+		{"access expired without refresh token", TraeTokenData{ExpiredAt: past}, true},
+		{"no expiry information", TraeTokenData{RefreshToken: "r"}, false},
+	}
+	for _, c := range cases {
+		if got := localSessionExpired(c.data, now); got != c.expired {
+			t.Fatalf("%s: expired=%v", c.name, got)
+		}
+	}
+}
+
+func TestTokenFlowTraeRefreshWithoutTokenFails(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		_, _ = w.Write([]byte(`{"ResponseMetadata":{},"Result":{}}`))
+	}))
+	defer server.Close()
+	ts := &TraeTokenStorage{AccessToken: "old-access", RefreshToken: "fixture-refresh", Host: server.URL}
+	if err := RefreshToken(context.Background(), ts); err == nil {
+		t.Fatal("an empty refresh response must not count as success")
+	}
+	if ts.AccessToken != "old-access" {
+		t.Fatal("failed refresh changed the stored token")
+	}
+}
diff --git a/internal/auth/workbuddy/token.go b/internal/auth/workbuddy/token.go
new file mode 100644
index 00000000..aba5223c
--- /dev/null
+++ b/internal/auth/workbuddy/token.go
@@ -0,0 +1,110 @@
+package workbuddy
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/misc"
+	log "github.com/sirupsen/logrus"
+)
+
+const (
+	refreshThresholdSeconds = 300
+)
+
+// WorkBuddyTokenStorage stores token information for Tencent WorkBuddy API authentication.
+type WorkBuddyTokenStorage struct {
+	AccessToken  string `json:"access_token"`
+	RefreshToken string `json:"refresh_token,omitempty"`
+	TokenType    string `json:"token_type"`
+	Expired      string `json:"expired,omitempty"`
+	UID          string `json:"uid,omitempty"`
+	EnterpriseID string `json:"enterprise_id,omitempty"`
+	Nickname     string `json:"nickname,omitempty"`
+	Type         string `json:"type"`
+
+	Metadata map[string]any `json:"-"`
+}
+
+// SetMetadata allows external callers to inject metadata into the storage before saving.
+func (ts *WorkBuddyTokenStorage) SetMetadata(meta map[string]any) {
+	ts.Metadata = meta
+}
+
+// SaveTokenToFile serializes the WorkBuddy token storage to a JSON file.
+func (ts *WorkBuddyTokenStorage) SaveTokenToFile(authFilePath string) error {
+	misc.LogSavingCredentials(authFilePath)
+	ts.Type = "workbuddy"
+
+	if err := os.MkdirAll(filepath.Dir(authFilePath), 0700); err != nil {
+		return fmt.Errorf("failed to create directory: %w", err)
+	}
+
+	data, errMerge := misc.MergeMetadata(ts, ts.Metadata)
+	if errMerge != nil {
+		return fmt.Errorf("failed to merge metadata: %w", errMerge)
+	}
+
+	f, err := os.Create(authFilePath)
+	if err != nil {
+		return fmt.Errorf("failed to create token file: %w", err)
+	}
+	defer func() {
+		if errClose := f.Close(); errClose != nil {
+			log.Errorf("workbuddy token storage: close token file error: %v", errClose)
+		}
+	}()
+
+	encoder := json.NewEncoder(f)
+	encoder.SetIndent("", "  ")
+	if err = encoder.Encode(data); err != nil {
+		return fmt.Errorf("failed to write token to file: %w", err)
+	}
+	return nil
+}
+
+// IsExpired checks if the token has expired.
+func (ts *WorkBuddyTokenStorage) IsExpired() bool {
+	if ts.Expired == "" {
+		return false
+	}
+	t, err := time.Parse(time.RFC3339, ts.Expired)
+	if err != nil {
+		return true
+	}
+	return time.Now().Add(time.Duration(refreshThresholdSeconds) * time.Second).After(t)
+}
+
+// NeedsRefresh checks if the token should be refreshed.
+func (ts *WorkBuddyTokenStorage) NeedsRefresh() bool {
+	if ts.RefreshToken == "" {
+		return false
+	}
+	return ts.IsExpired()
+}
+
+// CreateTokenStorage builds a persistent WorkBuddyTokenStorage from an auth bundle.
+func (w *WorkBuddyAuth) CreateTokenStorage(bundle *WorkBuddyAuthBundle) *WorkBuddyTokenStorage {
+	if bundle == nil || bundle.TokenData == nil {
+		return &WorkBuddyTokenStorage{Type: "workbuddy", TokenType: "Bearer"}
+	}
+	td := bundle.TokenData
+	expired := ""
+	if td.ExpiresAt > 0 {
+		expired = time.Unix(td.ExpiresAt, 0).UTC().Format(time.RFC3339)
+	}
+	return &WorkBuddyTokenStorage{
+		AccessToken:  td.AccessToken,
+		RefreshToken: td.RefreshToken,
+		TokenType:    "Bearer",
+		Expired:      expired,
+		UID:          strings.TrimSpace(td.UID),
+		EnterpriseID: strings.TrimSpace(td.EnterpriseID),
+		Nickname:     strings.TrimSpace(td.Nickname),
+		Type:         "workbuddy",
+	}
+}
diff --git a/internal/auth/workbuddy/workbuddy.go b/internal/auth/workbuddy/workbuddy.go
