diff --git a/internal/auth/doubao/doubao.go b/internal/auth/doubao/doubao.go
new file mode 100644
index 00000000..d0fecc05
--- /dev/null
+++ b/internal/auth/doubao/doubao.go
@@ -0,0 +1,407 @@
+package doubao
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/misc"
+	log "github.com/sirupsen/logrus"
+)
+
+const (
+	// DefaultDoubaoHost is the default ByteDance Doubao / MarsCode API endpoint.
+	DefaultDoubaoHost = "https://api.marscode.cn"
+	// DefaultClientID is the public native client ID for ByteDance Doubao / MarsCode IDE.
+	DefaultClientID = "ono9krqynydwx5"
+	// DoubaoStorageAuthKey is the key in MarsCode/Doubao global storage containing the session.
+	DoubaoStorageAuthKey = "iCubeAuthInfo://icube.cloudide"
+)
+
+// GenerateAuthSession creates an OAuth authorization URL and state token for ByteDance Doubao.
+func GenerateAuthSession() (authURL string, state string, err error) {
+	b := make([]byte, 16)
+	if _, errRand := rand.Read(b); errRand != nil {
+		return "", "", fmt.Errorf("failed to generate random state: %w", errRand)
+	}
+	state = hex.EncodeToString(b)
+
+	authURL = fmt.Sprintf(
+		"https://www.marscode.cn/authorization?login_version=1&auth_from=doubao&login_channel=native_ide&auth_type=local&client_id=%s&state=%s",
+		DefaultClientID,
+		state,
+	)
+
+	return authURL, state, nil
+}
+
+// ImportLocalDoubaoCredentials searches the standard configuration directories
+// of MarsCode, Doubao, and VSCode desktop clients to import the active ByteDance session token.
+func ImportLocalDoubaoCredentials(authDir string) (*DoubaoTokenStorage, error) {
+	candidates := getLocalDoubaoStoragePaths()
+	if len(candidates) == 0 {
+		return nil, errors.New("no local Doubao storage paths could be resolved")
+	}
+
+	var foundPath string
+	var rawData []byte
+
+	for _, path := range candidates {
+		if path == "" {
+			continue
+		}
+		data, errRead := os.ReadFile(path)
+		if errRead == nil && len(data) > 0 {
+			if strings.Contains(string(data), DoubaoStorageAuthKey) {
+				foundPath = path
+				rawData = data
+				break
+			}
+		}
+	}
+
+	if foundPath == "" || len(rawData) == 0 {
+		return nil, fmt.Errorf("no local Doubao credentials found in candidate paths: %v", candidates)
+	}
+
+	log.Infof("Found local Doubao session storage at %s", foundPath)
+
+	var storageMap map[string]any
+	if errJSON := json.Unmarshal(rawData, &storageMap); errJSON != nil {
+		return nil, fmt.Errorf("failed to parse Doubao storage JSON at %s: %w", foundPath, errJSON)
+	}
+
+	rawVal, ok := storageMap[DoubaoStorageAuthKey]
+	if !ok || rawVal == nil {
+		return nil, fmt.Errorf("key %q not found in Doubao storage at %s", DoubaoStorageAuthKey, foundPath)
+	}
+
+	valStr, okStr := rawVal.(string)
+	if !okStr || valStr == "" {
+		return nil, fmt.Errorf("invalid value for %q in Doubao storage", DoubaoStorageAuthKey)
+	}
+
+	var tokenData DoubaoTokenData
+	if errParse := json.Unmarshal([]byte(valStr), &tokenData); errParse != nil {
+		return nil, fmt.Errorf("failed to parse Doubao auth data from storage: %w", errParse)
+	}
+
+	if tokenData.AccessToken == "" {
+		return nil, errors.New("extracted Doubao auth info contains empty access token")
+	}
+
+	host := tokenData.Host
+	if host == "" {
+		host = DefaultDoubaoHost
+	}
+
+	storage := &DoubaoTokenStorage{
+		AccessToken:      tokenData.AccessToken,
+		RefreshToken:     tokenData.RefreshToken,
+		TokenType:        "Bearer",
+		Expired:          tokenData.ExpiredAt,
+		ExpiresAt:        tokenData.ExpiresAt,
+		RefreshExpiredAt: tokenData.RefreshExpiredAt,
+		Host:             host,
+		UserID:           tokenData.UserID,
+		Email:            tokenData.Account.Email,
+		Username:         tokenData.Account.Username,
+		Provider:         "doubao",
+		Type:             "doubao",
+	}
+
+	if errSave := storage.SaveToken(authDir); errSave != nil {
+		return nil, fmt.Errorf("failed to save imported Doubao token: %w", errSave)
+	}
+
+	return storage, nil
+}
+
+// getLocalDoubaoStoragePaths returns platform-dependent candidate paths for MarsCode/Doubao storage.json.
+func getLocalDoubaoStoragePaths() []string {
+	var paths []string
+	homeDir, errHome := os.UserHomeDir()
+	if errHome != nil {
+		return paths
+	}
+
+	switch runtime.GOOS {
+	case "darwin":
+		paths = append(paths,
+			filepath.Join(homeDir, "Library", "Application Support", "MarsCode", "User", "globalStorage", "storage.json"),
+			filepath.Join(homeDir, "Library", "Application Support", "Doubao", "User", "globalStorage", "storage.json"),
+			filepath.Join(homeDir, "Library", "Application Support", "Code", "User", "globalStorage", "storage.json"),
+			filepath.Join(homeDir, "Library", "Application Support", "Trae", "User", "globalStorage", "storage.json"),
+		)
+	case "windows":
+		appData := os.Getenv("APPDATA")
+		if appData != "" {
+			paths = append(paths,
+				filepath.Join(appData, "MarsCode", "User", "globalStorage", "storage.json"),
+				filepath.Join(appData, "Doubao", "User", "globalStorage", "storage.json"),
+				filepath.Join(appData, "Code", "User", "globalStorage", "storage.json"),
+				filepath.Join(appData, "Trae", "User", "globalStorage", "storage.json"),
+			)
+		}
+	default: // linux and others
+		configDir := os.Getenv("XDG_CONFIG_HOME")
+		if configDir == "" {
+			configDir = filepath.Join(homeDir, ".config")
+		}
+		paths = append(paths,
+			filepath.Join(configDir, "MarsCode", "User", "globalStorage", "storage.json"),
+			filepath.Join(configDir, "Doubao", "User", "globalStorage", "storage.json"),
+			filepath.Join(configDir, "Code", "User", "globalStorage", "storage.json"),
+			filepath.Join(configDir, "Trae", "User", "globalStorage", "storage.json"),
+		)
+	}
+
+	return paths
+}
+
+// RefreshToken attempts to refresh the Doubao access token using the refresh token.
+func RefreshToken(ctx context.Context, ts *DoubaoTokenStorage) error {
+	if ts.RefreshToken == "" {
+		return errors.New("no refresh token available for Doubao")
+	}
+
+	host := ts.Host
+	if host == "" {
+		host = DefaultDoubaoHost
+	}
+
+	refreshURL := fmt.Sprintf("%s/cloudide/api/v3/trae/oauth/ExchangeToken", strings.TrimRight(host, "/"))
+
+	reqBody, _ := json.Marshal(map[string]string{
+		"ClientID":     DefaultClientID,
+		"RefreshToken": ts.RefreshToken,
+		"ClientSecret": "-",
+		"UserID":       ts.UserID,
+	})
+
+	req, errReq := http.NewRequestWithContext(ctx, http.MethodPost, refreshURL, strings.NewReader(string(reqBody)))
+	if errReq != nil {
+		return fmt.Errorf("failed to create refresh request: %w", errReq)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set("User-Agent", "Doubao/1.0.0")
+
+	client := &http.Client{Timeout: 15 * time.Second}
+	resp, errDo := client.Do(req)
+	if errDo != nil {
+		return fmt.Errorf("refresh request failed: %w", errDo)
+	}
+	defer func() {
+		if errClose := resp.Body.Close(); errClose != nil {
+			log.Errorf("failed to close response body: %v", errClose)
+		}
+	}()
+
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return fmt.Errorf("refresh returned status %d", resp.StatusCode)
+	}
+
+	var result struct {
+		ResponseMetadata struct {
+			Error struct {
+				Code    string `json:"Code"`
+				Message string `json:"Message"`
+			} `json:"Error"`
+		} `json:"ResponseMetadata"`
+		Result struct {
+			Token         string `json:"Token"`
+			RefreshToken  string `json:"RefreshToken"`
+			TokenExpireAt int64  `json:"TokenExpireAt"`
+		} `json:"Result"`
+		Data struct {
+			Token        string `json:"token"`
+			RefreshToken string `json:"refreshToken"`
+			ExpiredAt    string `json:"expiredAt"`
+		} `json:"data"`
+	}
+
+	if errDecode := json.NewDecoder(resp.Body).Decode(&result); errDecode != nil {
+		return fmt.Errorf("failed to decode refresh response: %w", errDecode)
+	}
+
+	if result.Result.Token != "" {
+		ts.AccessToken = result.Result.Token
+		if result.Result.RefreshToken != "" {
+			ts.RefreshToken = result.Result.RefreshToken
+		}
+		if result.Result.TokenExpireAt > 0 {
+			sec := result.Result.TokenExpireAt
+			if sec > 1e11 {
+				sec /= 1000
+			}
+			ts.ExpiresAt = sec
+			ts.Expired = time.Unix(sec, 0).Format(time.RFC3339)
+		}
+		return nil
+	}
+
+	if result.Data.Token != "" {
+		ts.AccessToken = result.Data.Token
+		if result.Data.RefreshToken != "" {
+			ts.RefreshToken = result.Data.RefreshToken
+		}
+		if result.Data.ExpiredAt != "" {
+			ts.Expired = result.Data.ExpiredAt
+		}
+		return nil
+	}
+
+	if result.ResponseMetadata.Error.Message != "" {
+		return fmt.Errorf("refresh failed: %s (code %s)", result.ResponseMetadata.Error.Message, result.ResponseMetadata.Error.Code)
+	}
+
+	return nil
+}
+
+// DoubaoAuth handles authentication for ByteDance Doubao / Volcano Engine Ark.
+type DoubaoAuth struct {
+	cfg        *config.Config
+	httpClient *http.Client
+}
+
+// NewDoubaoAuth constructs a new Doubao authentication handler.
+func NewDoubaoAuth(cfg *config.Config) *DoubaoAuth {
+	return &DoubaoAuth{
+		cfg: cfg,
+		httpClient: &http.Client{
+			Timeout: 20 * time.Second,
+		},
+	}
+}
+
+// VerifyAPIKey verifies that the provided Volcano Engine Ark / Doubao API Key is valid.
+func (a *DoubaoAuth) VerifyAPIKey(ctx context.Context, apiKey string, baseURL string) (*DoubaoTokenData, error) {
+	apiKey = strings.TrimSpace(apiKey)
+	if apiKey == "" {
+		return nil, fmt.Errorf("doubao: API key cannot be empty")
+	}
+	if baseURL == "" {
+		baseURL = DefaultArkEndpoint
+	}
+	baseURL = strings.TrimRight(baseURL, "/")
+
+	modelsURL := baseURL + "/models"
+	req, errReq := http.NewRequestWithContext(ctx, http.MethodGet, modelsURL, nil)
+	if errReq != nil {
+		return nil, errReq
+	}
+	req.Header.Set("Authorization", "Bearer "+apiKey)
+	req.Header.Set("Accept", "application/json")
+
+	resp, errDo := a.httpClient.Do(req)
+	if errDo != nil {
+		log.Warnf("doubao: failed to contact models endpoint %s: %v, assuming key is valid", modelsURL, errDo)
+		return &DoubaoTokenData{
+			AccessToken: apiKey,
+			TokenType:   "Bearer",
+			BaseURL:     baseURL,
+		}, nil
+	}
+	defer func() {
+		if errClose := resp.Body.Close(); errClose != nil {
+			log.Errorf("doubao verify: close body error: %v", errClose)
+		}
+	}()
+
+	if resp.StatusCode == http.StatusUnauthorized || resp.StatusCode == http.StatusForbidden {
+		bodyBytes, _ := io.ReadAll(resp.Body)
+		return nil, fmt.Errorf("doubao: invalid API key (HTTP %d): %s", resp.StatusCode, string(bodyBytes))
+	}
+
+	return &DoubaoTokenData{
+		AccessToken: apiKey,
+		TokenType:   "Bearer",
+		BaseURL:     baseURL,
+	}, nil
+}
+
+// ImportLocalConfig attempts to locate Doubao / Ark credentials from well-known paths or env.
+func (a *DoubaoAuth) ImportLocalConfig() (*DoubaoTokenStorage, error) {
+	// 1. Try importing MarsCode/Doubao OAuth session first
+	authDir := "auths"
+	if a.cfg != nil && a.cfg.AuthDir != "" {
+		authDir = a.cfg.AuthDir
+	}
+	if storage, errImport := ImportLocalDoubaoCredentials(authDir); errImport == nil && storage != nil && storage.AccessToken != "" {
+		return storage, nil
+	}
+
+	// 2. Check environment variables
+	for _, envKey := range []string{"DOUBAO_TOKEN", "DOUBAO_API_KEY", "ARK_API_KEY", "VOLC_API_KEY"} {
+		if val := strings.TrimSpace(os.Getenv(envKey)); val != "" {
+			baseURL := strings.TrimSpace(os.Getenv("DOUBAO_BASE_URL"))
+			if baseURL == "" {
+				baseURL = DefaultArkEndpoint
+			}
+			return &DoubaoTokenStorage{
+				AccessToken: val,
+				TokenType:   "Bearer",
+				BaseURL:     baseURL,
+				Type:        "doubao",
+				Provider:    "doubao",
+			}, nil
+		}
+	}
+
+	home, errHome := os.UserHomeDir()
+	if errHome != nil {
+		return nil, fmt.Errorf("failed to get user home dir: %w", errHome)
+	}
+
+	candidates := []string{
+		filepath.Join(home, ".doubao", "config.json"),
+		filepath.Join(home, ".marscode", "config.json"),
+	}
+
+	for _, p := range candidates {
+		data, errRead := os.ReadFile(p)
+		if errRead != nil {
+			continue
+		}
+		apiKey := strings.TrimSpace(string(data))
+		if apiKey != "" {
+			return &DoubaoTokenStorage{
+				AccessToken: apiKey,
+				TokenType:   "Bearer",
+				BaseURL:     DefaultArkEndpoint,
+				Type:        "doubao",
+				Provider:    "doubao",
+			}, nil
+		}
+	}
+
+	return nil, fmt.Errorf("no local Doubao configuration found in ~/.doubao/ or ~/.marscode/")
+}
+
+// SaveCredentials saves the Doubao token storage to the configured auth directory.
+func (a *DoubaoAuth) SaveCredentials(storage *DoubaoTokenStorage) (string, error) {
+	authDir := a.cfg.AuthDir
+	if authDir == "" {
+		authDir = "auths"
+	}
+	fileName := fmt.Sprintf("doubao-%d.json", time.Now().UnixMilli())
+	authPath := filepath.Join(authDir, fileName)
+
+	if errSave := storage.SaveTokenToFile(authPath); errSave != nil {
+		return "", fmt.Errorf("failed to save credentials: %w", errSave)
+	}
+	misc.LogSavingCredentials(authPath)
+	return authPath, nil
+}
