index 00000000..7e38f64a
--- /dev/null
+++ b/internal/auth/workbuddy/workbuddy.go
@@ -0,0 +1,496 @@
+// Package workbuddy provides authentication and token management for Tencent WorkBuddy (CodeBuddy) API.
+// It handles OAuth device flow, token refresh, quota retrieval, and local desktop import.
+package workbuddy
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/util"
+	log "github.com/sirupsen/logrus"
+	"golang.org/x/sync/singleflight"
+)
+
+const (
+	// WorkBuddyBaseURL is the upstream base URL for Tencent WorkBuddy / CodeBuddy APIs.
+	WorkBuddyBaseURL = "https://copilot.tencent.com"
+	// WorkBuddyOriginReferer is the origin and referer header expected by Tencent upstream.
+	WorkBuddyOriginReferer = "https://www.codebuddy.cn"
+	// WorkBuddyClientUA is the official CLI user agent string.
+	WorkBuddyClientUA = "CLI/2.161.0 CodeBuddy/2.161.0"
+
+	// WorkBuddyAuthStateURL starts device authorization and gets the login URL.
+	WorkBuddyAuthStateURL = WorkBuddyBaseURL + "/v2/plugin/auth/state?platform=CLI"
+	// WorkBuddyAuthTokenURL is polled for the access and refresh tokens using state.
+	WorkBuddyAuthTokenURL = WorkBuddyBaseURL + "/v2/plugin/auth/token?state="
+	// WorkBuddyAccountURL retrieves account profile info (uid, nickname, enterpriseId).
+	WorkBuddyAccountURL = WorkBuddyBaseURL + "/v2/plugin/login/account?state="
+	// WorkBuddyRefreshURL refreshes the access token.
+	WorkBuddyRefreshURL = WorkBuddyBaseURL + "/v2/plugin/auth/token/refresh"
+	// WorkBuddyModelsURL retrieves model list and capabilities.
+	WorkBuddyModelsURL = WorkBuddyBaseURL + "/console/enterprises/personal/models"
+	// WorkBuddyResourceURL retrieves user credits and resource package summary.
+	WorkBuddyResourceURL = WorkBuddyBaseURL + "/billing/meter/get-user-resource-summary"
+
+	defaultPollInterval = 2 * time.Second
+	maxPollDuration     = 5 * time.Minute
+)
+
+var workbuddyRefreshGroup singleflight.Group
+
+// WorkBuddyAuthSession holds state for an active device flow session.
+type WorkBuddyAuthSession struct {
+	State     string `json:"state"`
+	AuthURL   string `json:"authUrl"`
+	ExpiresIn int64  `json:"expiresIn"`
+}
+
+// WorkBuddyTokenData contains normalized credentials for a WorkBuddy account.
+type WorkBuddyTokenData struct {
+	AccessToken  string `json:"accessToken"`
+	RefreshToken string `json:"refreshToken"`
+	ExpiresIn    int64  `json:"expiresIn"`
+	ExpiresAt    int64  `json:"expiresAt"`
+	Domain       string `json:"domain"`
+	UID          string `json:"uid"`
+	EnterpriseID string `json:"enterpriseId"`
+	Nickname     string `json:"nickname"`
+}
+
+// WorkBuddyAuthBundle bundles token data for storage and client initialization.
+type WorkBuddyAuthBundle struct {
+	TokenData *WorkBuddyTokenData `json:"tokenData"`
+}
+
+// WorkBuddyQuota represents user credit balance and package information.
+type WorkBuddyQuota struct {
+	TotalCredits  float64              `json:"totalCredits"`
+	RemainCredits float64              `json:"remainCredits"`
+	UsedCredits   float64              `json:"usedCredits"`
+	Packages      []WorkBuddyQuotaPack `json:"packages"`
+}
+
+// WorkBuddyQuotaPack represents an individual quota package.
+type WorkBuddyQuotaPack struct {
+	PackageCode    string  `json:"packageCode"`
+	TotalCapacity  float64 `json:"totalCapacity"`
+	RemainCapacity float64 `json:"remainCapacity"`
+	UsedCapacity   float64 `json:"usedCapacity"`
+	Unit           string  `json:"unit"`
+}
+
+type apiEnvelope struct {
+	Code      int             `json:"code"`
+	Msg       string          `json:"msg"`
+	RequestID string          `json:"requestId"`
+	Data      json.RawMessage `json:"data"`
+}
+
+// WorkBuddyAuth manages authentication and communication with Tencent WorkBuddy services.
+type WorkBuddyAuth struct {
+	client *http.Client
+	cfg    *config.Config
+}
+
+// NewWorkBuddyAuth creates a new WorkBuddyAuth service instance.
+func NewWorkBuddyAuth(cfg *config.Config) *WorkBuddyAuth {
+	httpClient := &http.Client{
+		Timeout: 30 * time.Second,
+	}
+	if cfg != nil {
+		sdkCfg := cfg.SDKConfig
+		httpClient = util.SetProxy(&sdkCfg, httpClient)
+	}
+	return &WorkBuddyAuth{
+		client: httpClient,
+		cfg:    cfg,
+	}
+}
+
+func (w *WorkBuddyAuth) setCommonHeaders(req *http.Request) {
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Accept", "application/json, text/plain, */*")
+	req.Header.Set("X-Requested-With", "XMLHttpRequest")
+	req.Header.Set("Origin", WorkBuddyOriginReferer)
+	req.Header.Set("Referer", WorkBuddyOriginReferer+"/")
+	req.Header.Set("User-Agent", WorkBuddyClientUA)
+}
+
+func (w *WorkBuddyAuth) doJSON(ctx context.Context, method, fullURL string, headers func(*http.Request), body io.Reader) (json.RawMessage, int, error) {
+	req, err := http.NewRequestWithContext(ctx, method, fullURL, body)
+	if err != nil {
+		return nil, 0, err
+	}
+	w.setCommonHeaders(req)
+	if headers != nil {
+		headers(req)
+	}
+
+	resp, err := w.client.Do(req)
+	if err != nil {
+		return nil, 0, err
+	}
+	defer func() {
+		if errClose := resp.Body.Close(); errClose != nil {
+			log.Errorf("workbuddy: failed to close response body: %v", errClose)
+		}
+	}()
+
+	raw, errRead := io.ReadAll(resp.Body)
+	if errRead != nil {
+		return nil, resp.StatusCode, fmt.Errorf("workbuddy read error: %w", errRead)
+	}
+
+	if resp.StatusCode >= 400 {
+		return nil, resp.StatusCode, fmt.Errorf("http error %d: %s", resp.StatusCode, string(raw))
+	}
+
+	var env apiEnvelope
+	if errUnmarshal := json.Unmarshal(raw, &env); errUnmarshal != nil {
+		return nil, resp.StatusCode, fmt.Errorf("workbuddy json parse failed: %w", errUnmarshal)
+	}
+	if env.Code != 0 {
+		return nil, resp.StatusCode, fmt.Errorf("workbuddy api error: code=%d msg=%s", env.Code, env.Msg)
+	}
+
+	return env.Data, resp.StatusCode, nil
+}
+
+// RequestState starts the OAuth flow and returns the authorization URL.
+func (w *WorkBuddyAuth) RequestState(ctx context.Context) (*WorkBuddyAuthSession, error) {
+	data, _, err := w.doJSON(ctx, http.MethodPost, WorkBuddyAuthStateURL, nil, bytes.NewReader([]byte("{}")))
+	if err != nil {
+		return nil, fmt.Errorf("workbuddy: failed to start auth state: %w", err)
+	}
+
+	var st struct {
+		State   string `json:"state"`
+		AuthURL string `json:"authUrl"`
+	}
+	if errUnmarshal := json.Unmarshal(data, &st); errUnmarshal != nil {
+		return nil, fmt.Errorf("workbuddy: failed to parse auth state response: %w", errUnmarshal)
+	}
+	if st.State == "" || st.AuthURL == "" {
+		return nil, fmt.Errorf("workbuddy: empty state or authUrl from upstream")
+	}
+
+	return &WorkBuddyAuthSession{
+		State:     st.State,
+		AuthURL:   st.AuthURL,
+		ExpiresIn: 600,
+	}, nil
+}
+
+// PollForToken checks whether the user has authorized the device session.
+func (w *WorkBuddyAuth) PollForToken(ctx context.Context, state string) (*WorkBuddyTokenData, error) {
+	tokenURL := WorkBuddyAuthTokenURL + state
+	tokRaw, status, errTok := w.doJSON(ctx, http.MethodGet, tokenURL, nil, nil)
+	if errTok != nil {
+		if status == 0 || status >= 500 {
+			return nil, fmt.Errorf("workbuddy: token endpoint error: %w", errTok)
+		}
+		// Code 11217 indicates pending login
+		return nil, fmt.Errorf("waiting for login")
+	}
+
+	var tok struct {
+		AccessToken  string `json:"accessToken"`
+		RefreshToken string `json:"refreshToken"`
+		ExpiresIn    int64  `json:"expiresIn"`
+		Domain       string `json:"domain"`
+	}
+	if errUnmarshal := json.Unmarshal(tokRaw, &tok); errUnmarshal != nil || tok.AccessToken == "" {
+		return nil, fmt.Errorf("waiting for login")
+	}
+
+	// Fetch account details
+	var acct struct {
+		UID          string `json:"uid"`
+		EnterpriseID string `json:"enterpriseId"`
+		Nickname     string `json:"nickname"`
+	}
+	acctHeaders := func(r *http.Request) {
+		r.Header.Set("Authorization", "Bearer "+tok.AccessToken)
+	}
+	if acctRaw, _, errAcct := w.doJSON(ctx, http.MethodGet, WorkBuddyAccountURL+state, acctHeaders, nil); errAcct == nil {
+		_ = json.Unmarshal(acctRaw, &acct)
+	}
+
+	expiresIn := tok.ExpiresIn
+	if expiresIn <= 0 {
+		expiresIn = 2592000 // default 30 days
+	}
+
+	return &WorkBuddyTokenData{
+		AccessToken:  tok.AccessToken,
+		RefreshToken: tok.RefreshToken,
+		ExpiresIn:    expiresIn,
+		ExpiresAt:    time.Now().Unix() + expiresIn,
+		Domain:       tok.Domain,
+		UID:          acct.UID,
+		EnterpriseID: acct.EnterpriseID,
+		Nickname:     acct.Nickname,
+	}, nil
+}
+
+// WaitForAuthorization polls token endpoint until completion or timeout.
+func (w *WorkBuddyAuth) WaitForAuthorization(ctx context.Context, session *WorkBuddyAuthSession) (*WorkBuddyAuthBundle, error) {
+	if session == nil || session.State == "" {
+		return nil, fmt.Errorf("workbuddy: invalid session")
+	}
+
+	pollCtx, cancel := context.WithTimeout(ctx, maxPollDuration)
+	defer cancel()
+
+	ticker := time.NewTicker(defaultPollInterval)
+	defer ticker.Stop()
+
+	for {
+		select {
+		case <-pollCtx.Done():
+			return nil, fmt.Errorf("workbuddy: authorization timed out: %w", pollCtx.Err())
+		case <-ticker.C:
+			tokenData, err := w.PollForToken(pollCtx, session.State)
+			if err == nil && tokenData != nil && tokenData.AccessToken != "" {
+				return &WorkBuddyAuthBundle{TokenData: tokenData}, nil
+			}
+		}
+	}
+}
+
+// RefreshToken refreshes an expired access token using the refresh token.
+func (w *WorkBuddyAuth) RefreshToken(ctx context.Context, refreshToken string) (*WorkBuddyTokenData, error) {
+	refreshToken = strings.TrimSpace(refreshToken)
+	if refreshToken == "" {
+		return nil, fmt.Errorf("workbuddy: refresh token is empty")
+	}
+
+	res, err, _ := workbuddyRefreshGroup.Do(refreshToken, func() (any, error) {
+		req, errReq := http.NewRequestWithContext(ctx, http.MethodPost, WorkBuddyRefreshURL, bytes.NewReader([]byte("{}")))
+		if errReq != nil {
+			return nil, errReq
+		}
+		w.setCommonHeaders(req)
+		req.Header.Set("X-Refresh-Token", refreshToken)
+		req.Header.Set("X-Auth-Refresh-Source", "plugin")
+
+		resp, errDo := w.client.Do(req)
+		if errDo != nil {
+			return nil, errDo
+		}
+		defer func() {
+			if errClose := resp.Body.Close(); errClose != nil {
+				log.Errorf("workbuddy: failed to close refresh response body: %v", errClose)
+			}
+		}()
+
+		raw, errRead := io.ReadAll(resp.Body)
+		if errRead != nil {
+			return nil, errRead
+		}
+		if resp.StatusCode != http.StatusOK {
+			return nil, fmt.Errorf("refresh http error %d: %s", resp.StatusCode, string(raw))
+		}
+
+		var env apiEnvelope
+		if errUnmarshal := json.Unmarshal(raw, &env); errUnmarshal != nil {
+			return nil, errUnmarshal
+		}
+		if env.Code != 0 {
+			return nil, fmt.Errorf("refresh api error code=%d: %s", env.Code, env.Msg)
+		}
+
+		var tok struct {
+			AccessToken  string `json:"accessToken"`
+			RefreshToken string `json:"refreshToken"`
+			ExpiresIn    int64  `json:"expiresIn"`
+			Domain       string `json:"domain"`
+		}
+		if errUnmarshal := json.Unmarshal(env.Data, &tok); errUnmarshal != nil {
+			return nil, errUnmarshal
+		}
+		if tok.AccessToken == "" {
+			return nil, fmt.Errorf("refresh returned empty access token")
+		}
+
+		newRefreshToken := tok.RefreshToken
+		if newRefreshToken == "" {
+			newRefreshToken = refreshToken
+		}
+		expiresIn := tok.ExpiresIn
+		if expiresIn <= 0 {
+			expiresIn = 2592000
+		}
+
+		return &WorkBuddyTokenData{
+			AccessToken:  tok.AccessToken,
+			RefreshToken: newRefreshToken,
+			ExpiresIn:    expiresIn,
+			ExpiresAt:    time.Now().Unix() + expiresIn,
+			Domain:       tok.Domain,
+		}, nil
+	})
+
+	if err != nil {
+		return nil, err
+	}
+	return res.(*WorkBuddyTokenData), nil
+}
+
+// GetQuota retrieves resource package capacities and remaining credits.
+func (w *WorkBuddyAuth) GetQuota(ctx context.Context, accessToken, uid string) (*WorkBuddyQuota, error) {
+	accessToken = strings.TrimSpace(accessToken)
+	if accessToken == "" {
+		return nil, fmt.Errorf("workbuddy: accessToken is empty")
+	}
+
+	headers := func(r *http.Request) {
+		r.Header.Set("Authorization", "Bearer "+accessToken)
+		if uid != "" {
+			r.Header.Set("X-User-Id", uid)
+		}
+		r.Header.Set("X-Product", "SaaS")
+	}
+
+	data, _, err := w.doJSON(ctx, http.MethodPost, WorkBuddyResourceURL, headers, bytes.NewReader([]byte("{}")))
+	if err != nil {
+		return nil, fmt.Errorf("workbuddy: failed to fetch resource summary: %w", err)
+	}
+
+	var summary struct {
+		Packages []struct {
+			PackageCode         string `json:"PackageCode"`
+			CycleTotalCapacity  string `json:"CycleTotalCapacity"`
+			CycleRemainCapacity string `json:"CycleRemainCapacity"`
+			CycleUsedCapacity   string `json:"CycleUsedCapacity"`
+			CapacityUnit        string `json:"CapacityUnit"`
+		} `json:"Packages"`
+	}
+
+	if errUnmarshal := json.Unmarshal(data, &summary); errUnmarshal != nil {
+		return nil, fmt.Errorf("workbuddy: failed to parse resource summary: %w", errUnmarshal)
+	}
+
+	quota := &WorkBuddyQuota{
+		Packages: make([]WorkBuddyQuotaPack, 0, len(summary.Packages)),
+	}
+
+	for _, p := range summary.Packages {
+		total, _ := strconv.ParseFloat(p.CycleTotalCapacity, 64)
+		remain, _ := strconv.ParseFloat(p.CycleRemainCapacity, 64)
+		used, _ := strconv.ParseFloat(p.CycleUsedCapacity, 64)
+
+		quota.TotalCredits += total
+		quota.RemainCredits += remain
+		quota.UsedCredits += used
+
+		quota.Packages = append(quota.Packages, WorkBuddyQuotaPack{
+			PackageCode:    p.PackageCode,
+			TotalCapacity:  total,
+			RemainCapacity: remain,
+			UsedCapacity:   used,
+			Unit:           p.CapacityUnit,
+		})
+	}
+
+	return quota, nil
+}
+
+// ImportLocalAuth checks local WorkBuddy desktop credential storage and extracts auth details.
+func ImportLocalAuth() (*WorkBuddyTokenData, error) {
+	if runtime.GOOS != "darwin" && runtime.GOOS != "windows" && runtime.GOOS != "linux" {
+		return nil, fmt.Errorf("local import not supported on %s", runtime.GOOS)
+	}
+
+	homeDir, errHome := os.UserHomeDir()
+	if errHome != nil {
+		return nil, fmt.Errorf("failed to get user home directory: %w", errHome)
+	}
+
+	var candidates []string
+	if runtime.GOOS == "darwin" {
+		candidates = []string{
+			filepath.Join(homeDir, "Library", "Application Support", "CodeBuddyExtension", "Data", "Public", "auth", "workbuddy-desktop.info"),
+			filepath.Join(homeDir, "Library", "Application Support", "WorkBuddyExtension", "Data", "Public", "auth", "workbuddy-desktop.info"),
+		}
+	} else if runtime.GOOS == "windows" {
+		appData := os.Getenv("APPDATA")
+		if appData != "" {
+			candidates = []string{
+				filepath.Join(appData, "CodeBuddyExtension", "Data", "Public", "auth", "workbuddy-desktop.info"),
+				filepath.Join(appData, "WorkBuddyExtension", "Data", "Public", "auth", "workbuddy-desktop.info"),
+			}
+		}
+	} else {
+		candidates = []string{
+			filepath.Join(homeDir, ".config", "CodeBuddyExtension", "Data", "Public", "auth", "workbuddy-desktop.info"),
+		}
+	}
+
+	var raw []byte
+	var foundPath string
+	for _, p := range candidates {
+		if content, err := os.ReadFile(p); err == nil && len(content) > 0 {
+			raw = content
+			foundPath = p
+			break
+		}
+	}
+
+	if len(raw) == 0 {
+		return nil, fmt.Errorf("local workbuddy desktop credentials not found")
+	}
+
+	var doc struct {
+		Auth struct {
+			AccessToken  string `json:"accessToken"`
+			RefreshToken string `json:"refreshToken"`
+			ExpiresAt    int64  `json:"expiresAt"`
+			ExpiresIn    int64  `json:"expiresIn"`
+			Domain       string `json:"domain"`
+		} `json:"auth"`
+		Account struct {
+			UID          string `json:"uid"`
+			EnterpriseID string `json:"enterpriseId"`
+			Nickname     string `json:"nickname"`
+		} `json:"account"`
+	}
+
+	if err := json.Unmarshal(raw, &doc); err != nil {
+		return nil, fmt.Errorf("failed to parse %s: %w", foundPath, err)
+	}
+
+	if strings.TrimSpace(doc.Auth.AccessToken) == "" {
+		return nil, fmt.Errorf("no accessToken found in %s", foundPath)
+	}
+
+	expiresAt := doc.Auth.ExpiresAt
+	if expiresAt <= 0 && doc.Auth.ExpiresIn > 0 {
+		expiresAt = time.Now().Unix() + doc.Auth.ExpiresIn
+	}
+	if expiresAt <= 0 {
+		expiresAt = time.Now().Unix() + 2592000
+	}
+
+	return &WorkBuddyTokenData{
+		AccessToken:  doc.Auth.AccessToken,
+		RefreshToken: doc.Auth.RefreshToken,
+		ExpiresIn:    doc.Auth.ExpiresIn,
+		ExpiresAt:    expiresAt,
+		Domain:       doc.Auth.Domain,
+		UID:          doc.Account.UID,
+		EnterpriseID: doc.Account.EnterpriseID,
+		Nickname:     doc.Account.Nickname,
+	}, nil
+}
