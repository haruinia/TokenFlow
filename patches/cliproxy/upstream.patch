@@ -0,0 +1,134 @@
+package executor
+
+import (
+	"context"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+)
+
+func TestWorkBuddyExecutorIdentifierAndFormat(t *testing.T) {
+	cfg := &config.Config{}
+	exec := NewWorkBuddyExecutor(cfg)
+
+	if id := exec.Identifier(); id != "workbuddy" {
+		t.Fatalf("Identifier() = %q, want %q", id, "workbuddy")
+	}
+
+	req := cliproxyexecutor.Request{}
+	opts := cliproxyexecutor.Options{}
+	if fmt := exec.RequestToFormat(req, opts); fmt != sdktranslator.FormatOpenAI {
+		t.Fatalf("RequestToFormat() = %v, want %v", fmt, sdktranslator.FormatOpenAI)
+	}
+
+	optsCompact := cliproxyexecutor.Options{Alt: "responses/compact"}
+	if fmt := exec.RequestToFormat(req, optsCompact); fmt != sdktranslator.FormatOpenAIResponse {
+		t.Fatalf("RequestToFormat() compact = %v, want %v", fmt, sdktranslator.FormatOpenAIResponse)
+	}
+}
+
+func TestWorkBuddyExecutorStreamAndExecute(t *testing.T) {
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Header.Get("Authorization") != "Bearer test-wb-token" {
+			w.WriteHeader(http.StatusUnauthorized)
+			_, _ = w.Write([]byte(`{"error":"unauthorized"}`))
+			return
+		}
+		if r.Header.Get("X-User-Id") != "wb-uid-123" {
+			w.WriteHeader(http.StatusBadRequest)
+			_, _ = w.Write([]byte(`{"error":"missing user id"}`))
+			return
+		}
+		if r.Header.Get("X-Product") != "SaaS" {
+			w.WriteHeader(http.StatusBadRequest)
+			_, _ = w.Write([]byte(`{"error":"missing product header"}`))
+			return
+		}
+
+		w.Header().Set("Content-Type", "text/event-stream")
+		w.WriteHeader(http.StatusOK)
+
+		chunk1 := `data: {"id":"chatcmpl-wb1","model":"hy4-preview","choices":[{"delta":{"role":"assistant","content":"1+1=2"},"index":0}]}` + "\n\n"
+		chunk2 := `data: {"id":"chatcmpl-wb1","model":"hy4-preview","choices":[{"delta":{"content":"!"},"finish_reason":"stop","index":0}],"usage":{"prompt_tokens":5,"completion_tokens":5}}` + "\n\n"
+		chunk3 := `data: [DONE]` + "\n\n"
+
+		_, _ = w.Write([]byte(chunk1))
+		_, _ = w.Write([]byte(chunk2))
+		_, _ = w.Write([]byte(chunk3))
+	}))
+	defer ts.Close()
+
+	cfg := &config.Config{}
+	exec := NewWorkBuddyExecutor(cfg)
+
+	auth := &cliproxyauth.Auth{
+		Provider: "workbuddy",
+		Metadata: map[string]any{
+			"access_token": "test-wb-token",
+			"uid":          "wb-uid-123",
+		},
+		Attributes: map[string]string{
+			"chat_url": ts.URL,
+		},
+	}
+
+	req := cliproxyexecutor.Request{
+		Model:   "hy4-preview",
+		Payload: []byte(`{"model":"hy4-preview","messages":[{"role":"user","content":"1+1"}]}`),
+	}
+
+	// 1. Test Execute (non-streaming aggregation)
+	resp, errExec := exec.Execute(context.Background(), auth, req, cliproxyexecutor.Options{})
+	if errExec != nil {
+		t.Fatalf("Execute() unexpected error: %v", errExec)
+	}
+	if len(resp.Payload) == 0 {
+		t.Fatalf("Execute() returned empty payload")
+	}
+
+	expectedContent := "1+1=2!"
+	if !containsSubstring(string(resp.Payload), expectedContent) {
+		t.Fatalf("Execute() payload %s does not contain %s", string(resp.Payload), expectedContent)
+	}
+
+	// 2. Test ExecuteStream (streaming chunks)
+	streamRes, errStream := exec.ExecuteStream(context.Background(), auth, req, cliproxyexecutor.Options{Stream: true})
+	if errStream != nil {
+		t.Fatalf("ExecuteStream() unexpected error: %v", errStream)
+	}
+
+	var chunks []string
+	for chunk := range streamRes.Chunks {
+		if chunk.Err != nil {
+			t.Fatalf("chunk error: %v", chunk.Err)
+		}
+		chunks = append(chunks, string(chunk.Payload))
+	}
+
+	if len(chunks) < 2 {
+		t.Fatalf("ExecuteStream() expected at least 2 chunks, got %d", len(chunks))
+	}
+}
+
+func containsSubstring(s, sub string) bool {
+	return len(s) >= len(sub) && (s == sub || stringContains(s, sub))
+}
+
+func stringContains(s, sub string) bool {
+	return fmt.Sprintf("%v", s) != "" && (len(sub) == 0 || (len(s) >= len(sub) && searchSubstring(s, sub)))
+}
+
+func searchSubstring(s, sub string) bool {
+	for i := 0; i+len(sub) <= len(s); i++ {
+		if s[i:i+len(sub)] == sub {
+			return true
+		}
+	}
+	return false
+}
