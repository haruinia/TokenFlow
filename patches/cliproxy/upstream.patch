index 00000000..7a31e33a
--- /dev/null
+++ b/internal/runtime/executor/trae_executor.go
@@ -0,0 +1,338 @@
+package executor
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/auth/trae"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/runtime/executor/helps"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+	log "github.com/sirupsen/logrus"
+	"github.com/tidwall/gjson"
+)
+
+// TraeExecutor implements the executor for ByteDance Trae and MarsCode AI developer services.
+type TraeExecutor struct {
+	*OpenAICompatExecutor
+	cfg *config.Config
+}
+
+// NewTraeExecutor constructs a new Trae executor instance.
+func NewTraeExecutor(cfg *config.Config) *TraeExecutor {
+	return &TraeExecutor{
+		OpenAICompatExecutor: NewOpenAICompatExecutor("trae", cfg),
+		cfg:                  cfg,
+	}
+}
+
+// Identifier returns the provider identifier "trae".
+func (e *TraeExecutor) Identifier() string {
+	return "trae"
+}
+
+// RequestToFormat reports the format expected by the Trae upstream API.
+func (e *TraeExecutor) RequestToFormat(req cliproxyexecutor.Request, opts cliproxyexecutor.Options) sdktranslator.Format {
+	if opts.Alt == "responses/compact" && !opts.Stream {
+		return sdktranslator.FormatOpenAIResponse
+	}
+	return sdktranslator.FormatOpenAI
+}
+
+// PrepareRequest injects Trae credentials and headers into the outgoing HTTP request.
+func (e *TraeExecutor) PrepareRequest(req *http.Request, auth *cliproxyauth.Auth) error {
+	adaptedAuth := e.adaptAuth(auth)
+	return e.OpenAICompatExecutor.PrepareRequest(req, adaptedAuth)
+}
+
+// HttpRequest prepares and sends an HTTP request using Trae credentials.
+func (e *TraeExecutor) HttpRequest(ctx context.Context, auth *cliproxyauth.Auth, req *http.Request) (*http.Response, error) {
+	adaptedAuth := e.adaptAuth(auth)
+	return e.OpenAICompatExecutor.HttpRequest(ctx, adaptedAuth, req)
+}
+
+// Execute performs a non-streaming chat completion request to Trae.
+func (e *TraeExecutor) Execute(ctx context.Context, auth *cliproxyauth.Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	streamResult, errStream := e.ExecuteStream(ctx, auth, req, opts)
+	if errStream != nil {
+		return cliproxyexecutor.Response{}, errStream
+	}
+
+	var contentBuilder, reasoningContentBuilder strings.Builder
+	var lastID, lastModel string
+	var created int64
+	finishReason := "stop"
+	var promptTokens, completionTokens int64
+
+	for chunk := range streamResult.Chunks {
+		if chunk.Err != nil {
+			return cliproxyexecutor.Response{}, chunk.Err
+		}
+		payload := strings.TrimSpace(string(chunk.Payload))
+		data := strings.TrimSpace(strings.TrimPrefix(payload, "data:"))
+		if data == "" {
+			continue
+		}
+		if data == "[DONE]" {
+			break
+		}
+		gj := gjson.Parse(data)
+		if id := gj.Get("id").String(); id != "" {
+			lastID = id
+		}
+		if m := gj.Get("model").String(); m != "" {
+			lastModel = m
+		}
+		if c := gj.Get("created").Int(); c > 0 {
+			created = c
+		}
+		if content := gj.Get("choices.0.delta.content").String(); content != "" {
+			contentBuilder.WriteString(content)
+		}
+		if rc := helps.ExtractReasoningFromChunk(data); rc != "" {
+			reasoningContentBuilder.WriteString(rc)
+		}
+		if fr := gj.Get("choices.0.finish_reason").String(); fr != "" {
+			finishReason = fr
+		}
+		if pt := gj.Get("usage.prompt_tokens").Int(); pt > 0 {
+			promptTokens = pt
+		}
+		if ct := gj.Get("usage.completion_tokens").Int(); ct > 0 {
+			completionTokens = ct
+		}
+	}
+
+	if lastID == "" {
+		lastID = "chatcmpl-" + uuid.NewString()
+	}
+	if lastModel == "" {
+		lastModel = helps.NormalizeTraeModel(req.Model)
+	}
+	if created == 0 {
+		created = time.Now().Unix()
+	}
+
+	msgMap := map[string]any{
+		"role":    "assistant",
+		"content": contentBuilder.String(),
+	}
+	if reasoningContentBuilder.Len() > 0 {
+		msgMap["reasoning_content"] = reasoningContentBuilder.String()
+	}
+
+	respMap := map[string]any{
+		"id":      lastID,
+		"object":  "chat.completion",
+		"created": created,
+		"model":   lastModel,
+		"choices": []map[string]any{
+			{
+				"index":         0,
+				"message":       msgMap,
+				"finish_reason": finishReason,
+			},
+		},
+		"usage": map[string]any{
+			"prompt_tokens":     promptTokens,
+			"completion_tokens": completionTokens,
+			"total_tokens":      promptTokens + completionTokens,
+		},
+	}
+	respBytes, errMarshal := json.Marshal(respMap)
+	if errMarshal != nil {
+		return cliproxyexecutor.Response{}, errMarshal
+	}
+	return cliproxyexecutor.Response{
+		Payload: respBytes,
+		Headers: streamResult.Headers,
+	}, nil
+}
+
+// ExecuteStream performs a streaming chat completion request to Trae.
+func (e *TraeExecutor) ExecuteStream(ctx context.Context, auth *cliproxyauth.Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (*cliproxyexecutor.StreamResult, error) {
+	var apiKey, baseURL string
+	if auth != nil && auth.Metadata != nil {
+		apiKey, _ = auth.Metadata["access_token"].(string)
+		baseURL, _ = auth.Metadata["base_url"].(string)
+	}
+	if apiKey == "" && auth != nil && auth.Attributes != nil {
+		apiKey = auth.Attributes["api_key"]
+		if baseURL == "" {
+			baseURL = auth.Attributes["base_url"]
+		}
+	}
+	if apiKey == "" {
+		return nil, statusErr{code: http.StatusUnauthorized, msg: "trae: API key or session token missing"}
+	}
+
+	chatURL := helps.TraeDefaultChatURL
+	if baseURL != "" {
+		chatURL = strings.TrimRight(baseURL, "/")
+		if !strings.HasSuffix(chatURL, "/chat/completions") && !strings.HasSuffix(chatURL, "/llm_raw_chat") {
+			chatURL += "/chat/completions"
+		}
+	}
+
+	reqBody, errBuild := helps.BuildTraeRequestBody(req.Payload, req.Model)
+	if errBuild != nil {
+		return nil, fmt.Errorf("trae: failed to build request body: %w", errBuild)
+	}
+
+	httpReq, errReq := http.NewRequestWithContext(ctx, http.MethodPost, chatURL, bytes.NewReader(reqBody))
+	if errReq != nil {
+		return nil, errReq
+	}
+
+	authHeaderVal := apiKey
+	if !strings.HasPrefix(apiKey, "Bearer ") && !strings.HasPrefix(apiKey, "Cloud-IDE-JWT ") {
+		authHeaderVal = "Bearer " + apiKey
+	}
+	httpReq.Header.Set("Authorization", authHeaderVal)
+	httpReq.Header.Set("Content-Type", "application/json")
+	httpReq.Header.Set("Accept", "text/event-stream")
+	httpReq.Header.Set("X-App-Id", helps.TraeAppID)
+	httpReq.Header.Set("User-Agent", "Trae/1.0.23444")
+
+	httpClient := helps.NewProxyAwareHTTPClient(ctx, e.cfg, auth, 0)
+	resp, errDo := httpClient.Do(httpReq)
+	if errDo != nil {
+		return nil, errDo
+	}
+
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		bodyBytes, _ := io.ReadAll(resp.Body)
+		_ = resp.Body.Close()
+		return nil, statusErr{code: resp.StatusCode, msg: fmt.Sprintf("trae upstream error: %d: %s", resp.StatusCode, string(bodyBytes))}
+	}
+
+	chunks := make(chan cliproxyexecutor.StreamChunk, 64)
+	go func() {
+		defer func() {
+			if errClose := resp.Body.Close(); errClose != nil {
+				log.Errorf("trae response body close error: %v", errClose)
+			}
+		}()
+		defer close(chunks)
+
+		scanner := bufio.NewScanner(resp.Body)
+		buf := make([]byte, 64*1024)
+		scanner.Buffer(buf, 1024*1024)
+
+		for scanner.Scan() {
+			line := strings.TrimSpace(scanner.Text())
+			if line == "" {
+				continue
+			}
+			if !strings.HasPrefix(line, "data:") {
+				continue
+			}
+			chunks <- cliproxyexecutor.StreamChunk{Payload: []byte(line)}
+			if strings.TrimSpace(strings.TrimPrefix(line, "data:")) == "[DONE]" {
+				return
+			}
+		}
+		if errScan := scanner.Err(); errScan != nil && !errors.Is(errScan, context.Canceled) {
+			chunks <- cliproxyexecutor.StreamChunk{Err: errScan}
+		}
+	}()
+
+	return &cliproxyexecutor.StreamResult{
+		Headers: resp.Header,
+		Chunks:  chunks,
+	}, nil
+}
+
+// CountTokens calculates token counts for Trae requests.
+func (e *TraeExecutor) CountTokens(ctx context.Context, auth *cliproxyauth.Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	adaptedAuth := e.adaptAuth(auth)
+	return e.OpenAICompatExecutor.CountTokens(ctx, adaptedAuth, req, opts)
+}
+
+// Refresh refreshes the Trae access token using its refresh token.
+func (e *TraeExecutor) Refresh(ctx context.Context, auth *cliproxyauth.Auth) (*cliproxyauth.Auth, error) {
+	if auth == nil || auth.Metadata == nil {
+		return nil, fmt.Errorf("trae executor: auth is nil")
+	}
+	refreshToken, _ := auth.Metadata["refresh_token"].(string)
+	refreshToken = strings.TrimSpace(refreshToken)
+	if refreshToken == "" {
+		return auth, nil
+	}
+
+	host := ""
+	if h, ok := auth.Metadata["host"].(string); ok {
+		host = h
+	}
+	userID := ""
+	if uid, ok := auth.Metadata["user_id"].(string); ok {
+		userID = uid
+	}
+
+	ts := &trae.TraeTokenStorage{
+		AccessToken:  strings.TrimSpace(auth.Attributes["api_key"]),
+		RefreshToken: refreshToken,
+		Host:         host,
+		UserID:       userID,
+	}
+
+	if err := trae.RefreshToken(ctx, ts); err != nil {
+		log.Warnf("trae executor: failed to refresh token: %v", err)
+		return nil, err
+	}
+
+	auth.Metadata["access_token"] = ts.AccessToken
+	if ts.RefreshToken != "" {
+		auth.Metadata["refresh_token"] = ts.RefreshToken
+	}
+	if ts.Expired != "" {
+		auth.Metadata["expired"] = ts.Expired
+	}
+	auth.Metadata["last_refresh"] = time.Now().Format(time.RFC3339)
+	if auth.Attributes != nil {
+		auth.Attributes["api_key"] = ts.AccessToken
+	}
+
+	if auth.Storage != nil {
+		if setter, ok := auth.Storage.(interface{ SetMetadata(map[string]any) }); ok {
+			setter.SetMetadata(auth.Metadata)
+		}
+		if path, ok := auth.Attributes[cliproxyauth.AttributePath]; ok && path != "" {
+			if errSave := auth.Storage.SaveTokenToFile(path); errSave != nil {
+				log.Warnf("trae executor: failed to save refreshed token to %s: %v", path, errSave)
+			}
+		}
+	}
+	return auth, nil
+}
+
+func (e *TraeExecutor) adaptAuth(auth *cliproxyauth.Auth) *cliproxyauth.Auth {
+	if auth == nil {
+		return nil
+	}
+	cloned := *auth
+	attrs := make(map[string]string, len(auth.Attributes)+4)
+	for k, v := range auth.Attributes {
+		attrs[k] = v
+	}
+	apiKey := strings.TrimSpace(attrs["api_key"])
+	if apiKey == "" && auth.Metadata != nil {
+		if token, ok := auth.Metadata["access_token"].(string); ok && strings.TrimSpace(token) != "" {
+			apiKey = strings.TrimSpace(token)
+		}
+	}
+	attrs["api_key"] = apiKey
+	cloned.Attributes = attrs
+	return &cloned
+}
