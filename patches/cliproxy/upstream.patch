+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/misc"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	log "github.com/sirupsen/logrus"
+)
+
+// zcodeRefreshLead is the duration before token expiry when refresh should occur.
+var zcodeRefreshLead = 5 * time.Minute
+
+// ZCodeAuthenticator implements authentication for ZCode (Z.AI / 智谱 BigModel).
+type ZCodeAuthenticator struct{}
+
+// NewZCodeAuthenticator constructs a new ZCode authenticator.
+func NewZCodeAuthenticator() Authenticator {
+	return &ZCodeAuthenticator{}
+}
+
+// Provider returns the provider key for zcode.
+func (ZCodeAuthenticator) Provider() string {
+	return "zcode"
+}
+
+// RefreshLead returns the duration before token expiry when refresh should occur.
+func (ZCodeAuthenticator) RefreshLead() *time.Duration {
+	return &zcodeRefreshLead
+}
+
+// Login initiates ZCode authentication via API key, local import, or OAuth device flow.
+func (a ZCodeAuthenticator) Login(ctx context.Context, cfg *config.Config, opts *LoginOptions) (*coreauth.Auth, error) {
+	if cfg == nil {
+		return nil, fmt.Errorf("cliproxy auth: configuration is required")
+	}
+	if opts == nil {
+		opts = &LoginOptions{}
+	}
+
+	authSvc := zcode.NewZCodeAuth(cfg)
+
+	// Check if API key was provided via metadata or environment
+	apiKey := ""
+	if opts.Metadata != nil {
+		if v, ok := opts.Metadata["api_key"]; ok && strings.TrimSpace(v) != "" {
+			apiKey = strings.TrimSpace(v)
+		} else if v, ok := opts.Metadata["token"]; ok && strings.TrimSpace(v) != "" {
+			apiKey = strings.TrimSpace(v)
+		}
+	}
+	if apiKey == "" {
+		apiKey = strings.TrimSpace(os.Getenv("ZCODE_API_KEY"))
+		if apiKey == "" {
+			apiKey = strings.TrimSpace(os.Getenv("BIGMODEL_API_KEY"))
+		}
+	}
+
+	provider := "zai"
+	if opts.Metadata != nil && opts.Metadata["provider"] != "" {
+		provider = opts.Metadata["provider"]
+	}
+
+	if apiKey != "" {
+		storage := &zcode.ZCodeTokenStorage{
+			AccessToken: apiKey,
+			TokenType:   "Bearer",
+			Provider:    provider,
+			Type:        "zcode",
+		}
+		label := "ZCode (" + provider + ")"
+		metadata := map[string]any{
+			"access_token": apiKey,
+			"provider":     provider,
+			"type":         "zcode",
+		}
+		return &coreauth.Auth{
+			Storage:  storage,
+			Label:    label,
+			Metadata: metadata,
+			Attributes: map[string]string{
+				"provider": "zcode",
+				"api_key":  apiKey,
+			},
+		}, nil
+	}
+
+	// Try local configuration import if requested or available
+	if opts.Metadata != nil && opts.Metadata["import_local"] == "true" {
+		storage, errImport := authSvc.ImportLocalConfig()
+		if errImport == nil && storage.AccessToken != "" {
+			label := "ZCode Desktop"
+			if storage.UID != "" {
+				label += " (" + storage.UID + ")"
+			}
+			metadata := map[string]any{
+				"access_token": storage.AccessToken,
+				"uid":          storage.UID,
+				"jwt":          storage.JWT,
+				"provider":     storage.Provider,
+				"type":         "zcode",
+			}
+			return &coreauth.Auth{
+				Storage:  storage,
+				Label:    label,
+				Metadata: metadata,
+				Attributes: map[string]string{
+					"provider": "zcode",
+					"api_key":  storage.AccessToken,
+				},
+			}, nil
+		}
+	}
+
+	// Start OAuth authorization with local callback listener
+	callbackPort := zcode.DefaultCallbackPort
+	if opts.CallbackPort > 0 {
+		callbackPort = opts.CallbackPort
+	}
+	cbServer, actualPort, errServer := zcode.StartLocalCallbackServer(callbackPort)
+	if errServer != nil {
+		return nil, fmt.Errorf("zcode: failed to start callback listener: %w", errServer)
+	}
+	defer func() {
+		stopCtx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+		defer cancel()
+		_ = cbServer.Stop(stopCtx)
+	}()
+
+	redirectURI := fmt.Sprintf("http://127.0.0.1:%d/zcode/callback", actualPort)
+	state, errState := misc.GenerateRandomState()
+	if errState != nil {
+		return nil, fmt.Errorf("zcode: failed to generate state: %w", errState)
+	}
+
+	authURL, errURL := authSvc.GenerateAuthURL(redirectURI, state)
+	if errURL != nil {
+		return nil, fmt.Errorf("zcode: failed to generate authorization url: %w", errURL)
+	}
+
+	fmt.Printf("\nTo authenticate with ZCode, please visit:\n%s\n\n", authURL)
+
+	if !opts.NoBrowser && browser.IsAvailable() {
+		if errOpen := browser.OpenURL(authURL); errOpen != nil {
+			log.Warnf("Failed to open browser automatically: %v", errOpen)
+		} else {
+			fmt.Println("Browser opened automatically.")
+		}
+	}
+
+	fmt.Println("Waiting for authorization callback...")
+	cbResult, errWait := cbServer.WaitForCallback(5 * time.Minute)
+	if errWait != nil {
+		return nil, fmt.Errorf("zcode: %w", errWait)
+	}
+	if cbResult.Error != "" {
+		return nil, fmt.Errorf("zcode authorization error: %s", cbResult.Error)
+	}
+	if cbResult.State != state {
+		return nil, errors.New("zcode: state mismatch")
+	}
+
+	storage, errExchange := authSvc.ExchangeCodeForTokens(ctx, cbResult.Code, state, redirectURI)
+	if errExchange != nil {
+		return nil, fmt.Errorf("zcode: token exchange failed: %w", errExchange)
+	}
+
+	label := "ZCode"
+	if storage.Email != "" {
+		label += " (" + storage.Email + ")"
+	} else if storage.UID != "" {
+		label += " (" + storage.UID + ")"
+	}
+
+	metadata := map[string]any{
+		"access_token": storage.AccessToken,
+		"provider":     storage.Provider,
+		"type":         "zcode",
+	}
+	if storage.UID != "" {
+		metadata["uid"] = storage.UID
+	}
+	if storage.Email != "" {
+		metadata["email"] = storage.Email
+	}
+	if storage.JWT != "" {
+		metadata["jwt"] = storage.JWT
+	}
+	if storage.Expired != "" {
+		metadata["expired"] = storage.Expired
+	}
+
+	return &coreauth.Auth{
+		Storage:  storage,
+		Label:    label,
+		Metadata: metadata,
+		Attributes: map[string]string{
+			"provider": "zcode",
+			"api_key":  storage.AccessToken,
+		},
+	}, nil
+}
