diff --git a/sdk/auth/trae.go b/sdk/auth/trae.go
new file mode 100644
index 00000000..bce7ec7a
--- /dev/null
+++ b/sdk/auth/trae.go
@@ -0,0 +1,148 @@
+package auth
+
+import (
+	"bufio"
+	"context"
+	"fmt"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/auth/trae"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	coreauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+)
+
+// TraeAuthenticator implements authentication for ByteDance Trae (and MarsCode).
+type TraeAuthenticator struct{}
+
+// NewTraeAuthenticator constructs a new Trae authenticator.
+func NewTraeAuthenticator() Authenticator {
+	return &TraeAuthenticator{}
+}
+
+// Provider returns the provider key for trae.
+func (TraeAuthenticator) Provider() string {
+	return "trae"
+}
+
+// RefreshLead returns the duration before token expiry when refresh should occur.
+func (TraeAuthenticator) RefreshLead() *time.Duration {
+	lead := 5 * time.Minute
+	return &lead
+}
+
+// Login initiates Trae authentication via local configuration discovery, direct token, or interactive input.
+func (a TraeAuthenticator) Login(ctx context.Context, cfg *config.Config, opts *LoginOptions) (*coreauth.Auth, error) {
+	if cfg == nil {
+		return nil, fmt.Errorf("cliproxy auth: configuration is required")
+	}
+	if opts == nil {
+		opts = &LoginOptions{}
+	}
+
+	authDir := cfg.AuthDir
+	if authDir == "" {
+		authDir = "auths"
+	}
+
+	// 1. Check if token was provided in metadata or environment variable
+	token := ""
+	refreshToken := ""
+	host := trae.DefaultTraeHost
+	if opts.Metadata != nil {
+		if v, ok := opts.Metadata["token"]; ok && strings.TrimSpace(v) != "" {
+			token = strings.TrimSpace(v)
+		} else if v, ok := opts.Metadata["access_token"]; ok && strings.TrimSpace(v) != "" {
+			token = strings.TrimSpace(v)
+		}
+		if v, ok := opts.Metadata["refresh_token"]; ok && strings.TrimSpace(v) != "" {
+			refreshToken = strings.TrimSpace(v)
+		}
+		if v, ok := opts.Metadata["host"]; ok && strings.TrimSpace(v) != "" {
+			host = strings.TrimSpace(v)
+		}
+	}
+
+	if token == "" {
+		token = strings.TrimSpace(os.Getenv("TRAE_TOKEN"))
+	}
+
+	if token != "" {
+		storage := &trae.TraeTokenStorage{
+			AccessToken:  token,
+			RefreshToken: refreshToken,
+			TokenType:    "Bearer",
+			Host:         host,
+			Provider:     "trae",
+			Type:         "trae",
+		}
+		if errSave := storage.SaveToken(authDir); errSave != nil {
+			return nil, fmt.Errorf("trae: failed to save token: %w", errSave)
+		}
+		return toCoreAuthTrae(storage), nil
+	}
+
+	// 2. Try importing local credentials from Trae desktop installation
+	storage, errImport := trae.ImportLocalTraeCredentials(authDir)
+	if errImport == nil && storage != nil && storage.AccessToken != "" {
+		fmt.Println("Successfully imported Trae session from local desktop client!")
+		return toCoreAuthTrae(storage), nil
+	}
+
+	// 3. Fallback to interactive prompt if in terminal
+	fmt.Println("\nCould not automatically locate local Trae credentials.")
+	fmt.Print("Enter Trae access token (JWT) or press Enter to cancel: ")
+
+	scanner := bufio.NewScanner(os.Stdin)
+	if scanner.Scan() {
+		input := strings.TrimSpace(scanner.Text())
+		if input != "" {
+			storage := &trae.TraeTokenStorage{
+				AccessToken: input,
+				TokenType:   "Bearer",
+				Host:        host,
+				Provider:    "trae",
+				Type:        "trae",
+			}
+			if errSave := storage.SaveToken(authDir); errSave != nil {
+				return nil, fmt.Errorf("trae: failed to save token: %w", errSave)
+			}
+			return toCoreAuthTrae(storage), nil
+		}
+	}
+
+	return nil, fmt.Errorf("trae: authentication cancelled or no credentials provided")
+}
+
+func toCoreAuthTrae(storage *trae.TraeTokenStorage) *coreauth.Auth {
+	label := "Trae"
+	if storage.Email != "" {
+		label += " (" + storage.Email + ")"
+	} else if storage.Username != "" {
+		label += " (" + storage.Username + ")"
+	} else if storage.UserID != "" {
+		label += " (" + storage.UserID + ")"
+	}
+
+	metadata := map[string]any{
+		"access_token": storage.AccessToken,
+		"host":         storage.Host,
+		"user_id":      storage.UserID,
+		"email":        storage.Email,
+		"username":     storage.Username,
+		"region":       storage.Region,
+		"provider":     "trae",
+		"type":         "trae",
+	}
+
+	return &coreauth.Auth{
+		Storage:  storage,
+		Label:    label,
+		Metadata: metadata,
+		Attributes: map[string]string{
+			"provider": "trae",
+			"api_key":  storage.AccessToken,
+		},
+	}
+}
diff --git a/sdk/auth/workbuddy.go b/sdk/auth/workbuddy.go
new file mode 100644
index 00000000..75d5c34b
