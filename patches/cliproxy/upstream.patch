diff --git a/internal/runtime/executor/zcode_executor.go b/internal/runtime/executor/zcode_executor.go
new file mode 100644
index 00000000..d2d9d2c6
--- /dev/null
+++ b/internal/runtime/executor/zcode_executor.go
@@ -0,0 +1,283 @@
+package executor
+
+import (
+	"bufio"
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/auth/zcode"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/runtime/executor/helps"
+	cliproxyauth "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/auth"
+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+	log "github.com/sirupsen/logrus"
+	"github.com/tidwall/gjson"
+)
+
+// ZCodeExecutor implements the executor for ZCode (Z.AI / 智谱 BigModel) APIs.
+type ZCodeExecutor struct {
+	*OpenAICompatExecutor
+	cfg *config.Config
+}
+
+// NewZCodeExecutor constructs a new ZCode executor instance.
+func NewZCodeExecutor(cfg *config.Config) *ZCodeExecutor {
+	return &ZCodeExecutor{
+		OpenAICompatExecutor: NewOpenAICompatExecutor("zcode", cfg),
+		cfg:                  cfg,
+	}
+}
+
+// Identifier returns the provider identifier "zcode".
+func (e *ZCodeExecutor) Identifier() string {
+	return "zcode"
+}
+
+// RequestToFormat reports the format expected by the ZCode upstream API.
+func (e *ZCodeExecutor) RequestToFormat(req cliproxyexecutor.Request, opts cliproxyexecutor.Options) sdktranslator.Format {
+	if opts.Alt == "responses/compact" && !opts.Stream {
+		return sdktranslator.FormatOpenAIResponse
+	}
+	return sdktranslator.FormatOpenAI
+}
+
+// PrepareRequest injects ZCode credentials and headers into the outgoing HTTP request.
+func (e *ZCodeExecutor) PrepareRequest(req *http.Request, auth *cliproxyauth.Auth) error {
+	adaptedAuth := e.adaptAuth(auth)
+	return e.OpenAICompatExecutor.PrepareRequest(req, adaptedAuth)
+}
+
+// HttpRequest prepares and sends an HTTP request using ZCode credentials.
+func (e *ZCodeExecutor) HttpRequest(ctx context.Context, auth *cliproxyauth.Auth, req *http.Request) (*http.Response, error) {
+	adaptedAuth := e.adaptAuth(auth)
+	return e.OpenAICompatExecutor.HttpRequest(ctx, adaptedAuth, req)
+}
+
+// Execute performs a non-streaming chat completion request to ZCode.
+func (e *ZCodeExecutor) Execute(ctx context.Context, auth *cliproxyauth.Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	streamResult, errStream := e.ExecuteStream(ctx, auth, req, opts)
+	if errStream != nil {
+		return cliproxyexecutor.Response{}, errStream
+	}
+
+	var contentBuilder, reasoningContentBuilder strings.Builder
+	var lastID, lastModel string
+	var created int64
+	finishReason := "stop"
+	var promptTokens, completionTokens int64
+
+	for chunk := range streamResult.Chunks {
+		if chunk.Err != nil {
+			return cliproxyexecutor.Response{}, chunk.Err
+		}
+		payload := strings.TrimSpace(string(chunk.Payload))
+		data := strings.TrimSpace(strings.TrimPrefix(payload, "data:"))
+		if data == "" {
+			continue
+		}
+		if data == "[DONE]" {
+			break
+		}
+		gj := gjson.Parse(data)
+		if id := gj.Get("id").String(); id != "" {
+			lastID = id
+		}
+		if m := gj.Get("model").String(); m != "" {
+			lastModel = m
+		}
+		if c := gj.Get("created").Int(); c > 0 {
+			created = c
+		}
+		if content := gj.Get("choices.0.delta.content").String(); content != "" {
+			contentBuilder.WriteString(content)
+		}
+		if rc := helps.ExtractReasoningFromChunk(data); rc != "" {
+			reasoningContentBuilder.WriteString(rc)
+		}
+		if fr := gj.Get("choices.0.finish_reason").String(); fr != "" {
+			finishReason = fr
+		}
+		if pt := gj.Get("usage.prompt_tokens").Int(); pt > 0 {
+			promptTokens = pt
+		}
+		if ct := gj.Get("usage.completion_tokens").Int(); ct > 0 {
+			completionTokens = ct
+		}
+	}
+
+	if lastID == "" {
+		lastID = "chatcmpl-" + uuid.NewString()
+	}
+	if lastModel == "" {
+		lastModel = helps.NormalizeZCodeModel(req.Model)
+	}
+	if created == 0 {
+		created = time.Now().Unix()
+	}
+
+	msgMap := map[string]any{
+		"role":    "assistant",
+		"content": contentBuilder.String(),
+	}
+	if reasoningContentBuilder.Len() > 0 {
+		msgMap["reasoning_content"] = reasoningContentBuilder.String()
+	}
+
+	respMap := map[string]any{
+		"id":      lastID,
+		"object":  "chat.completion",
+		"created": created,
+		"model":   lastModel,
+		"choices": []map[string]any{
+			{
+				"index":         0,
+				"message":       msgMap,
+				"finish_reason": finishReason,
+			},
+		},
+		"usage": map[string]any{
+			"prompt_tokens":     promptTokens,
+			"completion_tokens": completionTokens,
+			"total_tokens":      promptTokens + completionTokens,
+		},
+	}
+	respBytes, errMarshal := json.Marshal(respMap)
+	if errMarshal != nil {
+		return cliproxyexecutor.Response{}, errMarshal
+	}
+	return cliproxyexecutor.Response{
+		Payload: respBytes,
+		Headers: streamResult.Headers,
+	}, nil
+}
+
+// ExecuteStream performs a streaming chat completion request to ZCode.
+func (e *ZCodeExecutor) ExecuteStream(ctx context.Context, auth *cliproxyauth.Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (*cliproxyexecutor.StreamResult, error) {
+	var accessToken, provider, baseURL string
+	if auth != nil && auth.Metadata != nil {
+		accessToken, _ = auth.Metadata["access_token"].(string)
+		provider, _ = auth.Metadata["provider"].(string)
+		baseURL, _ = auth.Metadata["base_url"].(string)
+	}
+	if accessToken == "" && auth != nil && auth.Attributes != nil {
+		accessToken = auth.Attributes["api_key"]
+		if provider == "" {
+			provider = auth.Attributes["provider_sub"]
+		}
+		if baseURL == "" {
+			baseURL = auth.Attributes["base_url"]
+		}
+	}
+	if accessToken == "" {
+		return nil, statusErr{code: http.StatusUnauthorized, msg: "zcode: access token or API key missing"}
+	}
+
+	chatURL := helps.ZCodeBigModelChatURL
+	switch provider {
+	case "zai":
+		chatURL = helps.ZCodeZAIChatURL
+	case "bigmodel":
+		chatURL = helps.ZCodeBigModelCodingChatURL
+	}
+	if baseURL != "" {
+		chatURL = strings.TrimRight(baseURL, "/") + "/chat/completions"
+	}
+
+	reqBody, errBuild := helps.BuildZCodeRequestBody(req.Payload, req.Model)
+	if errBuild != nil {
+		return nil, fmt.Errorf("zcode: failed to build request body: %w", errBuild)
+	}
+
+	httpReq, errReq := http.NewRequestWithContext(ctx, http.MethodPost, chatURL, bytes.NewReader(reqBody))
+	if errReq != nil {
+		return nil, errReq
+	}
+	httpReq.Header.Set("Authorization", "Bearer "+accessToken)
+	httpReq.Header.Set("Content-Type", "application/json")
+	httpReq.Header.Set("Accept", "text/event-stream")
+
+	httpClient := helps.NewProxyAwareHTTPClient(ctx, e.cfg, auth, 0)
+	resp, errDo := httpClient.Do(httpReq)
+	if errDo != nil {
+		return nil, errDo
+	}
+
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		bodyBytes, _ := io.ReadAll(resp.Body)
+		_ = resp.Body.Close()
+		return nil, statusErr{code: resp.StatusCode, msg: fmt.Sprintf("zcode upstream error: %d: %s", resp.StatusCode, string(bodyBytes))}
+	}
+
+	chunks := make(chan cliproxyexecutor.StreamChunk, 64)
+	go func() {
+		defer func() {
+			if errClose := resp.Body.Close(); errClose != nil {
+				log.Errorf("zcode response body close error: %v", errClose)
+			}
+		}()
+		defer close(chunks)
+
+		scanner := bufio.NewScanner(resp.Body)
+		buf := make([]byte, 64*1024)
+		scanner.Buffer(buf, 1024*1024)
+
+		for scanner.Scan() {
+			line := strings.TrimSpace(scanner.Text())
+			if line == "" {
+				continue
+			}
+			if !strings.HasPrefix(line, "data:") {
+				continue
+			}
+			chunks <- cliproxyexecutor.StreamChunk{Payload: []byte(line)}
+			if strings.TrimSpace(strings.TrimPrefix(line, "data:")) == "[DONE]" {
+				return
+			}
+		}
+		if errScan := scanner.Err(); errScan != nil && !errors.Is(errScan, context.Canceled) {
+			chunks <- cliproxyexecutor.StreamChunk{Err: errScan}
+		}
+	}()
+
+	return &cliproxyexecutor.StreamResult{
+		Headers: resp.Header,
+		Chunks:  chunks,
+	}, nil
+}
+
+// CountTokens calculates token counts for ZCode requests.
+func (e *ZCodeExecutor) CountTokens(ctx context.Context, auth *cliproxyauth.Auth, req cliproxyexecutor.Request, opts cliproxyexecutor.Options) (cliproxyexecutor.Response, error) {
+	adaptedAuth := e.adaptAuth(auth)
+	return e.OpenAICompatExecutor.CountTokens(ctx, adaptedAuth, req, opts)
+}
+
+func (e *ZCodeExecutor) adaptAuth(auth *cliproxyauth.Auth) *cliproxyauth.Auth {
+	if auth == nil {
+		return nil
+	}
+	cloned := *auth
+	attrs := make(map[string]string, len(auth.Attributes)+4)
+	for k, v := range auth.Attributes {
+		attrs[k] = v
+	}
+	apiKey := strings.TrimSpace(attrs["api_key"])
+	if apiKey == "" && auth.Metadata != nil {
+		if token, ok := auth.Metadata["access_token"].(string); ok && strings.TrimSpace(token) != "" {
+			apiKey = strings.TrimSpace(token)
+		}
+	}
+	attrs["api_key"] = apiKey
+	cloned.Attributes = attrs
+	return &cloned
+}
+
+var _ = zcode.ErrDeviceFlowPending
