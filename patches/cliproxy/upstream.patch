+)
+
+func TestWorkBuddyTokenStorageSaveAndExpiry(t *testing.T) {
+	tempDir := t.TempDir()
+	filePath := filepath.Join(tempDir, "test-wb.json")
+
+	storage := &WorkBuddyTokenStorage{
+		AccessToken:  "test-access",
+		RefreshToken: "test-refresh",
+		TokenType:    "Bearer",
+		Expired:      time.Now().Add(1 * time.Hour).UTC().Format(time.RFC3339),
+		UID:          "wb-user-1",
+		EnterpriseID: "ent-1",
+		Nickname:     "Tester",
+		Type:         "workbuddy",
+	}
+
+	if storage.IsExpired() {
+		t.Fatal("IsExpired() = true, want false")
+	}
+
+	storage.SetMetadata(map[string]any{"custom": "value"})
+
+	if err := storage.SaveTokenToFile(filePath); err != nil {
+		t.Fatalf("SaveTokenToFile() error: %v", err)
+	}
+
+	content, errRead := os.ReadFile(filePath)
+	if errRead != nil {
+		t.Fatalf("ReadFile() error: %v", errRead)
+	}
+
+	var loaded map[string]any
+	if errUnmarshal := json.Unmarshal(content, &loaded); errUnmarshal != nil {
+		t.Fatalf("Unmarshal() error: %v", errUnmarshal)
+	}
+
+	if loaded["type"] != "workbuddy" {
+		t.Fatalf("type = %v, want workbuddy", loaded["type"])
+	}
+	if loaded["access_token"] != "test-access" {
+		t.Fatalf("access_token = %v, want test-access", loaded["access_token"])
+	}
+	if loaded["custom"] != "value" {
+		t.Fatalf("custom = %v, want value", loaded["custom"])
+	}
+}
+
+func TestWorkBuddyQuotaParse(t *testing.T) {
+	rawJSON := `{
+		"Packages": [
+			{
+				"PackageCode": "PACK_A",
+				"CycleTotalCapacity": "1000",
+				"CycleRemainCapacity": "800",
+				"CycleUsedCapacity": "200",
+				"CapacityUnit": "credits"
+			},
+			{
+				"PackageCode": "PACK_B",
+				"CycleTotalCapacity": "500",
+				"CycleRemainCapacity": "400.5",
+				"CycleUsedCapacity": "99.5",
+				"CapacityUnit": "credits"
+			}
+		]
+	}`
+
+	var summary struct {
+		Packages []struct {
+			PackageCode         string `json:"PackageCode"`
+			CycleTotalCapacity  string `json:"CycleTotalCapacity"`
+			CycleRemainCapacity string `json:"CycleRemainCapacity"`
+			CycleUsedCapacity   string `json:"CycleUsedCapacity"`
+			CapacityUnit        string `json:"CapacityUnit"`
+		} `json:"Packages"`
+	}
+
+	if err := json.Unmarshal([]byte(rawJSON), &summary); err != nil {
+		t.Fatalf("Unmarshal error: %v", err)
+	}
+
+	quota := &WorkBuddyQuota{}
+	for _, p := range summary.Packages {
+		var total, remain, used float64
+		_ = json.Unmarshal([]byte(p.CycleTotalCapacity), &total)
+		_ = json.Unmarshal([]byte(p.CycleRemainCapacity), &remain)
+		_ = json.Unmarshal([]byte(p.CycleUsedCapacity), &used)
+		quota.TotalCredits += total
+		quota.RemainCredits += remain
+		quota.UsedCredits += used
+	}
+
+	if quota.TotalCredits != 1500 {
+		t.Fatalf("TotalCredits = %v, want 1500", quota.TotalCredits)
+	}
+	if quota.RemainCredits != 1200.5 {
+		t.Fatalf("RemainCredits = %v, want 1200.5", quota.RemainCredits)
+	}
+	if quota.UsedCredits != 299.5 {
+		t.Fatalf("UsedCredits = %v, want 299.5", quota.UsedCredits)
+	}
+}
+
+func TestWorkBuddyRequestStateAndPoll(t *testing.T) {
+	ts := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch r.URL.Path {
+		case "/v2/plugin/auth/state":
+			resp := map[string]any{
+				"code": 0,
+				"msg":  "OK",
+				"data": map[string]any{
+					"state":     "test-state-xyz",
+					"authUrl":   "https://copilot.tencent.com/login?platform=CLI&state=test-state-xyz",
+					"expiresIn": 300,
+				},
+			}
+			_ = json.NewEncoder(w).Encode(resp)
+		case "/v2/plugin/auth/token":
+			resp := map[string]any{
+				"code": 0,
+				"msg":  "OK",
+				"data": map[string]any{
+					"accessToken":  "wb-acc-token",
+					"refreshToken": "wb-ref-token",
+					"expiresIn":    2592000,
+					"domain":       "copilot.tencent.com",
+				},
+			}
+			_ = json.NewEncoder(w).Encode(resp)
+		case "/v2/plugin/login/account":
+			resp := map[string]any{
+				"code": 0,
+				"msg":  "OK",
+				"data": map[string]any{
+					"uid":          "uid-999",
+					"nickname":     "Tester",
+					"enterpriseId": "ent-999",
+				},
+			}
+			_ = json.NewEncoder(w).Encode(resp)
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	defer ts.Close()
+
+	cfg := &config.Config{}
+	wbAuth := NewWorkBuddyAuth(cfg)
+
+	// Verify CreateTokenStorage
+	bundle := &WorkBuddyAuthBundle{
+		TokenData: &WorkBuddyTokenData{
+			AccessToken:  "wb-acc-token",
+			RefreshToken: "wb-ref-token",
+			ExpiresIn:    2592000,
+			ExpiresAt:    time.Now().Unix() + 2592000,
+			UID:          "uid-999",
+			Nickname:     "Tester",
+			EnterpriseID: "ent-999",
+		},
+	}
+
+	storage := wbAuth.CreateTokenStorage(bundle)
+	if storage == nil {
+		t.Fatal("CreateTokenStorage returned nil")
+	}
+	if storage.AccessToken != "wb-acc-token" || storage.UID != "uid-999" {
+		t.Fatalf("Storage fields mismatch: %+v", storage)
+	}
+	if storage.Type != "workbuddy" {
+		t.Fatalf("Storage type = %q, want workbuddy", storage.Type)
+	}
+
+	_ = context.Background()
+}
