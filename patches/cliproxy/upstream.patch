+	ZCodeBigModelCodingChatURL = "https://open.bigmodel.cn/api/coding/paas/v4/chat/completions"
+	// ZCodeZAIChatURL is the Z.AI coding chat completion endpoint.
+	ZCodeZAIChatURL = "https://api.z.ai/api/coding/paas/v4/chat/completions"
+)
+
+// NormalizeZCodeModel normalizes GLM / ZCode model identifiers.
+func NormalizeZCodeModel(model string) string {
+	m := strings.ToLower(strings.TrimSpace(model))
+	switch m {
+	case "glm-5.3", "glm-53":
+		return "glm-5.3"
+	case "glm-5.3-flash":
+		return "glm-5.3-flash"
+	case "glm-5.2", "glm-52":
+		return "glm-5.2"
+	case "glm-5.1", "glm-51":
+		return "glm-5.1"
+	case "glm-5", "glm-5-turbo":
+		return "glm-5"
+	case "glm-5v-turbo", "glm-5v":
+		return "glm-5v-turbo"
+	case "glm-4.7", "glm-47":
+		return "glm-4.7"
+	case "glm-4.6", "glm-46":
+		return "glm-4.6"
+	case "glm-4.6v", "glm-46v":
+		return "glm-4.6v"
+	case "glm-4.5-air", "glm-45-air":
+		return "glm-4.5-air"
+	case "glm-4-plus", "glm-4plus":
+		return "glm-4-plus"
+	case "glm-4-flash", "glm-4flash":
+		return "glm-4-flash"
+	default:
+		if m != "" {
+			return m
+		}
+		return "glm-5.3-flash"
+	}
+}
+
+// BuildZCodeRequestBody sets the normalized model and preserves reasoning / stream parameters.
+func BuildZCodeRequestBody(raw []byte, model string) ([]byte, error) {
+	if len(raw) == 0 {
+		raw = []byte("{}")
+	}
+	modelKey := NormalizeZCodeModel(model)
+	return sjson.SetBytes(raw, "model", modelKey)
+}
+
+// ExtractReasoningFromChunk extracts reasoning text from a chunk JSON if available.
+func ExtractReasoningFromChunk(dataStr string) string {
+	gj := gjson.Parse(dataStr)
+	// Try standard delta.reasoning_content
+	if rc := gj.Get("choices.0.delta.reasoning_content").String(); rc != "" {
+		return rc
+	}
+	// Try alternative delta.reasoning
+	if r := gj.Get("choices.0.delta.reasoning").String(); r != "" {
+		return r
+	}
+	return ""
+}
