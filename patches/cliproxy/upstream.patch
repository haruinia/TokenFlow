+package helps
+
+import (
+	"encoding/json"
+	"strings"
+
+	"github.com/tidwall/gjson"
+	"github.com/tidwall/sjson"
+)
+
+const (
+	// WorkBuddyDefaultChatURL is the upstream chat completion endpoint.
+	WorkBuddyDefaultChatURL = "https://copilot.tencent.com/v2/chat/completions"
+	// WorkBuddyOrigin is the origin header expected by Tencent upstream.
+	WorkBuddyOrigin = "https://www.codebuddy.cn"
+	// WorkBuddyReferer is the referer header expected by Tencent upstream.
+	WorkBuddyReferer = "https://www.codebuddy.cn/"
+	// WorkBuddyUserAgent is the official CLI user agent string.
+	WorkBuddyUserAgent = "CLI/2.161.0 CodeBuddy/2.161.0"
+	// WorkBuddyProductHeader is the product identifier expected by Tencent upstream.
+	WorkBuddyProductHeader = "SaaS"
+)
+
+// NormalizeWorkBuddyModel normalizes model identifiers to their canonical WorkBuddy names.
+func NormalizeWorkBuddyModel(model string) string {
+	m := strings.ToLower(strings.TrimSpace(model))
+	switch m {
+	case "hy4", "hunyuan-4", "hunyuan4", "hy4-preview":
+		return "hy4-preview"
+	case "hy4-x", "hy4-preview-x":
+		return "hy4-preview-x"
+	case "hy3", "hunyuan-3", "hunyuan3":
+		return "hy3"
+	case "hy3-x":
+		return "hy3-x"
+	case "hunyuan-2.0", "hunyuan-2.0-thinking", "hunyuan-thinking":
+		return "hunyuan-2.0-thinking"
+	case "hunyuan-chat", "hunyuan-turbos", "hunyuan":
+		return "hunyuan-chat"
+	case "deepseek-v4", "deepseek-v4.1", "deepseek-v4.1-flash":
+		return "deepseek-v4.1-flash"
+	case "deepseek-v4-flash":
+		return "deepseek-v4-flash"
+	case "deepseek-v4-pro":
+		return "deepseek-v4-pro"
+	case "deepseek-v3.2", "deepseek-v3-2-volc":
+		return "deepseek-v3-2-volc"
+	case "kimi-k3", "kimi-k3-1":
+		return "kimi-k3-1"
+	case "kimi-k2.8", "kimi-k2.8-preview":
+		return "kimi-k2.8-preview"
+	case "kimi-k2.7", "kimi-k2.7-code":
+		return "kimi-k2.7"
+	case "kimi-k2.6":
+		return "kimi-k2.6"
+	case "kimi-k2.5":
+		return "kimi-k2.5"
+	case "kimi-k2-thinking":
+		return "kimi-k2-thinking"
+	case "minimax-m3", "minimax3":
+		return "minimax-m3"
+	case "minimax-m2.5":
+		return "minimax-m2.5"
+	case "glm-5.3", "glm5.3":
+		return "glm-5.3"
+	case "glm-5.3-flash":
+		return "glm-5.3-flash"
+	case "glm-5.2":
+		return "glm-5.2"
+	case "glm-5.1":
+		return "glm-5.1"
+	case "glm-5v-turbo":
+		return "glm-5v-turbo"
+	case "auto", "":
+		return "auto"
+	default:
+		return m
+	}
+}
+
+// PrepareWorkBuddyRequestBody ensures that stream is always true (upstream requirement)
+// and that model is properly normalized.
+func PrepareWorkBuddyRequestBody(payload []byte, model string) ([]byte, error) {
+	if len(payload) == 0 {
+		payload = []byte("{}")
+	}
+
+	normModel := NormalizeWorkBuddyModel(model)
+	if normModel == "" {
+		normModel = "auto"
+	}
+
+	res, errSetModel := sjson.SetBytes(payload, "model", normModel)
+	if errSetModel != nil {
+		return nil, errSetModel
+	}
+
+	// Tencent WorkBuddy requires stream=true for chat completions
+	res, errSetStream := sjson.SetBytes(res, "stream", true)
+	if errSetStream != nil {
+		return nil, errSetStream
+	}
+
+	// Remove parameters that Tencent WorkBuddy does not accept
+	for _, field := range []string{"store", "metadata"} {
+		if gjson.GetBytes(res, field).Exists() {
+			if stripped, errDelete := sjson.DeleteBytes(res, field); errDelete == nil {
+				res = stripped
+			}
+		}
+	}
+
+	// Validate JSON format
+	if !json.Valid(res) {
+		res = []byte("{}")
+	}
+
+	return res, nil
+}
+
+// BuildWorkBuddyAuthHeaders constructs the required headers for upstream Tencent requests.
+func BuildWorkBuddyAuthHeaders(accessToken, uid string) map[string]string {
+	headers := map[string]string{
+		"Authorization": "Bearer " + strings.TrimSpace(accessToken),
+		"X-Product":     WorkBuddyProductHeader,
+		"Origin":        WorkBuddyOrigin,
+		"Referer":       WorkBuddyReferer,
+		"User-Agent":    WorkBuddyUserAgent,
+		"Content-Type":  "application/json",
+	}
+	if trimmedUID := strings.TrimSpace(uid); trimmedUID != "" {
+		headers["X-User-Id"] = trimmedUID
+	}
+	return headers
+}
