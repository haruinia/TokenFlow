@@ -0,0 +1,110 @@
+package doubao
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+)
+
+func TestDoubaoTokenStorage_Serialization(t *testing.T) {
+	tempDir := t.TempDir()
+
+	storage := &DoubaoTokenStorage{
+		AccessToken: "test-ark-key",
+		TokenType:   "Bearer",
+		BaseURL:     DefaultArkEndpoint,
+		Type:        "doubao",
+		Provider:    "doubao",
+		Email:       "test@example.com",
+	}
+
+	filePath := filepath.Join(tempDir, "doubao-test.json")
+	if errSave := storage.SaveTokenToFile(filePath); errSave != nil {
+		t.Fatalf("SaveTokenToFile failed: %v", errSave)
+	}
+
+	if storage.IsExpired() {
+		t.Errorf("IsExpired() = true, want false")
+	}
+	if storage.NeedsRefresh() {
+		t.Errorf("NeedsRefresh() = true, want false")
+	}
+
+	// Test SaveToken with email
+	if errSaveDir := storage.SaveToken(tempDir); errSaveDir != nil {
+		t.Fatalf("SaveToken failed: %v", errSaveDir)
+	}
+}
+
+func TestDoubaoTokenStorage_NeedsRefresh(t *testing.T) {
+	storage := &DoubaoTokenStorage{
+		AccessToken:  "valid-jwt",
+		RefreshToken: "valid-refresh",
+		ExpiresAt:    time.Now().Add(2 * time.Minute).Unix(),
+	}
+
+	if !storage.NeedsRefresh() {
+		t.Errorf("NeedsRefresh() = false, want true for token expiring in 2 minutes")
+	}
+
+	storage.ExpiresAt = time.Now().Add(10 * time.Minute).Unix()
+	if storage.NeedsRefresh() {
+		t.Errorf("NeedsRefresh() = true, want false for token expiring in 10 minutes")
+	}
+}
+
+func TestDoubaoAuth_GenerateAuthSession(t *testing.T) {
+	url, state, err := GenerateAuthSession()
+	if err != nil {
+		t.Fatalf("GenerateAuthSession() failed: %v", err)
+	}
+	if state == "" {
+		t.Errorf("GenerateAuthSession() returned empty state")
+	}
+	if !strings.Contains(url, "marscode.cn/authorization") {
+		t.Errorf("GenerateAuthSession() url %q does not contain marscode.cn", url)
+	}
+	if !strings.Contains(url, state) {
+		t.Errorf("GenerateAuthSession() url %q does not contain state %q", url, state)
+	}
+}
+
+func TestDoubaoAuth_VerifyAPIKey(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		auth := r.Header.Get("Authorization")
+		if auth == "Bearer valid-key" {
+			w.WriteHeader(http.StatusOK)
+			_, _ = w.Write([]byte(`{"data":[{"id":"doubao-1.5-pro-32k"}]}`))
+			return
+		}
+		w.WriteHeader(http.StatusUnauthorized)
+		_, _ = w.Write([]byte(`{"error":{"message":"invalid token"}}`))
+	}))
+	defer server.Close()
+
+	auth := &DoubaoAuth{
+		cfg:        &config.Config{},
+		httpClient: server.Client(),
+	}
+
+	// Test valid key
+	data, errValid := auth.VerifyAPIKey(context.Background(), "valid-key", server.URL)
+	if errValid != nil {
+		t.Fatalf("VerifyAPIKey with valid-key failed: %v", errValid)
+	}
+	if data.AccessToken != "valid-key" {
+		t.Errorf("AccessToken = %s, want valid-key", data.AccessToken)
+	}
+
+	// Test invalid key
+	_, errInvalid := auth.VerifyAPIKey(context.Background(), "wrong-key", server.URL)
+	if errInvalid == nil {
+		t.Errorf("VerifyAPIKey with wrong-key should have failed, but succeeded")
+	}
+}
diff --git a/internal/auth/doubao/token.go b/internal/auth/doubao/token.go
new file mode 100644
index 00000000..f611159f
--- /dev/null
+++ b/internal/auth/doubao/token.go
@@ -0,0 +1,166 @@
+// Package doubao provides authentication and token management functionality
+// for ByteDance Doubao / Volcano Engine Ark (火山引擎方舟) AI services.
+package doubao
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/misc"
+	log "github.com/sirupsen/logrus"
+)
+
+const (
+	// DefaultArkEndpoint is the standard Volcano Engine Ark inference endpoint.
+	DefaultArkEndpoint = "https://ark.cn-beijing.volces.com/api/v3"
+	// refreshThresholdSeconds is when to refresh token before expiry (5 minutes).
+	refreshThresholdSeconds = 300
+)
+
+// DoubaoTokenStorage stores token information for Doubao API authentication.
+type DoubaoTokenStorage struct {
+	// AccessToken is the JWT bearer token or Volcano Engine Ark API Key.
+	AccessToken string `json:"access_token"`
+	// RefreshToken is the refresh token if provided.
+	RefreshToken string `json:"refresh_token,omitempty"`
+	// TokenType is typically "Bearer".
+	TokenType string `json:"token_type"`
+	// Expired is the RFC3339 timestamp when the access token expires.
+	Expired string `json:"expired,omitempty"`
+	// ExpiresAt is the Unix timestamp in seconds or milliseconds.
+	ExpiresAt int64 `json:"expires_at,omitempty"`
+	// RefreshExpiredAt is the RFC3339 expiration time for the refresh token.
+	RefreshExpiredAt string `json:"refresh_expired_at,omitempty"`
+	// Host is the Doubao/MarsCode backend host URL.
+	Host string `json:"host,omitempty"`
+	// BaseURL is the custom or default inference endpoint.
+	BaseURL string `json:"base_url,omitempty"`
+	// UserID is the ByteDance account user ID.
+	UserID string `json:"user_id,omitempty"`
+	// UID is the legacy user identifier.
+	UID string `json:"uid,omitempty"`
+	// Email is the account email or handle.
+	Email string `json:"email,omitempty"`
+	// Username is the account display name.
+	Username string `json:"username,omitempty"`
+	// Region specifies the region code.
+	Region string `json:"region,omitempty"`
+	// Provider specifies the provider name, always "doubao".
+	Provider string `json:"provider,omitempty"`
+	// Type indicates the authentication provider type, always "doubao".
+	Type string `json:"type"`
+
+	// Metadata holds arbitrary key-value pairs injected via hooks.
+	Metadata map[string]any `json:"-"`
+}
+
+// SetMetadata allows external callers to inject metadata into the storage before saving.
+func (ts *DoubaoTokenStorage) SetMetadata(meta map[string]any) {
+	ts.Metadata = meta
+}
+
+// DoubaoTokenData holds raw token information from Doubao authentication.
+type DoubaoTokenData struct {
+	AccessToken      string `json:"token"`
+	RefreshToken     string `json:"refreshToken,omitempty"`
+	ExpiredAt        string `json:"expiredAt,omitempty"`
+	RefreshExpiredAt string `json:"refreshExpiredAt,omitempty"`
+	UserID           string `json:"userId,omitempty"`
+	Host             string `json:"host,omitempty"`
+	BaseURL          string `json:"base_url,omitempty"`
+	TokenType        string `json:"token_type,omitempty"`
+	ExpiresAt        int64  `json:"expires_at,omitempty"`
+	UID              string `json:"uid,omitempty"`
+	Account          struct {
+		Username  string `json:"username,omitempty"`
+		Email     string `json:"email,omitempty"`
+		AvatarURL string `json:"avatar_url,omitempty"`
+	} `json:"account,omitempty"`
+}
+
+// SaveTokenToFile serializes the Doubao token storage to a JSON file.
+func (ts *DoubaoTokenStorage) SaveTokenToFile(authFilePath string) error {
+	misc.LogSavingCredentials(authFilePath)
+	ts.Type = "doubao"
+	if ts.Provider == "" {
+		ts.Provider = "doubao"
+	}
+	if ts.TokenType == "" {
+		ts.TokenType = "Bearer"
+	}
+	if ts.Host == "" && ts.BaseURL == "" {
+		ts.Host = "https://api.marscode.cn"
+	}
+
+	if err := os.MkdirAll(filepath.Dir(authFilePath), 0700); err != nil {
+		return fmt.Errorf("failed to create directory: %w", err)
+	}
+
+	data, errMerge := misc.MergeMetadata(ts, ts.Metadata)
+	if errMerge != nil {
+		return fmt.Errorf("failed to merge metadata: %w", errMerge)
+	}
+
+	f, err := os.Create(authFilePath)
+	if err != nil {
+		return fmt.Errorf("failed to create token file: %w", err)
+	}
+	defer func() {
+		if errClose := f.Close(); errClose != nil {
+			log.Errorf("doubao token storage: close token file error: %v", errClose)
+		}
+	}()
+
+	encoder := json.NewEncoder(f)
+	encoder.SetIndent("", "  ")
+	if err = encoder.Encode(data); err != nil {
+		return fmt.Errorf("failed to write token to file: %w", err)
+	}
+	return nil
+}
+
+// SaveToken persists the Doubao token storage to a JSON file in authDir.
+func (ts *DoubaoTokenStorage) SaveToken(authDir string) error {
+	filename := "doubao.json"
+	if ts.Email != "" {
+		sanitized := strings.ReplaceAll(ts.Email, "@", "_")
+		sanitized = strings.ReplaceAll(sanitized, "/", "_")
+		filename = fmt.Sprintf("doubao-%s.json", sanitized)
+	} else if ts.UserID != "" {
+		filename = fmt.Sprintf("doubao-%s.json", ts.UserID)
+	} else if ts.UID != "" {
+		filename = fmt.Sprintf("doubao-%s.json", ts.UID)
+	} else {
+		filename = fmt.Sprintf("doubao-%d.json", time.Now().UnixMilli())
+	}
+
+	authFilePath := filepath.Join(authDir, filename)
+	return ts.SaveTokenToFile(authFilePath)
+}
+
+// IsExpired checks if the token has expired.
+func (ts *DoubaoTokenStorage) IsExpired() bool {
+	if ts.Expired != "" {
+		expTime, err := time.Parse(time.RFC3339, ts.Expired)
+		if err == nil {
+			return time.Until(expTime) <= time.Duration(refreshThresholdSeconds)*time.Second
+		}
+	}
+	if ts.ExpiresAt > 0 {
+		expTime := time.Unix(ts.ExpiresAt, 0)
+		return time.Until(expTime) <= time.Duration(refreshThresholdSeconds)*time.Second
+	}
+	return false
+}
+
+// NeedsRefresh checks if the token should be refreshed.
+func (ts *DoubaoTokenStorage) NeedsRefresh() bool {
+	if ts.RefreshToken == "" {
+		return false
+	}
+	return ts.IsExpired()
+}
diff --git a/internal/auth/qoder/qoder.go b/internal/auth/qoder/qoder.go
