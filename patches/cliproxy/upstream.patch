+func TestGeneratePKCE(t *testing.T) {
+	verifier, challenge, err := generatePKCE()
+	if err != nil {
+		t.Fatalf("generatePKCE() error = %v", err)
+	}
+	if len(verifier) < 43 {
+		t.Errorf("generatePKCE() verifier length = %d, want >= 43", len(verifier))
+	}
+	if len(challenge) < 43 {
+		t.Errorf("generatePKCE() challenge length = %d, want >= 43", len(challenge))
+	}
