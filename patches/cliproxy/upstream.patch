+func (h *Handler) RequestZCodeToken(c *gin.Context) {
+	ctx := context.Background()
+	ctx = PopulateAuthContext(ctx, c)
+
+	fmt.Println("Initializing ZCode authentication...")
+
+	// Also support direct token import if token is passed in body or query
+	type zcodeInput struct {
+		Token        string `json:"token"`
+		AccessToken  string `json:"access_token"`
+		APIKey       string `json:"api_key"`
+		RefreshToken string `json:"refresh_token"`
+		UID          string `json:"uid"`
+		Email        string `json:"email"`
+		JWT          string `json:"jwt"`
+	}
+	var in zcodeInput
+	if c.Request.ContentLength > 0 {
+		_ = c.ShouldBindJSON(&in)
+	}
+	token := strings.TrimSpace(in.Token)
+	if token == "" {
+		token = strings.TrimSpace(in.AccessToken)
+	}
+	if token == "" {
+		token = strings.TrimSpace(in.APIKey)
+	}
+	if token == "" {
+		token = strings.TrimSpace(c.Query("token"))
+	}
+	if token == "" {
+		token = strings.TrimSpace(c.Query("api_key"))
+	}
+
+	if token != "" {
+		storage := &zcode.ZCodeTokenStorage{
+			AccessToken:  token,
+			RefreshToken: strings.TrimSpace(in.RefreshToken),
+			TokenType:    "Bearer",
+			UID:          strings.TrimSpace(in.UID),
+			Email:        strings.TrimSpace(in.Email),
+			JWT:          strings.TrimSpace(in.JWT),
+			Provider:     "zai",
+			Type:         "zcode",
+		}
+		label := "ZCode"
+		if storage.Email != "" {
+			label = fmt.Sprintf("ZCode (%s)", storage.Email)
+		} else if storage.UID != "" {
+			label = fmt.Sprintf("ZCode (%s)", storage.UID)
+		}
+
+		fileName := fmt.Sprintf("zcode-%d.json", time.Now().UnixMilli())
+		record := &coreauth.Auth{
+			ID:       fileName,
+			Provider: "zcode",
+			FileName: fileName,
+			Label:    label,
+			Storage:  storage,
+			Metadata: map[string]any{
+				"type":         "zcode",
+				"access_token": token,
+				"provider":     "zai",
+				"timestamp":    time.Now().UnixMilli(),
+			},
+		}
+		if storage.Email != "" {
+			record.Metadata["email"] = storage.Email
+		}
+		if storage.UID != "" {
+			record.Metadata["uid"] = storage.UID
+		}
+		if storage.JWT != "" {
+			record.Metadata["jwt"] = storage.JWT
+		}
+
+		savedPath, errSave := h.saveTokenRecord(ctx, record)
+		if errSave != nil {
+			c.JSON(http.StatusInternalServerError, gin.H{"error": "failed to save authentication tokens"})
+			return
+		}
+		c.JSON(http.StatusOK, gin.H{
+			"status":     "ok",
+			"saved_path": savedPath,
+			"file_name":  fileName,
+			"label":      label,
+		})
+		return
+	}
+
+	state, errState := misc.GenerateRandomState()
+	if errState != nil {
+		log.Errorf("Failed to generate state parameter: %v", errState)
+		c.JSON(http.StatusInternalServerError, gin.H{"error": "failed to generate state parameter"})
+		return
+	}
+
+	redirectURI, errTarget := h.managementCallbackURL("/zcode/callback")
+	if errTarget != nil {
+		log.WithError(errTarget).Error("failed to compute zcode callback target")
+		c.JSON(http.StatusInternalServerError, gin.H{"error": "callback URL computation failed"})
+		return
+	}
+
+	zcAuth := zcode.NewZCodeAuth(h.cfg)
+	authURL, errURL := zcAuth.GenerateAuthURL(redirectURI, state)
+	if errURL != nil {
+		log.Errorf("Failed to generate ZCode authorization URL: %v", errURL)
+		c.JSON(http.StatusInternalServerError, gin.H{"error": "failed to generate authorization url"})
+		return
+	}
+
+	RegisterOAuthSession(state, "zcode")
+
+	go func() {
+		// Wait for callback file (.oauth-zcode-<state>.oauth)
+		waitFile := filepath.Join(h.cfg.AuthDir, fmt.Sprintf(".oauth-zcode-%s.oauth", state))
+		deadline := time.Now().Add(5 * time.Minute)
+		var code string
+		for {
+			if !IsOAuthSessionPending(state, "zcode") {
+				return
+			}
+			if time.Now().After(deadline) {
+				SetOAuthSessionError(state, "Timeout waiting for OAuth callback")
+				return
+			}
+			if data, errR := os.ReadFile(waitFile); errR == nil {
+				var m map[string]string
+				_ = json.Unmarshal(data, &m)
+				_ = os.Remove(waitFile)
+				if errStr := m["error"]; errStr != "" {
+					SetOAuthSessionError(state, "Authorization failed: "+errStr)
+					return
+				}
+				if m["state"] != state {
+					SetOAuthSessionError(state, "State code mismatch")
+					return
+				}
+				code = m["code"]
+				break
+			}
+			time.Sleep(500 * time.Millisecond)
+		}
+
+		log.Debug("ZCode authorization code received, exchanging for tokens...")
+		storage, errExchange := zcAuth.ExchangeCodeForTokens(ctx, code, state, redirectURI)
+		if errExchange != nil {
+			SetOAuthSessionError(state, oauthSessionErrorWithCause("Failed to exchange authorization code for tokens", errExchange))
+			log.Errorf("Failed to exchange ZCode authorization code for tokens: %v", errExchange)
+			return
+		}
+
+		metadata := map[string]any{
+			"type":         "zcode",
+			"access_token": storage.AccessToken,
+			"provider":     storage.Provider,
+			"timestamp":    time.Now().UnixMilli(),
+		}
+		if storage.UID != "" {
+			metadata["uid"] = storage.UID
+		}
+		if storage.Email != "" {
+			metadata["email"] = storage.Email
+		}
+		if storage.JWT != "" {
+			metadata["jwt"] = storage.JWT
+		}
+		if storage.Expired != "" {
+			metadata["expired"] = storage.Expired
+		}
+
+		label := "ZCode"
+		if storage.Email != "" {
+			label = fmt.Sprintf("ZCode (%s)", storage.Email)
+		} else if storage.UID != "" {
+			label = fmt.Sprintf("ZCode (%s)", storage.UID)
+		}
+
+		fileName := fmt.Sprintf("zcode-%d.json", time.Now().UnixMilli())
+		record := &coreauth.Auth{
+			ID:       fileName,
+			Provider: "zcode",
+			FileName: fileName,
+			Label:    label,
+			Storage:  storage,
+			Metadata: metadata,
+		}
+
+		if errGuard := guardOAuthSessionPendingForSave(state, "zcode"); errGuard != nil {
+			return
+		}
+		savedPath, errSave := h.saveTokenRecord(ctx, record)
+		if errSave != nil {
+			log.Errorf("Failed to save ZCode tokens: %v", errSave)
+			SetOAuthSessionError(state, "Failed to save authentication tokens")
+			return
+		}
+
+		fmt.Printf("ZCode authentication successful! Token saved to %s\n", savedPath)
+		CompleteOAuthSession(state)
+	}()
+
+	c.JSON(http.StatusOK, gin.H{
+		"status": "ok",
+		"url":    authURL,
+		"state":  state,
+		"flow":   "oauth",
+	})
+}
