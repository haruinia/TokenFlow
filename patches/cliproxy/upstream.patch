index 00000000..297e2a32
--- /dev/null
+++ b/internal/auth/qoder/qoder.go
@@ -0,0 +1,699 @@
+// Package qoder provides authentication and token management for Alibaba Qoder API.
+// It handles OAuth2 PKCE device flow and Personal Access Token (PAT) authentication.
+package qoder
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"runtime"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/google/uuid"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/buildinfo"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/util"
+	log "github.com/sirupsen/logrus"
+	"golang.org/x/sync/singleflight"
+)
+
+const (
+	// QoderOAuthHost is the main Qoder web frontend domain.
+	QoderOAuthHost = "https://qoder.com"
+	// QoderLoginSelectAccountsURL is the account authorization page.
+	QoderLoginSelectAccountsURL = QoderOAuthHost + "/device/selectAccounts"
+	// QoderOpenAPIHost is the OpenAPI endpoint for device flow and user status.
+	QoderOpenAPIHost = "https://openapi.qoder.sh"
+	// QoderPollDeviceTokenURL is the polling endpoint for device tokens.
+	QoderPollDeviceTokenURL = QoderOpenAPIHost + "/api/v1/deviceToken/poll"
+	// QoderRefreshDeviceTokenURL is the token refresh endpoint.
+	QoderRefreshDeviceTokenURL = QoderOpenAPIHost + "/api/v1/deviceToken/refresh"
+	// QoderJobTokenExchangeURL is the PAT exchange endpoint.
+	QoderJobTokenExchangeURL = QoderOpenAPIHost + "/api/v1/jobToken/exchange"
+	// QoderQuotaUsageURL is the quota usage status endpoint.
+	QoderQuotaUsageURL = QoderOpenAPIHost + "/api/v2/quota/usage"
+	// QoderDefaultInferenceURL is the default OpenAI-compatible inference base URL.
+	QoderDefaultInferenceURL = "https://api2.qoder.sh"
+	// QoderClientID is the official client ID for device authorization.
+	QoderClientID = "e883ade2-e6e3-4d6d-adf7-f92ceff5fdcb"
+	// defaultPollInterval is the interval for polling token endpoint (1 second per spec).
+	defaultPollInterval = 1 * time.Second
+	// maxPollDuration is the maximum time to wait for user authorization (5 minutes per spec).
+	maxPollDuration = 5 * time.Minute
+)
+
+var qoderRefreshGroup singleflight.Group
+
+// QoderAuth handles Qoder authentication flows.
+type QoderAuth struct {
+	client *DeviceFlowClient
+	cfg    *config.Config
+}
+
+// NewQoderAuth creates a new QoderAuth service instance.
+func NewQoderAuth(cfg *config.Config) *QoderAuth {
+	return &QoderAuth{
+		client: NewDeviceFlowClient(cfg),
+		cfg:    cfg,
+	}
+}
+
+// StartDeviceFlow initiates the PKCE device authorization flow.
+func (q *QoderAuth) StartDeviceFlow(ctx context.Context) (*DeviceFlowSession, error) {
+	return q.client.StartDeviceFlow(ctx)
+}
+
+// WaitForAuthorization polls until the user authorizes or the flow times out.
+func (q *QoderAuth) WaitForAuthorization(ctx context.Context, session *DeviceFlowSession) (*QoderAuthBundle, error) {
+	tokenData, err := q.client.PollForToken(ctx, session)
+	if err != nil {
+		return nil, err
+	}
+	return &QoderAuthBundle{
+		TokenData: tokenData,
+		MachineID: q.client.machineID,
+	}, nil
+}
+
+// VerifyPAT validates a personal access token by probing the quota endpoint.
+func (q *QoderAuth) VerifyPAT(ctx context.Context, pat string) (*QoderAuthBundle, error) {
+	tokenData, err := q.client.VerifyPAT(ctx, pat)
+	if err != nil {
+		return nil, err
+	}
+	return &QoderAuthBundle{
+		TokenData: tokenData,
+		MachineID: q.client.machineID,
+	}, nil
+}
+
+// WithMachineID reuses the machine identifier the account was authorized with.
+// Qoder sends it on every token request; a fresh random ID per refresh looks like a new device.
+func (q *QoderAuth) WithMachineID(machineID string) *QoderAuth {
+	if id := strings.TrimSpace(machineID); id != "" {
+		q.client.machineID = id
+	}
+	return q
+}
+
+// RefreshToken exchanges an existing refresh token for a new access token.
+func (q *QoderAuth) RefreshToken(ctx context.Context, refreshToken string) (*QoderTokenData, error) {
+	return q.client.RefreshToken(ctx, refreshToken)
+}
+
+// CreateTokenStorage builds a persistent QoderTokenStorage from an auth bundle.
+func (q *QoderAuth) CreateTokenStorage(bundle *QoderAuthBundle) *QoderTokenStorage {
+	if bundle == nil || bundle.TokenData == nil {
+		return &QoderTokenStorage{Type: "qoder"}
+	}
+	expired := ""
+	if bundle.TokenData.ExpiresAt > 0 {
+		expired = time.Unix(bundle.TokenData.ExpiresAt, 0).UTC().Format(time.RFC3339)
+	}
+	tokenType := bundle.TokenData.TokenType
+	if tokenType == "" {
+		tokenType = "Bearer"
+	}
+	return &QoderTokenStorage{
+		AccessToken:  bundle.TokenData.AccessToken,
+		RefreshToken: bundle.TokenData.RefreshToken,
+		TokenType:    tokenType,
+		Expired:      expired,
+		UID:          bundle.TokenData.UID,
+		Email:        bundle.TokenData.Email,
+		Type:         "qoder",
+	}
+}
+
+// DeviceFlowClient handles network communication with Qoder authentication endpoints.
+type DeviceFlowClient struct {
+	httpClient *http.Client
+	cfg        *config.Config
+	machineID  string
+	apiBaseURL string
+}
+
+// NewDeviceFlowClient creates a new device flow client.
+func NewDeviceFlowClient(cfg *config.Config) *DeviceFlowClient {
+	return NewDeviceFlowClientWithProxy(cfg, "")
+}
+
+// NewDeviceFlowClientWithProxy creates a new client with an optional proxy URL override.
+func NewDeviceFlowClientWithProxy(cfg *config.Config, proxyURL string) *DeviceFlowClient {
+	client := &http.Client{Timeout: 30 * time.Second}
+	effectiveProxyURL := strings.TrimSpace(proxyURL)
+	var sdkCfg config.SDKConfig
+	if cfg != nil {
+		sdkCfg = cfg.SDKConfig
+		if effectiveProxyURL == "" {
+			effectiveProxyURL = strings.TrimSpace(cfg.ProxyURL)
+		}
+	}
+	sdkCfg.ProxyURL = effectiveProxyURL
+	client = util.SetProxy(&sdkCfg, client)
+
+	return &DeviceFlowClient{
+		httpClient: client,
+		cfg:        cfg,
+		machineID:  getOrCreateMachineID(),
+		apiBaseURL: QoderOpenAPIHost,
+	}
+}
+
+func (c *DeviceFlowClient) pollURL() string {
+	base := strings.TrimRight(c.apiBaseURL, "/")
+	if base == "" {
+		base = QoderOpenAPIHost
+	}
+	return base + "/api/v1/deviceToken/poll"
+}
+
+func (c *DeviceFlowClient) refreshURL() string {
+	base := strings.TrimRight(c.apiBaseURL, "/")
+	if base == "" {
+		base = QoderOpenAPIHost
+	}
