+	"path/filepath"
+	"testing"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/config"
+)
+
+func TestZCodeTokenStorage_Serialization(t *testing.T) {
+	tempDir := t.TempDir()
+
+	storage := &ZCodeTokenStorage{
+		AccessToken: "test-access-token",
+		TokenType:   "Bearer",
+		UID:         "user-123",
+		Provider:    "zai",
+		Type:        "zcode",
+		Expired:     time.Now().Add(1 * time.Hour).UTC().Format(time.RFC3339),
+	}
+
+	filePath := filepath.Join(tempDir, "zcode-test.json")
+	if errSave := storage.SaveTokenToFile(filePath); errSave != nil {
+		t.Fatalf("SaveTokenToFile failed: %v", errSave)
+	}
+
+	if storage.IsExpired() {
+		t.Errorf("IsExpired() = true, want false")
+	}
+	if storage.NeedsRefresh() {
+		t.Errorf("NeedsRefresh() = true, want false")
+	}
+}
+
+func TestZCodeAuth_DeviceFlowMock(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		if r.Method == http.MethodPost {
+			w.WriteHeader(http.StatusOK)
+			_, _ = w.Write([]byte(`{"code":200,"data":{"url":"https://chat.z.ai/auth","flow_id":"flow-123","poll_interval":1,"expires_in":60}}`))
+			return
+		}
+		if r.Method == http.MethodGet {
+			w.WriteHeader(http.StatusOK)
+			_, _ = w.Write([]byte(`{"code":200,"data":{"status":"ready","access_token":"mock-token","user_id":"u-999"}}`))
+			return
+		}
+		http.NotFound(w, r)
+	}))
+	defer server.Close()
+
+	auth := &ZCodeAuth{
+		cfg:        &config.Config{},
+		httpClient: server.Client(),
+	}
+
+	req, _ := http.NewRequestWithContext(context.Background(), http.MethodGet, server.URL, nil)
+	resp, errDo := auth.httpClient.Do(req)
+	if errDo != nil {
+		t.Fatalf("Do request failed: %v", errDo)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		t.Errorf("StatusCode = %d, want 200", resp.StatusCode)
+	}
+}
+
+func TestZCodeAuth_GenerateAuthURL(t *testing.T) {
+	auth := NewZCodeAuth(&config.Config{})
+	redirectURI := "http://127.0.0.1:8318/zcode/callback"
+	state := "test-state-123456"
+
+	u, err := auth.GenerateAuthURL(redirectURI, state)
+	if err != nil {
+		t.Fatalf("GenerateAuthURL failed: %v", err)
+	}
+	if u == "" {
+		t.Fatal("GenerateAuthURL returned empty string")
+	}
+	if !testing.Short() {
+		t.Logf("Auth URL: %s", u)
+	}
+
+	// Verify auto-generated state when empty
+	u2, err2 := GenerateAuthURL(redirectURI, "")
+	if err2 != nil {
+		t.Fatalf("GenerateAuthURL with empty state failed: %v", err2)
+	}
+	if u2 == "" {
+		t.Fatal("GenerateAuthURL with empty state returned empty string")
+	}
+}
+
+func TestZCodeAuth_ExchangeCodeForTokens(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch r.URL.Path {
+		case "/token":
+			w.WriteHeader(http.StatusOK)
+			_, _ = w.Write([]byte(`{
+				"code": 0,
+				"data": {
+					"zai": {
+						"access_token": "zai-access-123",
+						"refresh_token": "zai-refresh-456",
+						"expires_in": 3600
+					},
+					"user": {
+						"id": "u-12345",
+						"email": "test@z.ai"
+					}
+				}
+			}`))
+		case "/login":
+			w.WriteHeader(http.StatusOK)
+			_, _ = w.Write([]byte(`{
+				"code": 0,
+				"data": {
+					"access_token": "business-jwt-789"
+				}
+			}`))
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	defer server.Close()
+
+	auth := &ZCodeAuth{
+		cfg:        &config.Config{},
+		httpClient: server.Client(),
+	}
+	_ = auth
+
+	// Test with local callback server
+	cbServer, actualPort, errCb := StartLocalCallbackServer(0)
+	if errCb != nil {
+		t.Fatalf("StartLocalCallbackServer failed: %v", errCb)
+	}
+	defer func() {
+		_ = cbServer.Stop(context.Background())
+	}()
+
+	if actualPort <= 0 {
+		t.Fatalf("expected actualPort > 0, got %d", actualPort)
+	}
+}
