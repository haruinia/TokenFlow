diff --git a/internal/registry/model_updater_test.go b/internal/registry/model_updater_test.go
new file mode 100644
index 00000000..387c6dd2
--- /dev/null
+++ b/internal/registry/model_updater_test.go
@@ -0,0 +1,87 @@
+package registry
+
+import "testing"
+
+func TestMergeRemoteModelsCatalogKeepsLocalOnlyProviders(t *testing.T) {
+	local := &staticModelsJSON{
+		Kimi:      []*ModelInfo{{ID: "kimi-local"}},
+		Qoder:     []*ModelInfo{{ID: "qoder-local"}},
+		WorkBuddy: []*ModelInfo{{ID: "wb-local"}},
+	}
+	remote := &staticModelsJSON{
+		Kimi: []*ModelInfo{{ID: "kimi-remote"}},
+	}
+
+	merged := mergeRemoteModelsCatalog(local, remote)
+	if merged == nil {
+		t.Fatal("mergeRemoteModelsCatalog returned nil")
+	}
+	if got := modelIDs(merged.Kimi); len(got) != 1 || got[0] != "kimi-remote" {
+		t.Fatalf("kimi = %v, want [kimi-remote]", got)
+	}
+	if got := modelIDs(merged.Qoder); len(got) != 1 || got[0] != "qoder-local" {
+		t.Fatalf("qoder = %v, want [qoder-local]", got)
+	}
+	if got := modelIDs(merged.WorkBuddy); len(got) != 1 || got[0] != "wb-local" {
+		t.Fatalf("workbuddy = %v, want [wb-local]", got)
+	}
+}
+
+func TestMergeRemoteModelsCatalogPrefersRemoteWhenPresent(t *testing.T) {
+	local := &staticModelsJSON{WorkBuddy: []*ModelInfo{{ID: "wb-local"}}}
+	remote := &staticModelsJSON{WorkBuddy: []*ModelInfo{{ID: "wb-remote"}}}
+
+	merged := mergeRemoteModelsCatalog(local, remote)
+	if got := modelIDs(merged.WorkBuddy); len(got) != 1 || got[0] != "wb-remote" {
+		t.Fatalf("workbuddy = %v, want [wb-remote]", got)
+	}
+}
+
+func TestDetectChangedProvidersIncludesLocalOnlyProviders(t *testing.T) {
+	oldData := &staticModelsJSON{WorkBuddy: []*ModelInfo{{ID: "wb-1"}}}
+	newData := &staticModelsJSON{WorkBuddy: []*ModelInfo{{ID: "wb-2"}}}
+
+	changed := detectChangedProviders(oldData, newData)
+	if !containsProvider(changed, "workbuddy") {
+		t.Fatalf("changed = %v, want workbuddy", changed)
+	}
+}
+
+func TestDetectChangedProvidersAfterMergeDoesNotFlagPreservedProviders(t *testing.T) {
+	local := &staticModelsJSON{
+		Kimi:      []*ModelInfo{{ID: "kimi-local"}},
+		WorkBuddy: []*ModelInfo{{ID: "wb-local"}},
+	}
+	remote := &staticModelsJSON{
+		Kimi: []*ModelInfo{{ID: "kimi-remote"}},
+	}
+
+	merged := mergeRemoteModelsCatalog(local, remote)
+	changed := detectChangedProviders(local, merged)
+	if containsProvider(changed, "workbuddy") {
+		t.Fatalf("changed = %v, preserved workbuddy should not be reported", changed)
+	}
+	if !containsProvider(changed, "kimi") {
+		t.Fatalf("changed = %v, want kimi", changed)
+	}
+}
+
+func modelIDs(models []*ModelInfo) []string {
+	ids := make([]string, 0, len(models))
+	for _, model := range models {
+		if model == nil {
+			continue
+		}
+		ids = append(ids, model.ID)
+	}
+	return ids
+}
+
+func containsProvider(providers []string, want string) bool {
+	for _, provider := range providers {
+		if provider == want {
+			return true
+		}
+	}
+	return false
+}
