+// StartDeviceFlow generates the PKCE parameters and authorization URL.
+func (c *DeviceFlowClient) StartDeviceFlow(_ context.Context) (*DeviceFlowSession, error) {
+	verifier, challenge, err := generatePKCE()
+	if err != nil {
+		return nil, fmt.Errorf("qoder: failed to generate PKCE challenge: %w", err)
+	}
+
+	nonce := uuid.New().String()
+
+	v := url.Values{}
+	v.Set("challenge", challenge)
+	v.Set("challenge_method", "S256")
+	v.Set("nonce", nonce)
+	v.Set("machine_id", c.machineID)
+	v.Set("client_id", QoderClientID)
+
+	authURL := fmt.Sprintf("%s?%s", QoderLoginSelectAccountsURL, v.Encode())
+
+	return &DeviceFlowSession{
+		VerificationURI: authURL,
+		Nonce:           nonce,
+		CodeVerifier:    verifier,
+		ExpiresIn:       int(maxPollDuration.Seconds()),
+		Interval:        int(defaultPollInterval.Seconds()),
+	}, nil
+}
+
+// PollForToken polls the Qoder device token endpoint until approved or expired.
+func (c *DeviceFlowClient) PollForToken(ctx context.Context, session *DeviceFlowSession) (*QoderTokenData, error) {
+	if session == nil {
+		return nil, fmt.Errorf("qoder: device flow session is nil")
+	}
+
+	interval := time.Duration(session.Interval) * time.Second
+	if interval < defaultPollInterval {
+		interval = defaultPollInterval
+	}
+
+	deadline := time.Now().Add(maxPollDuration)
+	if session.ExpiresIn > 0 {
+		expDeadline := time.Now().Add(time.Duration(session.ExpiresIn) * time.Second)
+		if expDeadline.Before(deadline) {
+			deadline = expDeadline
+		}
+	}
+
+	ticker := time.NewTicker(interval)
+	defer ticker.Stop()
+
+	for {
+		select {
+		case <-ctx.Done():
+			return nil, fmt.Errorf("qoder: context cancelled: %w", ctx.Err())
+		case <-ticker.C:
+			if time.Now().After(deadline) {
+				return nil, fmt.Errorf("qoder: authorization timed out")
+			}
+
+			tokenData, err, shouldContinue := c.pollAttempt(ctx, session.Nonce, session.CodeVerifier)
+			if tokenData != nil {
+				return tokenData, nil
+			}
+			if !shouldContinue {
+				return nil, err
+			}
+		}
+	}
+}
+
+type rawTokenResponse struct {
+	Success            bool            `json:"success"`
+	Token              string          `json:"token"`
+	AccessToken        string          `json:"access_token"`
+	AccessTokenCamel   string          `json:"accessToken"`
+	DeviceToken        string          `json:"device_token"`
+	DeviceTokenCamel   string          `json:"deviceToken"`
+	SecurityOAuthToken string          `json:"securityOauthToken"`
+	RefreshToken       string          `json:"refresh_token"`
+	RefreshTokenCamel  string          `json:"refreshToken"`
+	ExpiresAt          json.RawMessage `json:"expires_at"`
+	TokenExpireTime    int64           `json:"tokenExpireTime"`
+	UserID             string          `json:"user_id"`
+	UID                string          `json:"uid"`
+	UserName           string          `json:"user_name"`
+	Email              string          `json:"email"`
+	ErrorCode          string          `json:"errorCode"`
+	ErrorMessage       string          `json:"errorMessage"`
+	ErrorMsg           string          `json:"errorMsg"`
+	Data               json.RawMessage `json:"data"`
+}
+
+func parseRawTokenResponse(rawResp []byte) (*QoderTokenData, error) {
+	var resp rawTokenResponse
+	if err := json.Unmarshal(rawResp, &resp); err != nil {
+		return nil, fmt.Errorf("qoder: failed to parse token response: %w", err)
+	}
+
+	// Check if data is nested
+	if len(resp.Data) > 0 && string(resp.Data) != "null" {
+		var nested rawTokenResponse
+		if err := json.Unmarshal(resp.Data, &nested); err == nil {
+			if resp.Token == "" {
+				resp.Token = nested.Token
+			}
+			if resp.AccessToken == "" {
+				resp.AccessToken = nested.AccessToken
+			}
+			if resp.AccessTokenCamel == "" {
+				resp.AccessTokenCamel = nested.AccessTokenCamel
+			}
+			if resp.DeviceToken == "" {
+				resp.DeviceToken = nested.DeviceToken
+			}
+			if resp.DeviceTokenCamel == "" {
+				resp.DeviceTokenCamel = nested.DeviceTokenCamel
+			}
+			if resp.SecurityOAuthToken == "" {
+				resp.SecurityOAuthToken = nested.SecurityOAuthToken
+			}
+			if resp.RefreshToken == "" {
+				resp.RefreshToken = nested.RefreshToken
+			}
+			if resp.RefreshTokenCamel == "" {
+				resp.RefreshTokenCamel = nested.RefreshTokenCamel
+			}
+			if len(resp.ExpiresAt) == 0 || string(resp.ExpiresAt) == "null" {
+				resp.ExpiresAt = nested.ExpiresAt
+			}
+			if resp.TokenExpireTime == 0 {
+				resp.TokenExpireTime = nested.TokenExpireTime
+			}
+			if resp.UserID == "" {
+				resp.UserID = nested.UserID
+			}
+			if resp.UID == "" {
+				resp.UID = nested.UID
+			}
+			if resp.UserName == "" {
+				resp.UserName = nested.UserName
+			}
+			if resp.Email == "" {
+				resp.Email = nested.Email
+			}
+		}
+	}
+
+	token := resp.Token
+	if token == "" {
+		token = resp.AccessToken
+	}
+	if token == "" {
+		token = resp.DeviceToken
+	}
+	if token == "" {
+		token = resp.DeviceTokenCamel
+	}
+	if token == "" {
+		token = resp.AccessTokenCamel
+	}
+	if token == "" {
+		token = resp.SecurityOAuthToken
+	}
+
+	if token == "" {
+		errCode := resp.ErrorCode
+		errMsg := resp.ErrorMessage
+		if errMsg == "" {
+			errMsg = resp.ErrorMsg
+		}
+		if errCode != "" {
+			return nil, fmt.Errorf("qoder: %s: %s", errCode, errMsg)
+		}
+		return nil, fmt.Errorf("qoder: empty token in response")
+	}
+
+	refreshToken := resp.RefreshToken
+	if refreshToken == "" {
+		refreshToken = resp.RefreshTokenCamel
+	}
+
+	uid := resp.UserID
+	if uid == "" {
+		uid = resp.UID
+	}
+	if uid == "" {
+		uid = resp.UserName
+	}
+
+	email := resp.Email
+	if email == "" {
+		email = resp.UserName
+	}
+
+	expiresAt := parseExpiresAt(resp.ExpiresAt, resp.TokenExpireTime)
+
+	return &QoderTokenData{
+		AccessToken:  token,
+		RefreshToken: refreshToken,
+		TokenType:    "Bearer",
+		ExpiresAt:    expiresAt,
+		UID:          uid,
+		Email:        email,
+	}, nil
+}
+
+func parseExpiresAt(raw json.RawMessage, tokenExpireTime int64) int64 {
+	if len(raw) > 0 && string(raw) != "null" {
+		var s string
+		if err := json.Unmarshal(raw, &s); err == nil && s != "" {
+			if t, errTime := time.Parse(time.RFC3339, s); errTime == nil {
+				return t.Unix()
+			}
+			if t, errTime := time.Parse("2006-01-02T15:04:05.999999999Z07:00", s); errTime == nil {
+				return t.Unix()
+			}
+			if num, errNum := strconv.ParseInt(s, 10, 64); errNum == nil {
+				if num > 1000000000000 {
+					return num / 1000
+				}
+				return num
+			}
+		}
+
+		var num int64
+		if err := json.Unmarshal(raw, &num); err == nil && num > 0 {
+			if num > 1000000000000 {
+				return num / 1000
+			}
+			return num
+		}
+	}
+
+	if tokenExpireTime > 0 {
+		if tokenExpireTime > 1000000000000 {
+			return tokenExpireTime / 1000
+		}
+		return tokenExpireTime
+	}
+
+	// Default fallback: 24 hours from now
+	return time.Now().Add(24 * time.Hour).Unix()
+}
+
+func (c *DeviceFlowClient) pollAttempt(ctx context.Context, nonce, verifier string) (*QoderTokenData, error, bool) {
+	u, errParse := url.Parse(c.pollURL())
+	if errParse != nil {
+		return nil, fmt.Errorf("qoder: invalid poll url: %w", errParse), false
+	}
+	q := u.Query()
+	q.Set("nonce", nonce)
+	q.Set("verifier", verifier)
+	q.Set("challenge_method", "S256")
+	u.RawQuery = q.Encode()
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, u.String(), nil)
+	if err != nil {
+		return nil, fmt.Errorf("qoder: failed to create poll request: %w", err), false
+	}
+	req.Header.Set("Accept", "application/json")
+	for k, v := range c.commonHeaders() {
+		req.Header.Set(k, v)
+	}
+
+	resp, err := c.httpClient.Do(req)
+	if err != nil {
+		log.Debugf("qoder: device token poll network transient error: %v", err)
+		return nil, nil, true
+	}
+	defer func() {
+		if errClose := resp.Body.Close(); errClose != nil {
+			log.Errorf("qoder poll: close body error: %v", errClose)
+		}
+	}()
+
+	rawResp, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return nil, nil, true
+	}
+
+	if resp.StatusCode == http.StatusNotFound || resp.StatusCode == http.StatusAccepted {
+		// Authorization still pending (404 is standard pending code in Qoder device flow)
+		return nil, nil, true
+	}
+
+	if resp.StatusCode != http.StatusOK {
+		if resp.StatusCode == http.StatusUnauthorized {
+			return nil, nil, true
+		}
+		return nil, fmt.Errorf("qoder: poll returned unexpected status %d: %s", resp.StatusCode, string(rawResp)), false
+	}
+
+	tokenData, err := parseRawTokenResponse(rawResp)
+	if err != nil {
+		var errResp struct {
+			ErrorCode    string `json:"errorCode"`
+			ErrorMessage string `json:"errorMessage"`
+			ErrorMsg     string `json:"errorMsg"`
+		}
+		if jsonErr := json.Unmarshal(rawResp, &errResp); jsonErr == nil && errResp.ErrorCode != "" {
+			switch strings.ToLower(errResp.ErrorCode) {
+			case "unauthorized", "authorization_pending", "pending", "not_ready", "waiting":
+				return nil, nil, true
+			case "expired", "timeout":
+				return nil, fmt.Errorf("qoder: authorization expired"), false
+			case "access_denied", "rejected":
+				return nil, fmt.Errorf("qoder: access denied by user"), false
+			}
+		}
+		return nil, err, false
+	}
+
+	return tokenData, nil, false
+}
+
+// RefreshToken exchanges an existing refresh token for a new access token using singleflight.
+func (c *DeviceFlowClient) RefreshToken(ctx context.Context, refreshToken string) (*QoderTokenData, error) {
+	if strings.TrimSpace(refreshToken) == "" {
+		return nil, fmt.Errorf("qoder: refresh token is required")
+	}
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	refreshToken = strings.TrimSpace(refreshToken)
+
+	result, err, _ := qoderRefreshGroup.Do(refreshToken, func() (interface{}, error) {
+		return c.refreshTokenSingleFlight(context.WithoutCancel(ctx), refreshToken)
+	})
+	if err != nil {
+		return nil, err
+	}
+	tokenData, ok := result.(*QoderTokenData)
+	if !ok || tokenData == nil {
+		return nil, fmt.Errorf("qoder: refresh failed: invalid singleflight result")
+	}
+	return tokenData, nil
+}
+
+func (c *DeviceFlowClient) refreshTokenSingleFlight(ctx context.Context, refreshToken string) (*QoderTokenData, error) {
+	reqBody := map[string]string{
+		"refresh_token": refreshToken,
+		"refreshToken":  refreshToken,
+	}
+	bodyBytes, err := json.Marshal(reqBody)
+	if err != nil {
+		return nil, fmt.Errorf("qoder: failed to marshal refresh request: %w", err)
+	}
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, c.refreshURL(), bytes.NewReader(bodyBytes))
+	if err != nil {
+		return nil, fmt.Errorf("qoder: failed to create refresh request: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Accept", "application/json")
+	for k, v := range c.commonHeaders() {
+		req.Header.Set(k, v)
+	}
+
+	resp, err := c.httpClient.Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("qoder: refresh request failed: %w", err)
+	}
+	defer func() {
+		if errClose := resp.Body.Close(); errClose != nil {
+			log.Errorf("qoder refresh: close body error: %v", errClose)
+		}
+	}()
+
+	rawResp, err := io.ReadAll(resp.Body)
+	if err != nil {
+		return nil, fmt.Errorf("qoder: failed to read refresh response: %w", err)
+	}
+
+	if resp.StatusCode == http.StatusUnauthorized || resp.StatusCode == http.StatusForbidden {
+		return nil, fmt.Errorf("qoder: refresh token rejected (status %d)", resp.StatusCode)
+	}
+
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("qoder: refresh failed with status %d: %s", resp.StatusCode, string(rawResp))
+	}
+
+	tokenData, err := parseRawTokenResponse(rawResp)
+	if err != nil {
+		return nil, err
+	}
+	if tokenData.RefreshToken == "" {
+		tokenData.RefreshToken = refreshToken
+	}
+
+	return tokenData, nil
+}
+
+// VerifyPAT validates a personal access token by probing exchange or quota endpoint.
+func (c *DeviceFlowClient) VerifyPAT(ctx context.Context, pat string) (*QoderTokenData, error) {
+	pat = strings.TrimSpace(pat)
+	if pat == "" {
+		return nil, fmt.Errorf("qoder: personal access token is empty")
+	}
+
+	// Try jobToken/exchange
+	bodyBytes, _ := json.Marshal(map[string]string{
+		"personal_token": pat,
+		"personalToken":  pat,
+	})
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, c.exchangeURL(), bytes.NewReader(bodyBytes))
+	if err == nil {
+		req.Header.Set("Content-Type", "application/json")
+		req.Header.Set("Accept", "application/json")
+		for k, v := range c.commonHeaders() {
+			req.Header.Set(k, v)
+		}
+		resp, errDo := c.httpClient.Do(req)
+		if errDo == nil {
+			defer func() {
+				_ = resp.Body.Close()
+			}()
+			if resp.StatusCode == http.StatusOK {
+				rawResp, _ := io.ReadAll(resp.Body)
+				tokenData, errParse := parseRawTokenResponse(rawResp)
+				if errParse == nil && tokenData.AccessToken != "" {
+					return tokenData, nil
+				}
+			}
+		}
+	}
+
+	// Fallback to probing quota endpoint directly with PAT
+	return c.verifyPATWithQuota(ctx, pat)
+}
+
+func (c *DeviceFlowClient) verifyPATWithQuota(ctx context.Context, pat string) (*QoderTokenData, error) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, c.quotaURL(), nil)
+	if err != nil {
+		return nil, fmt.Errorf("qoder: failed to create PAT verification request: %w", err)
+	}
+	req.Header.Set("Authorization", "Bearer "+pat)
+	for k, v := range c.commonHeaders() {
+		req.Header.Set(k, v)
+	}
+
+	resp, err := c.httpClient.Do(req)
+	if err != nil {
+		return nil, fmt.Errorf("qoder: PAT verification request failed: %w", err)
+	}
+	defer func() {
+		if errClose := resp.Body.Close(); errClose != nil {
+			log.Errorf("qoder pat verify: close body error: %v", errClose)
+		}
+	}()
+
+	if resp.StatusCode == http.StatusUnauthorized || resp.StatusCode == http.StatusForbidden {
+		return nil, fmt.Errorf("qoder: invalid personal access token (status %d)", resp.StatusCode)
+	}
+
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		body, _ := io.ReadAll(resp.Body)
+		return nil, fmt.Errorf("qoder: PAT verification failed with status %d: %s", resp.StatusCode, string(body))
+	}
+
+	return &QoderTokenData{
+		AccessToken: pat,
+		TokenType:   "Bearer",
+		ExpiresAt:   0, // PAT does not have a known expiration timestamp
+	}, nil
+}
+
+// generatePKCE creates a cryptographic code_verifier and code_challenge pair according to RFC 7636.
+func generatePKCE() (verifier, challenge string, err error) {
+	bytes := make([]byte, 32)
+	if _, err = rand.Read(bytes); err != nil {
+		return "", "", err
+	}
+	verifier = base64.RawURLEncoding.EncodeToString(bytes)
+
+	h := sha256.New()
+	h.Write([]byte(verifier))
+	challenge = base64.RawURLEncoding.EncodeToString(h.Sum(nil))
+
+	return verifier, challenge, nil
+}
