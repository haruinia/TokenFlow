+func TestQoderTokenStorage_SaveAndExpiry(t *testing.T) {
+	tmpDir := t.TempDir()
+	filePath := filepath.Join(tmpDir, "qoder-test.json")
+
+	storage := &QoderTokenStorage{
+		AccessToken:  "test-access-token",
+		RefreshToken: "test-refresh-token",
+		TokenType:    "Bearer",
+		Expired:      time.Now().Add(1 * time.Hour).UTC().Format(time.RFC3339),
+		UID:          "user-123",
+		Email:        "user@example.com",
+		Type:         "qoder",
+	}
+
+	if storage.IsExpired() {
+		t.Errorf("IsExpired() = true, want false for 1 hour in future")
+	}
+	if storage.NeedsRefresh() {
+		t.Errorf("NeedsRefresh() = true, want false for valid token")
+	}
+
+	// Set expired time in the past
+	storage.Expired = time.Now().Add(-10 * time.Minute).UTC().Format(time.RFC3339)
+	if !storage.IsExpired() {
+		t.Errorf("IsExpired() = false, want true for past time")
+	}
+	if !storage.NeedsRefresh() {
+		t.Errorf("NeedsRefresh() = false, want true when expired and has refresh token")
+	}
+
+	// Save to file
+	if err := storage.SaveTokenToFile(filePath); err != nil {
+		t.Fatalf("SaveTokenToFile() error = %v", err)
+	}
+
+	content, err := os.ReadFile(filePath)
+	if err != nil {
+		t.Fatalf("ReadFile() error = %v", err)
+	}
+
+	var loaded map[string]any
+	if err := json.Unmarshal(content, &loaded); err != nil {
+		t.Fatalf("Unmarshal() error = %v", err)
+	}
+
+	if loaded["type"] != "qoder" {
+		t.Errorf("loaded type = %v, want qoder", loaded["type"])
+	}
