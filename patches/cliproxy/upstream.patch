+
+	wbAuth := workbuddy.NewWorkBuddyAuth(h.cfg)
+
+	session, errStart := wbAuth.RequestState(ctx)
+	if errStart != nil {
+		log.Errorf("Failed to generate authorization URL: %v", errStart)
+		c.JSON(http.StatusInternalServerError, gin.H{"error": "failed to generate authorization url"})
+		return
+	}
+	state := session.State
+	authURL := session.AuthURL
+
+	RegisterOAuthSession(state, "workbuddy")
+
+	go func() {
+		pollCtx, cancelPoll := context.WithCancel(ctx)
+		defer cancelPoll()
+		go watchOAuthSessionCancel(pollCtx, cancelPoll, state, "workbuddy")
+
+		fmt.Println("Waiting for authentication...")
+		authBundle, errWaitForAuthorization := wbAuth.WaitForAuthorization(pollCtx, session)
+		if errWaitForAuthorization != nil {
+			if !IsOAuthSessionPending(state, "workbuddy") {
+				return
+			}
+			SetOAuthSessionError(state, oauthSessionErrorWithCause("Authentication failed", errWaitForAuthorization))
+			fmt.Printf("Authentication failed: %v\n", errWaitForAuthorization)
+			return
+		}
+		if !IsOAuthSessionPending(state, "workbuddy") {
+			return
+		}
+
+		tokenStorage := wbAuth.CreateTokenStorage(authBundle)
+
+		metadata := map[string]any{
+			"type":          "workbuddy",
+			"access_token":  authBundle.TokenData.AccessToken,
+			"refresh_token": authBundle.TokenData.RefreshToken,
+			"token_type":    "Bearer",
+			"timestamp":     time.Now().UnixMilli(),
+		}
+		if authBundle.TokenData.ExpiresAt > 0 {
+			expired := time.Unix(authBundle.TokenData.ExpiresAt, 0).UTC().Format(time.RFC3339)
+			metadata["expired"] = expired
+		}
+		if strings.TrimSpace(authBundle.TokenData.UID) != "" {
+			metadata["uid"] = strings.TrimSpace(authBundle.TokenData.UID)
+		}
+		if strings.TrimSpace(authBundle.TokenData.Nickname) != "" {
+			metadata["nickname"] = strings.TrimSpace(authBundle.TokenData.Nickname)
+		}
+		if strings.TrimSpace(authBundle.TokenData.EnterpriseID) != "" {
+			metadata["enterprise_id"] = strings.TrimSpace(authBundle.TokenData.EnterpriseID)
+		}
+		if strings.TrimSpace(authBundle.TokenData.Domain) != "" {
+			metadata["domain"] = strings.TrimSpace(authBundle.TokenData.Domain)
+		}
+
+		label := "WorkBuddy User"
