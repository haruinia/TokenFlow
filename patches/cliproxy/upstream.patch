+// mergeRemoteModelsCatalog overlays a fetched catalog onto the current one.
+// Empty remote sections keep the local models so providers that exist only in
+// the embedded models.json are not wiped by an upstream catalog that omits them.
+func mergeRemoteModelsCatalog(local, remote *staticModelsJSON) *staticModelsJSON {
+	if remote == nil {
+		return local
+	}
+	if local == nil {
+		return remote
+	}
+	merged := *remote
+	merged.Claude = keepLocalModelsIfRemoteEmpty(local.Claude, remote.Claude)
+	merged.Gemini = keepLocalModelsIfRemoteEmpty(local.Gemini, remote.Gemini)
+	merged.Vertex = keepLocalModelsIfRemoteEmpty(local.Vertex, remote.Vertex)
+	merged.AIStudio = keepLocalModelsIfRemoteEmpty(local.AIStudio, remote.AIStudio)
+	merged.CodexFree = keepLocalModelsIfRemoteEmpty(local.CodexFree, remote.CodexFree)
+	merged.CodexTeam = keepLocalModelsIfRemoteEmpty(local.CodexTeam, remote.CodexTeam)
+	merged.CodexPlus = keepLocalModelsIfRemoteEmpty(local.CodexPlus, remote.CodexPlus)
+	merged.CodexPro = keepLocalModelsIfRemoteEmpty(local.CodexPro, remote.CodexPro)
+	merged.Kimi = keepLocalModelsIfRemoteEmpty(local.Kimi, remote.Kimi)
+	merged.Antigravity = keepLocalModelsIfRemoteEmpty(local.Antigravity, remote.Antigravity)
+	merged.XAI = keepLocalModelsIfRemoteEmpty(local.XAI, remote.XAI)
+	merged.Qoder = keepLocalModelsIfRemoteEmpty(local.Qoder, remote.Qoder)
+	merged.WorkBuddy = keepLocalModelsIfRemoteEmpty(local.WorkBuddy, remote.WorkBuddy)
+	merged.ZCode = keepLocalModelsIfRemoteEmpty(local.ZCode, remote.ZCode)
+	merged.Doubao = keepLocalModelsIfRemoteEmpty(local.Doubao, remote.Doubao)
+	merged.Trae = keepLocalModelsIfRemoteEmpty(local.Trae, remote.Trae)
+	return &merged
+}
+
