+	cliproxyexecutor "github.com/router-for-me/CLIProxyAPI/v7/sdk/cliproxy/executor"
+	sdktranslator "github.com/router-for-me/CLIProxyAPI/v7/sdk/translator"
+)
+
+func TestQoderExecutor_IdentifierAndFormat(t *testing.T) {
+	cfg := &config.Config{}
+	exec := NewQoderExecutor(cfg)
+
+	if id := exec.Identifier(); id != "qoder" {
+		t.Errorf("Identifier() = %q, want qoder", id)
+	}
+
+	fmt := exec.RequestToFormat(cliproxyexecutor.Request{}, cliproxyexecutor.Options{})
+	if fmt != sdktranslator.FormatOpenAI {
+		t.Errorf("RequestToFormat() = %v, want %v", fmt, sdktranslator.FormatOpenAI)
+	}
+}
+
+func TestQoderExecutor_AdaptAuth(t *testing.T) {
+	cfg := &config.Config{}
+	exec := NewQoderExecutor(cfg)
+
+	auth := &cliproxyauth.Auth{
+		ID:       "qoder-test",
+		Provider: "qoder",
+		Metadata: map[string]any{
+			"access_token": "token-from-metadata",
+		},
+	}
+
+	adapted := exec.adaptAuth(auth)
+	if adapted == nil {
+		t.Fatal("adaptAuth() returned nil")
+	}
+	if adapted.Attributes["api_key"] != "token-from-metadata" {
+		t.Errorf("adapted api_key = %q, want token-from-metadata", adapted.Attributes["api_key"])
+	}
+}
+
+func TestQoderExecutor_ExecuteSuccess(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if authHdr := r.Header.Get("Authorization"); !strings.HasPrefix(authHdr, "Bearer COSY.") {
+			http.Error(w, "unauthorized", http.StatusUnauthorized)
+			return
+		}
+
+		w.Header().Set("Content-Type", "text/event-stream")
+		chunk := `{"choices":[{"delta":{"content":"Hello from Qoder!"}}],"id":"chatcmpl-qoder-123","model":"qmodel_38max"}`
+		env := map[string]string{"body": chunk}
+		envBytes, _ := json.Marshal(env)
+		_, _ = fmt.Fprintf(w, "data: %s\n\ndata: [DONE]\n\n", envBytes)
+	}))
+	defer server.Close()
+
+	cfg := &config.Config{}
+	exec := NewQoderExecutor(cfg)
+
+	auth := &cliproxyauth.Auth{
+		ID:       "qoder-test",
+		Provider: "qoder",
+		Attributes: map[string]string{
+			"chat_url": server.URL,
+		},
+		Metadata: map[string]any{
+			"access_token": "test-qoder-token",
+		},
+	}
+
+	reqPayload := []byte(`{"model":"qmodel_38max","messages":[{"role":"user","content":"Hi"}]}`)
+	req := cliproxyexecutor.Request{
+		Model:   "qmodel_38max",
+		Payload: reqPayload,
+	}
+	opts := cliproxyexecutor.Options{
+		SourceFormat: sdktranslator.FormatOpenAI,
+	}
+
+	resp, err := exec.Execute(context.Background(), auth, req, opts)
+	if err != nil {
+		t.Fatalf("Execute() error = %v", err)
+	}
+	if len(resp.Payload) == 0 {
+		t.Fatal("Execute() returned empty payload")
+	}
+
+	var respJSON map[string]any
+	if err := json.Unmarshal(resp.Payload, &respJSON); err != nil {
+		t.Fatalf("failed to unmarshal response: %v", err)
+	}
+	if respJSON["id"] != "chatcmpl-qoder-123" {
+		t.Errorf("response id = %v, want chatcmpl-qoder-123", respJSON["id"])
+	}
+}
