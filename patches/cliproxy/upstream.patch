+		Interval:        1,
+	}
+
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+
+	// Test poll attempt directly (first attempt 404 pending)
+	tokenData, err, shouldContinue := client.pollAttempt(ctx, session.Nonce, session.CodeVerifier)
+	if err != nil || tokenData != nil || !shouldContinue {
+		t.Fatalf("first pollAttempt expected continue, got token=%v, err=%v, shouldContinue=%v", tokenData, err, shouldContinue)
+	}
+
+	// Second attempt succeeds
+	tokenData, err, shouldContinue = client.pollAttempt(ctx, session.Nonce, session.CodeVerifier)
+	if err != nil || tokenData == nil || shouldContinue {
+		t.Fatalf("second pollAttempt expected success, got token=%v, err=%v, shouldContinue=%v", tokenData, err, shouldContinue)
+	}
+	if tokenData.AccessToken != "new-oauth-token" {
+		t.Errorf("tokenData.AccessToken = %q, want new-oauth-token", tokenData.AccessToken)
+	}
+	if tokenData.RefreshToken != "new-refresh-token" {
+		t.Errorf("tokenData.RefreshToken = %q, want new-refresh-token", tokenData.RefreshToken)
+	}
+
+	// Test RefreshToken
+	refreshed, errRefresh := client.RefreshToken(ctx, "new-refresh-token")
+	if errRefresh != nil {
+		t.Fatalf("RefreshToken() error = %v", errRefresh)
+	}
+	if refreshed.AccessToken != "refreshed-oauth-token" {
+		t.Errorf("refreshed.AccessToken = %q, want refreshed-oauth-token", refreshed.AccessToken)
+	}
+}
diff --git a/internal/auth/qoder/token.go b/internal/auth/qoder/token.go
new file mode 100644
index 00000000..a84736ca
--- /dev/null
+++ b/internal/auth/qoder/token.go
@@ -0,0 +1,139 @@
+// Package qoder provides authentication and token management functionality
+// for Alibaba Qoder services. It handles OAuth2 PKCE flow, Personal Access Token (PAT)
+// storage, serialization, and retrieval for maintaining authenticated sessions with the Qoder API.
+package qoder
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/misc"
+	log "github.com/sirupsen/logrus"
+)
+
+const (
+	// refreshThresholdSeconds is when to refresh token before expiry (5 minutes).
+	refreshThresholdSeconds = 300
+)
+
+// QoderTokenStorage stores token information for Qoder API authentication.
+type QoderTokenStorage struct {
+	// AccessToken is the OAuth2 access token or Personal Access Token (PAT).
+	AccessToken string `json:"access_token"`
+	// RefreshToken is the OAuth2 refresh token used to obtain new access tokens.
+	RefreshToken string `json:"refresh_token,omitempty"`
+	// TokenType is the type of token, typically "Bearer".
+	TokenType string `json:"token_type"`
+	// Expired is the RFC3339 timestamp when the access token expires.
+	Expired string `json:"expired,omitempty"`
+	// UID is the user identifier returned by Qoder.
+	UID string `json:"uid,omitempty"`
+	// Email is the account email or user handle if available.
+	Email string `json:"email,omitempty"`
+	// Type indicates the authentication provider type, always "qoder" for this storage.
+	Type string `json:"type"`
+
+	// Metadata holds arbitrary key-value pairs injected via hooks.
+	// It is not exported to JSON directly to allow flattening during serialization.
+	Metadata map[string]any `json:"-"`
+}
+
+// SetMetadata allows external callers to inject metadata into the storage before saving.
+func (ts *QoderTokenStorage) SetMetadata(meta map[string]any) {
+	ts.Metadata = meta
+}
+
+// QoderTokenData holds the raw OAuth token or PAT response from Qoder.
+type QoderTokenData struct {
+	// AccessToken is the OAuth2 access token or PAT.
+	AccessToken string `json:"access_token"`
+	// RefreshToken is the OAuth2 refresh token.
+	RefreshToken string `json:"refresh_token,omitempty"`
+	// TokenType is the type of token, typically "Bearer".
+	TokenType string `json:"token_type"`
+	// ExpiresAt is the Unix timestamp when the token expires (0 for non-expiring PAT).
+	ExpiresAt int64 `json:"expires_at,omitempty"`
+	// UID is the user identifier.
+	UID string `json:"uid,omitempty"`
+	// Email is the account email or handle.
+	Email string `json:"email,omitempty"`
+}
+
+// QoderAuthBundle bundles authentication data for storage.
+type QoderAuthBundle struct {
+	// TokenData contains the token information.
+	TokenData *QoderTokenData
+	// MachineID is the machine identifier used during auth if applicable.
+	MachineID string
+}
+
+// DeviceFlowSession holds the state for an active PKCE device authorization flow.
+type DeviceFlowSession struct {
+	// VerificationURI is the browser URL for authorizing.
+	VerificationURI string `json:"verification_uri"`
+	// Nonce is the unique cryptographic nonce for polling.
+	Nonce string `json:"nonce"`
+	// CodeVerifier is the PKCE code verifier string.
+	CodeVerifier string `json:"code_verifier"`
+	// ExpiresIn is the number of seconds until the device flow session expires.
+	ExpiresIn int `json:"expires_in"`
+	// Interval is the polling interval in seconds.
+	Interval int `json:"interval"`
+}
+
+// SaveTokenToFile serializes the Qoder token storage to a JSON file.
+func (ts *QoderTokenStorage) SaveTokenToFile(authFilePath string) error {
+	misc.LogSavingCredentials(authFilePath)
+	ts.Type = "qoder"
+
+	if err := os.MkdirAll(filepath.Dir(authFilePath), 0700); err != nil {
+		return fmt.Errorf("failed to create directory: %w", err)
+	}
+
+	// Merge metadata using helper
+	data, errMerge := misc.MergeMetadata(ts, ts.Metadata)
+	if errMerge != nil {
+		return fmt.Errorf("failed to merge metadata: %w", errMerge)
+	}
+
+	f, err := os.Create(authFilePath)
+	if err != nil {
+		return fmt.Errorf("failed to create token file: %w", err)
+	}
+	defer func() {
+		if errClose := f.Close(); errClose != nil {
+			log.Errorf("qoder token storage: close token file error: %v", errClose)
+		}
+	}()
+
+	encoder := json.NewEncoder(f)
+	encoder.SetIndent("", "  ")
+	if err = encoder.Encode(data); err != nil {
+		return fmt.Errorf("failed to write token to file: %w", err)
+	}
+	return nil
+}
+
+// IsExpired checks if the token has expired.
+func (ts *QoderTokenStorage) IsExpired() bool {
+	if ts.Expired == "" {
+		return false // No expiry set (e.g. PAT), assume valid
+	}
+	t, err := time.Parse(time.RFC3339, ts.Expired)
+	if err != nil {
+		return true // Has expiry string but cannot parse
+	}
+	// Consider expired if within refresh threshold
+	return time.Now().Add(time.Duration(refreshThresholdSeconds) * time.Second).After(t)
+}
+
+// NeedsRefresh checks if the token should be refreshed.
+func (ts *QoderTokenStorage) NeedsRefresh() bool {
+	if ts.RefreshToken == "" {
+		return false // Cannot refresh without refresh token
+	}
+	return ts.IsExpired()
+}
diff --git a/internal/auth/trae/token.go b/internal/auth/trae/token.go
new file mode 100644
index 00000000..fa323fd8
--- /dev/null
+++ b/internal/auth/trae/token.go
@@ -0,0 +1,158 @@
+// Package trae provides authentication and token management functionality
+// for ByteDance Trae (and MarsCode) AI services. It handles token storage,
+// local configuration discovery from the Trae desktop client, serialization,
+// and token refresh.
+package trae
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/router-for-me/CLIProxyAPI/v7/internal/misc"
+	log "github.com/sirupsen/logrus"
+)
+
+const (
+	// DefaultTraeHost is the default Trae API endpoint.
+	DefaultTraeHost = "https://api-us-east.trae.ai"
+	// DefaultMCHost is the Trae / MarsCode inference gateway.
+	DefaultMCHost = "https://trae-api-us.mchost.guru"
+	// refreshThresholdSeconds is when to refresh token before expiry (5 minutes).
+	refreshThresholdSeconds = 300
+)
+
+// TraeTokenStorage stores token information for Trae API authentication.
+type TraeTokenStorage struct {
+	// AccessToken is the JWT bearer token for Trae/MarsCode API calls.
+	AccessToken string `json:"access_token"`
+	// RefreshToken is the refresh token if available.
+	RefreshToken string `json:"refresh_token,omitempty"`
+	// TokenType is typically "Bearer".
+	TokenType string `json:"token_type"`
+	// Expired is the RFC3339 timestamp when the access token expires.
+	Expired string `json:"expired,omitempty"`
+	// ExpiresAt is the Unix timestamp in seconds or milliseconds.
+	ExpiresAt int64 `json:"expires_at,omitempty"`
+	// RefreshExpiredAt is the RFC3339 expiration time for the refresh token.
+	RefreshExpiredAt string `json:"refresh_expired_at,omitempty"`
+	// Host is the Trae backend host URL.
+	Host string `json:"host,omitempty"`
+	// UserID is the ByteDance Trae account user ID.
+	UserID string `json:"user_id,omitempty"`
+	// Email is the account email address.
+	Email string `json:"email,omitempty"`
+	// Username is the account display name.
+	Username string `json:"username,omitempty"`
+	// Region specifies the region code (e.g., "US").
+	Region string `json:"region,omitempty"`
+	// AIRegion specifies the AI backend region code.
+	AIRegion string `json:"ai_region,omitempty"`
+	// Provider specifies the provider name, always "trae".
+	Provider string `json:"provider,omitempty"`
+	// Type indicates the authentication provider type, always "trae".
+	Type string `json:"type"`
+
+	// Metadata holds arbitrary key-value pairs injected via hooks.
+	Metadata map[string]any `json:"-"`
+}
+
+// SetMetadata allows external callers to inject metadata into the storage before saving.
+func (ts *TraeTokenStorage) SetMetadata(meta map[string]any) {
+	ts.Metadata = meta
+}
+
+// TraeTokenData holds raw token information parsed from local configs or OAuth.
+type TraeTokenData struct {
+	AccessToken      string `json:"token"`
+	RefreshToken     string `json:"refreshToken,omitempty"`
+	ExpiredAt        string `json:"expiredAt,omitempty"`
+	RefreshExpiredAt string `json:"refreshExpiredAt,omitempty"`
+	UserID           string `json:"userId,omitempty"`
+	AIRegion         string `json:"aiRegion,omitempty"`
+	Region           string `json:"region,omitempty"`
+	Host             string `json:"host,omitempty"`
+	Account          struct {
+		Username  string `json:"username,omitempty"`
+		Email     string `json:"email,omitempty"`
+		AvatarURL string `json:"avatar_url,omitempty"`
+		Scope     string `json:"scope,omitempty"`
+	} `json:"account,omitempty"`
+}
+
+// SaveTokenToFile serializes the Trae token storage to a JSON file.
+func (ts *TraeTokenStorage) SaveTokenToFile(authFilePath string) error {
+	misc.LogSavingCredentials(authFilePath)
+	ts.Type = "trae"
+	if ts.Provider == "" {
+		ts.Provider = "trae"
+	}
+	if ts.TokenType == "" {
+		ts.TokenType = "Bearer"
+	}
+	if ts.Host == "" {
+		ts.Host = DefaultTraeHost
+	}
+
+	if err := os.MkdirAll(filepath.Dir(authFilePath), 0700); err != nil {
+		return fmt.Errorf("failed to create directory: %w", err)
+	}
+
+	data, errMerge := misc.MergeMetadata(ts, ts.Metadata)
+	if errMerge != nil {
+		return fmt.Errorf("failed to merge metadata: %w", errMerge)
+	}
+
+	f, err := os.Create(authFilePath)
+	if err != nil {
+		return fmt.Errorf("failed to create token file: %w", err)
+	}
+	defer func() {
+		if errClose := f.Close(); errClose != nil {
+			log.Errorf("trae token storage: close token file error: %v", errClose)
+		}
+	}()
+
+	encoder := json.NewEncoder(f)
+	encoder.SetIndent("", "  ")
+	if err = encoder.Encode(data); err != nil {
+		return fmt.Errorf("failed to write token to file: %w", err)
+	}
+	return nil
+}
+
+// SaveToken persists the Trae token storage to a JSON file in authDir.
+func (ts *TraeTokenStorage) SaveToken(authDir string) error {
+	filename := "trae.json"
+	if ts.Email != "" {
+		sanitized := strings.ReplaceAll(ts.Email, "@", "_")
+		sanitized = strings.ReplaceAll(sanitized, "/", "_")
+		filename = fmt.Sprintf("trae-%s.json", sanitized)
+	} else if ts.UserID != "" {
+		filename = fmt.Sprintf("trae-%s.json", ts.UserID)
+	}
+
+	authFilePath := filepath.Join(authDir, filename)
+	return ts.SaveTokenToFile(authFilePath)
+}
+
+// NeedsRefresh checks whether the access token is near expiration.
+func (ts *TraeTokenStorage) NeedsRefresh() bool {
+	if ts.RefreshToken == "" {
+		return false
+	}
+	if ts.Expired != "" {
+		expTime, err := time.Parse(time.RFC3339, ts.Expired)
+		if err == nil {
+			return time.Until(expTime) <= time.Duration(refreshThresholdSeconds)*time.Second
+		}
+	}
+	if ts.ExpiresAt > 0 {
+		expTime := time.Unix(ts.ExpiresAt, 0)
+		return time.Until(expTime) <= time.Duration(refreshThresholdSeconds)*time.Second
+	}
+	return false
+}
diff --git a/internal/auth/trae/trae.go b/internal/auth/trae/trae.go
new file mode 100644
index 00000000..ec4665a6
--- /dev/null
+++ b/internal/auth/trae/trae.go
@@ -0,0 +1,522 @@
+// Package trae implements authentication, local credential discovery,
+// and token refresh for ByteDance Trae and MarsCode AI developer services.
+package trae
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/url"
+	"os"
+	"path/filepath"
+	"runtime"
+	"strconv"
+	"strings"
+	"time"
+
+	log "github.com/sirupsen/logrus"
+)
+
+const (
+	// DefaultClientID is the public native client ID for Trae IDE.
+	DefaultClientID = "ono9krqynydwx5"
+	// TraeStorageAuthKey is the key in Trae global storage containing the session.
+	TraeStorageAuthKey = "iCubeAuthInfo://icube.cloudide"
+)
+
+// ImportLocalTraeCredentials searches the standard configuration directories
+// of the Trae desktop application (macOS, Windows, Linux) and imports the active session token.
+func ImportLocalTraeCredentials(authDir string) (*TraeTokenStorage, error) {
+	candidates := getLocalTraeStoragePaths()
+	if len(candidates) == 0 {
+		return nil, errors.New("no local Trae storage paths could be resolved")
+	}
+
+	var foundPath string
+	var rawData []byte
+
+	for _, path := range candidates {
+		if path == "" {
+			continue
+		}
+		data, errRead := os.ReadFile(path)
+		if errRead == nil && len(data) > 0 {
+			// Check if it contains the auth key
+			if strings.Contains(string(data), TraeStorageAuthKey) {
+				foundPath = path
+				rawData = data
+				break
+			}
+		}
+	}
+
+	if foundPath == "" || len(rawData) == 0 {
+		return nil, fmt.Errorf("no local Trae credentials found in candidate paths: %v", candidates)
+	}
+
+	log.Infof("Found local Trae session storage at %s", foundPath)
+
+	var storageMap map[string]any
+	if errJSON := json.Unmarshal(rawData, &storageMap); errJSON != nil {
+		return nil, fmt.Errorf("failed to parse Trae storage JSON at %s: %w", foundPath, errJSON)
+	}
+
+	rawVal, ok := storageMap[TraeStorageAuthKey]
+	if !ok || rawVal == nil {
+		return nil, fmt.Errorf("key %q not found in Trae storage at %s", TraeStorageAuthKey, foundPath)
+	}
+
+	valStr, okStr := rawVal.(string)
+	if !okStr || valStr == "" {
+		return nil, fmt.Errorf("invalid value for %q in Trae storage", TraeStorageAuthKey)
+	}
+
+	var tokenData TraeTokenData
+	if errParse := json.Unmarshal([]byte(valStr), &tokenData); errParse != nil {
+		return nil, fmt.Errorf("failed to parse Trae auth data from storage: %w", errParse)
+	}
+
+	if tokenData.AccessToken == "" {
+		return nil, errors.New("extracted Trae auth info contains empty access token")
+	}
+	if localSessionExpired(tokenData, time.Now()) {
+		return nil, errors.New("the local Trae sign-in has expired; open Trae and sign in again, or add the account in TokenFlow")
+	}
+
+	host := tokenData.Host
+	if host == "" {
+		host = DefaultTraeHost
+	}
+
+	storage := &TraeTokenStorage{
+		AccessToken:      tokenData.AccessToken,
+		RefreshToken:     tokenData.RefreshToken,
+		TokenType:        "Bearer",
+		Expired:          tokenData.ExpiredAt,
+		RefreshExpiredAt: tokenData.RefreshExpiredAt,
+		Host:             host,
+		UserID:           tokenData.UserID,
+		Email:            tokenData.Account.Email,
+		Username:         tokenData.Account.Username,
+		Region:           tokenData.Region,
+		AIRegion:         tokenData.AIRegion,
+		Provider:         "trae",
+		Type:             "trae",
+	}
+
+	if errSave := storage.SaveToken(authDir); errSave != nil {
+		return nil, fmt.Errorf("failed to save imported Trae token: %w", errSave)
+	}
+
+	return storage, nil
+}
+
+// getLocalTraeStoragePaths returns platform-dependent candidate paths for Trae storage.json.
+func getLocalTraeStoragePaths() []string {
+	var paths []string
+	homeDir, errHome := os.UserHomeDir()
+	if errHome != nil {
+		return paths
+	}
+
+	switch runtime.GOOS {
+	case "darwin":
+		paths = append(paths,
+			filepath.Join(homeDir, "Library", "Application Support", "Trae", "User", "globalStorage", "storage.json"),
+			filepath.Join(homeDir, "Library", "Application Support", "Code", "User", "globalStorage", "storage.json"),
+		)
+	case "windows":
+		appData := os.Getenv("APPDATA")
+		if appData != "" {
+			paths = append(paths,
+				filepath.Join(appData, "Trae", "User", "globalStorage", "storage.json"),
+				filepath.Join(appData, "Code", "User", "globalStorage", "storage.json"),
+			)
+		}
+	default: // linux and others
+		configDir := os.Getenv("XDG_CONFIG_HOME")
+		if configDir == "" {
+			configDir = filepath.Join(homeDir, ".config")
+		}
+		paths = append(paths,
+			filepath.Join(configDir, "Trae", "User", "globalStorage", "storage.json"),
+			filepath.Join(configDir, "Code", "User", "globalStorage", "storage.json"),
+		)
+	}
+
+	return paths
+}
+
+// GenerateAuthSession creates an authorization URL and state token for Trae.
+// It wraps the authorization URL in Trae's login redirect gateway (https://www.trae.ai/login?redirect_url=...)
+// so unauthenticated users are automatically guided to log in first, preventing the "Login Failed" crash
+// when unauthenticated users visit /authorization directly.
+func GenerateAuthSession(callbackURLs ...string) (authURL string, state string, err error) {
+	b := make([]byte, 16)
+	if _, errRand := rand.Read(b); errRand != nil {
+		return "", "", fmt.Errorf("failed to generate random state: %w", errRand)
+	}
+	state = hex.EncodeToString(b)
+
+	var callbackURL string
+	if len(callbackURLs) > 0 && strings.TrimSpace(callbackURLs[0]) != "" {
+		callbackURL = strings.TrimSpace(callbackURLs[0])
+	}
+
+	targetURL := fmt.Sprintf(
+		"https://www.trae.ai/authorization?login_version=1&auth_from=trae&login_channel=native_ide&auth_type=local&client_id=%s&state=%s",
+		DefaultClientID,
+		state,
+	)
+	if callbackURL != "" {
+		targetURL += fmt.Sprintf("&auth_callback_url=%s", url.QueryEscape(callbackURL))
+	}
+
+	authURL = fmt.Sprintf(
+		"https://www.trae.ai/login?redirect_url=%s",
+		url.QueryEscape(targetURL),
+	)
+
+	return authURL, state, nil
+}
+
+// ParseCallbackData parses the callback payload from Trae's authorization redirection.
+// It handles authCodeInfo (JSON object containing tokens or code), userInfo, host, and direct authorization codes.
+func ParseCallbackData(ctx context.Context, rawAuthCodeInfo, rawUserInfo, host, code string) (*TraeTokenStorage, error) {
+	if host == "" {
+		host = DefaultTraeHost
+	}
+
+	storage := &TraeTokenStorage{
+		TokenType: "Bearer",
+		Host:      host,
+		Provider:  "trae",
+		Type:      "trae",
+	}
+
+	// 1. Parse userInfo if provided
+	if strings.TrimSpace(rawUserInfo) != "" {
+		var u struct {
+			UserID        string `json:"UserID"`
+			Email         string `json:"Email"`
+			Username      string `json:"Username"`
+			UserIDLower   string `json:"user_id"`
+			EmailLower    string `json:"email"`
+			UsernameLower string `json:"username"`
+		}
+		if errU := json.Unmarshal([]byte(rawUserInfo), &u); errU == nil {
+			if u.UserID != "" {
+				storage.UserID = u.UserID
+			} else if u.UserIDLower != "" {
+				storage.UserID = u.UserIDLower
+			}
+			if u.Email != "" {
+				storage.Email = u.Email
+			} else if u.EmailLower != "" {
+				storage.Email = u.EmailLower
+			}
+			if u.Username != "" {
+				storage.Username = u.Username
+			} else if u.UsernameLower != "" {
+				storage.Username = u.UsernameLower
+			}
+		}
+	}
+
+	// 2. Parse authCodeInfo if provided
+	var authCode string
+	if strings.TrimSpace(rawAuthCodeInfo) != "" {
+		var info struct {
+			Token         string `json:"Token"`
+			RefreshToken  string `json:"RefreshToken"`
+			TokenExpireAt int64  `json:"TokenExpireAt"`
+			Code          string `json:"Code"`
+			AuthCode      string `json:"AuthCode"`
+			// Lowercase fallbacks
+			TokenLower        string `json:"token"`
+			AccessTokenLower  string `json:"access_token"`
+			RefreshTokenLower string `json:"refreshToken"`
+			ExpiredAtLower    string `json:"expiredAt"`
+		}
+		if errI := json.Unmarshal([]byte(rawAuthCodeInfo), &info); errI == nil {
+			if info.Token != "" {
+				storage.AccessToken = info.Token
+			} else if info.AccessTokenLower != "" {
+				storage.AccessToken = info.AccessTokenLower
+			} else if info.TokenLower != "" {
+				storage.AccessToken = info.TokenLower
+			}
+
+			if info.RefreshToken != "" {
+				storage.RefreshToken = info.RefreshToken
+			} else if info.RefreshTokenLower != "" {
+				storage.RefreshToken = info.RefreshTokenLower
+			}
+
+			if info.TokenExpireAt > 0 {
+				sec := info.TokenExpireAt
+				if sec > 1e11 {
+					sec /= 1000
+				}
+				storage.ExpiresAt = sec
+				storage.Expired = time.Unix(sec, 0).Format(time.RFC3339)
+			} else if info.ExpiredAtLower != "" {
+				storage.Expired = info.ExpiredAtLower
+			}
+
+			if info.Code != "" {
+				authCode = info.Code
+			} else if info.AuthCode != "" {
+				authCode = info.AuthCode
+			}
+		}
+	}
+
+	if storage.AccessToken != "" {
+		return storage, nil
+	}
+
+	// 3. If token is not directly in authCodeInfo, exchange authorization code
+	if authCode == "" {
+		authCode = strings.TrimSpace(code)
+	}
+
+	if authCode == "" {
+		return nil, errors.New("no access token or authorization code found in Trae callback")
+	}
+
+	return ExchangeAuthCode(ctx, authCode, host, storage.UserID)
+}
+
+// ExchangeAuthCode exchanges an authorization code for access and refresh tokens.
+func ExchangeAuthCode(ctx context.Context, code, host, userID string) (*TraeTokenStorage, error) {
+	if host == "" {
+		host = DefaultTraeHost
+	}
+
+	exchangeURL := fmt.Sprintf("%s/cloudide/api/v3/trae/oauth/ExchangeToken", strings.TrimRight(host, "/"))
+	reqBody, _ := json.Marshal(map[string]string{
+		"ClientID":     DefaultClientID,
+		"Code":         code,
+		"AuthCode":     code,
+		"ClientSecret": "-",
+		"UserID":       userID,
+	})
+
+	req, errReq := http.NewRequestWithContext(ctx, http.MethodPost, exchangeURL, strings.NewReader(string(reqBody)))
+	if errReq != nil {
+		return nil, fmt.Errorf("failed to create exchange request: %w", errReq)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set("User-Agent", "Trae/1.0.23444")
+
+	client := &http.Client{Timeout: 15 * time.Second}
+	resp, errDo := client.Do(req)
+	if errDo != nil {
+		return nil, fmt.Errorf("exchange request failed: %w", errDo)
+	}
+	defer func() {
+		if errClose := resp.Body.Close(); errClose != nil {
+			log.Errorf("failed to close response body: %v", errClose)
+		}
+	}()
+
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return nil, fmt.Errorf("exchange returned status %d", resp.StatusCode)
+	}
+
+	var result struct {
+		ResponseMetadata struct {
+			Error struct {
+				Code    string `json:"Code"`
+				Message string `json:"Message"`
+			} `json:"Error"`
+		} `json:"ResponseMetadata"`
+		Result struct {
+			Token         string `json:"Token"`
+			RefreshToken  string `json:"RefreshToken"`
+			TokenExpireAt int64  `json:"TokenExpireAt"`
+		} `json:"Result"`
+		Data struct {
+			Token        string `json:"token"`
+			RefreshToken string `json:"refreshToken"`
+			ExpiredAt    string `json:"expiredAt"`
+		} `json:"data"`
+	}
+
+	if errDecode := json.NewDecoder(resp.Body).Decode(&result); errDecode != nil {
+		return nil, fmt.Errorf("failed to decode exchange response: %w", errDecode)
+	}
+
+	storage := &TraeTokenStorage{
+		TokenType: "Bearer",
+		Host:      host,
+		UserID:    userID,
+		Provider:  "trae",
+		Type:      "trae",
+	}
+
+	if result.Result.Token != "" {
+		storage.AccessToken = result.Result.Token
+		storage.RefreshToken = result.Result.RefreshToken
+		if result.Result.TokenExpireAt > 0 {
+			sec := result.Result.TokenExpireAt
+			if sec > 1e11 {
+				sec /= 1000
+			}
+			storage.ExpiresAt = sec
+			storage.Expired = time.Unix(sec, 0).Format(time.RFC3339)
+		}
+		return storage, nil
+	}
+
+	if result.Data.Token != "" {
+		storage.AccessToken = result.Data.Token
+		storage.RefreshToken = result.Data.RefreshToken
+		storage.Expired = result.Data.ExpiredAt
+		return storage, nil
+	}
+
+	if result.ResponseMetadata.Error.Message != "" {
+		return nil, fmt.Errorf("exchange failed: %s (code %s)", result.ResponseMetadata.Error.Message, result.ResponseMetadata.Error.Code)
+	}
+
+	return nil, errors.New("empty token returned in exchange response")
+}
+
+// RefreshToken attempts to refresh the access token using the refresh token.
+func RefreshToken(ctx context.Context, ts *TraeTokenStorage) error {
+	if ts.RefreshToken == "" {
+		return errors.New("no refresh token available for Trae")
+	}
+
+	host := ts.Host
+	if host == "" {
+		host = DefaultTraeHost
+	}
+
+	refreshURL := fmt.Sprintf("%s/cloudide/api/v3/trae/oauth/ExchangeToken", strings.TrimRight(host, "/"))
+
+	reqBody, _ := json.Marshal(map[string]string{
+		"ClientID":     DefaultClientID,
+		"RefreshToken": ts.RefreshToken,
+		"ClientSecret": "-",
+		"UserID":       ts.UserID,
+	})
+
+	req, errReq := http.NewRequestWithContext(ctx, http.MethodPost, refreshURL, strings.NewReader(string(reqBody)))
+	if errReq != nil {
+		return fmt.Errorf("failed to create refresh request: %w", errReq)
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Accept", "application/json")
+	req.Header.Set("User-Agent", "Trae/1.0.23444")
+
+	client := &http.Client{Timeout: 15 * time.Second}
+	resp, errDo := client.Do(req)
+	if errDo != nil {
+		return fmt.Errorf("refresh request failed: %w", errDo)
+	}
+	defer func() {
+		if errClose := resp.Body.Close(); errClose != nil {
+			log.Errorf("failed to close response body: %v", errClose)
+		}
+	}()
+
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return fmt.Errorf("refresh returned status %d", resp.StatusCode)
+	}
+
+	var result struct {
+		ResponseMetadata struct {
+			Error struct {
+				Code    string `json:"Code"`
+				Message string `json:"Message"`
+			} `json:"Error"`
+		} `json:"ResponseMetadata"`
+		Result struct {
+			Token         string `json:"Token"`
+			RefreshToken  string `json:"RefreshToken"`
+			TokenExpireAt int64  `json:"TokenExpireAt"`
+		} `json:"Result"`
+		// Fallback fields if format differs
+		Data struct {
+			Token        string `json:"token"`
+			RefreshToken string `json:"refreshToken"`
+			ExpiredAt    string `json:"expiredAt"`
+		} `json:"data"`
+	}
+
+	if errDecode := json.NewDecoder(resp.Body).Decode(&result); errDecode != nil {
+		return fmt.Errorf("failed to decode refresh response: %w", errDecode)
+	}
+
+	if result.Result.Token != "" {
+		ts.AccessToken = result.Result.Token
+		if result.Result.RefreshToken != "" {
+			ts.RefreshToken = result.Result.RefreshToken
+		}
+		if result.Result.TokenExpireAt > 0 {
+			sec := result.Result.TokenExpireAt
+			if sec > 1e11 {
+				sec /= 1000
+			}
+			ts.ExpiresAt = sec
+			ts.Expired = time.Unix(sec, 0).Format(time.RFC3339)
+		}
+		return nil
+	}
+
+	if result.Data.Token != "" {
+		ts.AccessToken = result.Data.Token
+		if result.Data.RefreshToken != "" {
+			ts.RefreshToken = result.Data.RefreshToken
+		}
+		if result.Data.ExpiredAt != "" {
+			ts.Expired = result.Data.ExpiredAt
+		}
+		return nil
+	}
+
+	if result.ResponseMetadata.Error.Message != "" {
+		return fmt.Errorf("refresh failed: %s (code %s)", result.ResponseMetadata.Error.Message, result.ResponseMetadata.Error.Code)
+	}
+
+	// A 200 without a token would otherwise leave the expired token in place and be recorded as a successful refresh.
+	return errors.New("refresh returned no token")
+}
+
+// localSessionExpired reports whether neither the access token nor the refresh token can still be used.
+func localSessionExpired(data TraeTokenData, now time.Time) bool {
+	refresh, okRefresh := parseTraeTime(data.RefreshExpiredAt)
+	if okRefresh && !refresh.After(now) {
+		return true
+	}
+	if strings.TrimSpace(data.RefreshToken) != "" {
+		return false
+	}
+	access, okAccess := parseTraeTime(data.ExpiredAt)
+	return okAccess && !access.After(now)
+}
+
+func parseTraeTime(value string) (time.Time, bool) {
+	value = strings.TrimSpace(value)
+	if value == "" {
+		return time.Time{}, false
+	}
+	if parsed, err := time.Parse(time.RFC3339, value); err == nil {
+		return parsed, true
+	}
+	if number, err := strconv.ParseInt(value, 10, 64); err == nil && number > 0 {
+		if number > 1e11 {
+			return time.UnixMilli(number), true
+		}
+		return time.Unix(number, 0), true
+	}
+	return time.Time{}, false
+}
