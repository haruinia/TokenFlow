+	case "gpt-4.1", "gpt-4.1-mini":
+		return "gpt-4.1"
+	case "gpt-5":
+		return "gpt-5"
+	case "o3", "o3-mini":
+		return "o3-mini"
+	case "deepseek-v3", "deepseek-v3.1", "deepseek-chat":
+		return "deepseek-v3"
+	case "deepseek-r1", "deepseek-reasoner":
+		return "deepseek-r1"
+	case "doubao-1.5-pro", "doubao-pro":
+		return "doubao-1.5-pro"
+	default:
+		if m != "" {
+			return m
