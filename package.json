{
  "name": "tokenflow",
  "version": "10.15.26",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "workspaces": [
    "packages/contracts",
    "packages/codebuddy-runtime"
  ],
  "scripts": {
    "dev": "npm run build && electron .",
    "start": "electron .",
    "serve": "node dist/headless.js",
    "build": "tsup && node scripts/check-runtime-bundle.mjs && vite build --config apps/console/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "sidecar:build": "node scripts/build-sidecar.mjs",
    "package": "npm run clean:package && npm run build && electron-builder --dir --publish never",
    "package:win": "npm run clean:package && node scripts/build-sidecar.mjs win32-x64 && npm run build && electron-builder --win zip --x64 --publish never",
    "prebuild": "node scripts/clean-build.mjs",
    "test:sidecar-pin": "node scripts/test-sidecar-pin.mjs",
    "test:sidecar-qoder": "node scripts/test-sidecar-qoder.mjs",
    "test:sidecar-agents": "node scripts/test-sidecar-qoder.mjs",
    "test:claude-compat": "go -C upstream/CLIProxyAPI test ./internal/translator/codex/claude ./internal/translator/openai/claude && npm run test:sidecar-agents && npm run test:sidecar-codex-claude",
    "test:sidecar-codex-claude": "node scripts/test-sidecar-codex-claude.mjs",
    "package:mac:arm64": "npm run clean:package && node scripts/build-sidecar.mjs darwin-arm64 && npm run build && electron-builder --mac --arm64 --dir --publish never",
    "package:mac:intel": "npm run clean:package && node scripts/build-sidecar.mjs darwin-x64 && npm run build && electron-builder --mac --x64 --dir --publish never",
    "clean:package": "node scripts/clean-package.mjs",
    "codex-agents:build": "node scripts/build-codex-agent-runtime.mjs"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.31",
    "@fastify/static": "^8.3.0",
    "@token-flow/codebuddy-runtime": "*",
    "fastify": "^5.12.1",
    "proxy-chain": "3.0.1",
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@cua-sample/contracts": "*",
    "@earendil-works/pi-agent-core": "0.87.0",
    "@earendil-works/pi-ai": "0.87.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "openai": "^6.25.0",
    "plist": "3.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "smol-toml": "^1.4.2",
    "tsup": "^8.4.0",
    "tsx": "^4.20.5",
    "typebox": "1.3.27",
    "typescript": "^5.8.2",
    "vite": "^7.0.0",
    "vitest": "^3.2.7",
    "yaml": "^2.9.0",
    "zod": "^3.24.2"
  },
  "build": {
    "buildVersion": "10.15.26.76",
    "appId": "local.browseragent.desktop",
    "productName": "TokenFlow",
    "files": [
      "dist/**",
      "package.json",
      "!dist/metafile-*.json",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.d.cts",
      "!**/*.d.mts",
      "!node_modules/@cursor/sdk-*/**",
      "!node_modules/@esbuild/**",
      "!node_modules/esbuild/**",
      {
        "from": ".tmp/package-native/${os}-${arch}/node_modules",
        "to": "node_modules",
        "filter": [
          "**/*",
          "!**/*.map",
          "!**/*.d.ts"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/@token-flow/codebuddy-runtime/**",
      "node_modules/@tencent-ai/agent-sdk/**",
      "packages/codebuddy-runtime/**",
      "node_modules/@cursor/sdk-*/**",
      "node_modules/@esbuild/**",
      "node_modules/esbuild/**",
      ".tmp/package-native/**/node_modules/**"
    ],
    "extraResources": [
      {
        "from": "LICENSES",
        "to": "LICENSES",
        "filter": [
          "**/*",
          "!**/.DS_Store"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "apps/console/public/app-icon.png",
      "extraResources": [
        {
          "from": "sidecars/darwin-${arch}",
          "to": "sidecars/darwin-${arch}",
          "filter": [
            "cliproxyapi"
          ]
        }
      ]
    },
    "win": {
      "target": [
        "zip"
      ],
      "icon": "apps/console/public/app-icon.png",
      "extraResources": [
        {
          "from": "sidecars/win32-${arch}",
          "to": "sidecars/win32-${arch}",
          "filter": [
            "cliproxyapi.exe"
          ]
        }
      ]
    },
    "directories": {
      "output": "release"
    },
    "afterPack": "scripts/after-pack.cjs",
    "linux": {
      "extraResources": [
        {
          "from": "sidecars/linux-${arch}",
          "to": "sidecars/linux-${arch}",
          "filter": [
            "cliproxyapi"
          ]
        }
      ],
      "icon": "apps/console/public/app-icon.png",
      "category": "Development",
      "executableName": "tokenflow",
      "desktop": {
        "entry": {
          "StartupWMClass": "tokenflow"
        }
      }
    },
    "compression": "maximum",
    "beforePack": "scripts/before-pack.cjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "Local desktop model gateway: manage accounts and APIs, connect models to coding agents, and export scoped client keys.",
  "author": "haruinia"
}
